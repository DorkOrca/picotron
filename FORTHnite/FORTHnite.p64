:: sentence.lua
--[[pod_format="raw",created="2026-10-07 22:37:38",modified="2026-10-31 00:33:33",revision=536,xstickers={}]]
include("errorhandler.lua")
include("word.lua")
include("dictionary.lua")
include("stack.lua")
include("token.lua")
include("gfind.lua")

--[[
Class: Sentence

Elements:
 - string: The original string that the sentence parses
 - tokens: String split() into a table by spaces
 - dictionary: A Dictionary with words in it
 - mode: Whether sentence is being interpreted or compiled
 
Functions:
 - new: Return a new Sentence
 - splitStringIntoTokens: Split string into table by spaces
 - interpret: Iterate through tokens, executing or compiling depending on mode
 - parseComment: 
]]
Sentence = {
	string = "",
	tokens = {},
	counter = 0,
	dictionary = Dictionary.new(),
	mode = 0, -- 0: interpret, 1: compile, 2: parse, 3: test
	
	-- Test variables - used for t{ -> }t tests
	testTokens = {}
}

function Sentence:executeTest(interpreter, tokens)
	local testInterpreter = interpreter.testInterpreter
	
	local sentence = Sentence.new(nil, testInterpreter.dictionary)
	sentence.tokens = 
		tokens == nil	and	self.testTokens
							or		tokens	
	-- print("Test tokens to be processed (" .. #sentence.tokens .. "): " .. table.concat(sentence.tokens, ", "))
	result = try(sentence.interpret, sentence:interpret(testInterpreter))
	
	return result
end

function Sentence:initializeTest(interpreter)
	self.testTokens = {}
	interpreter.testInterpreter = Interpreter.new(self.dictionary:clone())
	
	return true
end

function Sentence:splitStringIntoTokens(string)
	-- Split spring using gfind pattern %g+%s% and convert matches to tokens
	local lastEnd = 0 -- Document last end point for final word
	
	for match, matchStart, matchEnd in gfind(string, "%g+%s+") do -- This isolates all substrings that contain non-spaces followed by spaces
		local token = Token.new(match, matchStart)
		self.tokens[#self.tokens + 1] = token
		lastEnd = matchEnd + 1
	end
	-- If the last word in a string isn't followed by spaces, then the former pattern will not match with it
	-- Get a substring of any characters not captured by gfind, converting it to a token if it exists
	local lastWord = sub(string, lastEnd) 
	if #lastWord > 0 then
		local token = Token.new(lastWord, lastEnd)
		self.tokens[#self.tokens + 1] = token
	end
	
	return true
	--[[
	-- Old splitString function from before tokens were given a dedicated object
	local splitStr = split(string, " ", true)
	
	if splitStr == nil then
		return false, "split() function returned nil."
	end
	
	if #splitStr <= 0 then
		return false, "Split string is shorter than 0 elements."
	end
	
	self.tokens = splitStr
	--]]
end

function Sentence.sanitizeString(inputString)
	-- Returns string with whitespace condensed and trimmed
	return trim(string.gsub(inputString, "%s+", " "))
end

function Sentence.new(string, dictionary, mode)
	-- Generate a new sentence
	local sentence = {}
	setmetatable(sentence, {__index = Sentence})
	
	if string != nil then
		sentence.string = string
		sentence.tokens = {}
		try(sentence.splitStringIntoTokens, sentence:splitStringIntoTokens(string))
	else
		sentence.string = ""
		sentence.tokens = {}
	end
	
	sentence.dictionary =
		dictionary == nil	and	Dictionary.new()
								or		dictionary
	sentence.mode =
		mode == nil			and	Sentence.mode
								or		mode
	
	sentence.testInterpreter = Interpreter.new(sentence.dictionary:clone())
	
	return sentence
end

function Sentence:interpret(interpreter, externStack)
	if interpreter.abort == true then
		interpreter.activeSentence = {}
		return false
	end
	
	interpreter.activeSentence = self
	
	local tokens = self.tokens
	local index = interpreter.dictionary.index
	local stack = externStack == nil and interpreter.stack or externStack
	
	local parseWord = "" -- The word that initiated the parse
	local parseStart = 0 -- The index at which the parse starts
	local compiledName = "" -- The first word interpreted after entering compilation mode
	local compileStart = 0 -- The index at which the compiled string starts
	local compiledTokens = {} -- All subsequent words interpreted after entering compilation mode
	
	-- Test interpreters don't have test interpreters of their own.
	-- This variable checks if the sentence being run is part of a test.
	local testing =
		interpreter.testInterpreter != nil
		
	local testInterpreter = {}
	local savedTestStack = {}
	
	-- If the sentence isn't testing, then we set up all the testing variables for later use.
	if testing == false then
		testInterpreter = interpreter.testInterpreter
		local savedTestStack = Stack.new()
	end
	
	for counter, token in ipairs(tokens) do
		self.counter = counter
	
		local phrase = token.phrase
		
		if key("ctrl") and key("c") then
			print("Ctrl + C: Ending sentence interpretation early.")
			break
		end
		
		if self.mode == 0 then -- If sentence is in interpret mode
			if phrase == ":" or phrase == "]" then -- If token is a colon or close bracket...
				self.mode = 1 -- ...Then switch to compile mode
			elseif phrase == ";" then -- If token is a semicolon...
				throw(-791) -- Then throw an error
				break
			elseif phrase == ".\"" or phrase == "(" then -- If token is a dot-quote or open parentheses...
				parseWord = phrase
				parseStart = token.start + #phrase + 1 -- Parse starts capturing after the parse word, plus one character for the first space
				self.mode = 2 -- ...Then switch to parse mode
			elseif phrase == "t{" then -- If token is the test harness initiator...
				self:initializeTest(interpreter)
				savedTestStack = {}
				self.mode = 3 -- Switch to test mode
			elseif phrase == "\\" then -- if token is Forth Standard word 6.2.2535 (parse and discard)...
				break -- ...Parse and discard (breaking stops processing the rest of the sentence)
			elseif type(phrase) == "string" then -- If token is a string...
				local word = index[phrase] -- ...Then look it up in the dictionary index
				if word == nil then -- If the word wasn't found in the index...
					throw(-13, phrase)
					break
				end -- If word was found in the index...
				if (try(word.interpret, word:interpret(interpreter)) == nil) then -- ...Then interpret the word. If the word's function returns nil, then try() will return nil as well
					local errorArgs = {counter=counter, phrase=phrase}
					interpreter.abort = true
					throw(-222, errorArgs)
					break -- If the word returned nil, then stop interpreting the sentence and return an error
				end
			elseif type(phrase) == "number" then -- If word represents a number...
				phrase = stack.convert64to32(phrase) -- (convert 64-bit integer to 32-bit)
				try(stack.push, stack:push(phrase)) -- ...Then push the number to the stack
			else -- If the word is some other forbidden thing...
				throw(-333, tostr(word.name))
				break
			end
			
		elseif self.mode == 1 then -- If sentence is in compile mode...
			if phrase == ";" then -- If the token is a semicolon...
				self.mode = 0 -- ...Then switch back to interpret mode
				local compiledDefinition = self.sanitizeString(table.concat(compiledTokens)) -- Concatenate a string from the compiled token table's elements, trimming white space
				local newWord = Word.new(compiledName, compiledDefinition, 3) -- Generate a new word based on the compiled string
				try(interpreter.dictionary.addWord, interpreter.dictionary:addWord(newWord))-- Add word to dictionary
				compiledName = "" -- Initialize name string
				compiledTokens = {} -- Initialize table of compiled tokens
			elseif phrase == ":" then -- If the token is a colon...
				self.mode = -1 -- ...Then error out
				throw(-712)
				break
			elseif phrase == "[" then -- If the token is an open bracket...
				self.mode = 0 -- ...Then immediately return to execute mode
			elseif compiledName == "" then -- If name hasn't been set yet...
				compiledName = phrase -- ...Then set the name to the token
			else -- If any other kind of token has been provided...
				add(compiledTokens, phrase) -- ...Then add the token to the Forth definition
				add(compiledTokens, " ") -- Add some whitespace to separate this token from the next when string is concatenated from table
			end
			
		elseif self.mode == 2 then -- If sentence is in parse mode...
			if phrase == ")" and parseWord == "(" then -- If parsing from open parenthesis, and encountering close parenthesis...
				parseWord = ""
				parseStart = 0
				self.mode = 0 -- ...Then clear the parse variables and switch back to interpret mode
			elseif phrase == "\"" and parseWord == ".\"" then -- If parsing from dot-quote, and encountering quote...
				local parseEnd = token.start - 1 -- Parse ends at the start of the end parse token
				local parseString = sub(self.string, parseStart, parseEnd) -- Parse a substring from the sentence's original full string
				print(parseString .. "\0") -- Print the parsed string
				parseWord = "" -- Clear parse variables
				parseStart = 0
				self.mode = 0 -- Switch back to interpret mode
			end -- Otherwise, move on to the next word
		elseif self.mode == 3 then -- If sentence is in test mode...
			if testing == true then -- If this sentence was already part of a test, then...
				
			end
			if phrase == "->" then -- Token "->" executes the first test
				if #self.testTokens <= 0 then -- If there are no tokens to test...
					self.mode = -1
					throw(-101)
					break -- ...Then error out
				elseif savedTestStack.values != nil and #savedTestStack.values > 0 then -- If a first test has already been performed...
					self.mode = -1
					throw(-102)
					break -- ...Then error out
				end -- Otherwise, proceed
				local result = try(self.executeTest, self:executeTest(interpreter, self.testTokens)) -- Execute the first test
				if result == nil then -- If test fails then...
					self.mode = -1
					throw(-103)
					break -- ... Then error out
				end -- Otherwise, proceed
				local testStack = interpreter.testInterpreter.stack
				savedTestStack = testStack:clone() -- Save the test stack in a new table
				savedTestStack.tested = true
				self:initializeTest(interpreter)
			elseif phrase == "}t" then -- Token '}t' executes the final test
				if (savedTestStack.tested != true) then -- If a first test hasn't been performed...
					self.mode = -1
					throw(-104)
					break -- ... Then error out
				elseif self.testTokens == nil or #self.testTokens <= 0 then -- If there are no tokens to test...
					self.mode = -1
					throw(-105)
					break -- ...Then error out
				end -- Otherwise, proceed
				local result = try(self.executeTest, self:executeTest(interpreter, self.testTokens)) -- Execute the final test
				local testStack = interpreter.testInterpreter.stack
				if result == false then -- If final test fails...
					self.mode = -1
					throw(-106)
					break -- ...Then error out
				elseif #savedTestStack.values != #testStack.values then -- If test stacks are different sizes...
					self.mode = -1
					local errorArgs = {
						savedTestStack = savedTestStack,
						testStack = testStack
					}
					throw(7357, errorArgs) -- ...Then fail the test
					break
				end
				
				local identical = true
				for i = 1, #testStack.values do -- Iterate through all values of both stacks
					identical = testStack.values[i] == savedTestStack.values[i] -- Check if values at same index are identical
					if identical == false then -- If values are different...
						self.mode = -1
						local errorArgs = {
							savedTestStack = savedTestStack,
							testStack = testStack,
							i = i
						}
						throw(7358, errorArgs)
						break -- ...Then fail the test
					end
				end
				
				if identical == false then
					break
				end
				local smug = " \f1\^:0000ff6600000000\-8\f5\^:0000008100000000\-8\f9\^:3c4200008181423c\-8\fa\^:003c00187e5a2400\-8\fp\^:0000000000241800\f7 "
				print(smug .. "Test successful!")
				-- Initialize test mode variables
				self:initializeTest(interpreter)
				savedTestStack = Stack.new()
				self.mode = -1
				return true
			else
				add(self.testTokens, token)
			end
		else -- If sentence is in an unknown mode...
			throw(-998, self.mode)
			break
		end
		
		if self.mode == -1 then -- -1 = cleanup test data
			self:initializeTest(interpreter)
		end
	end -- End of for loop
	
	if self.mode == 2 and parseWord != "(" then -- If parsing ended early (and not during a comment)...
		throw(-721) -- ...Then throw an error...
		self.mode = -1 -- ...And clean up
	elseif self.mode == 3 then -- If testing ended early...
		throw(-722) -- ...Then throw an error...
		self.mode = -1 -- ...And clean up
	end
	
	if self.mode == -1 then -- -1 = cleanup test data
		self:initializeTest(interpreter)
	end
	
	self.mode = 0 -- Revert to interpret mode
	self.tokens = {} -- Initialize table of tokens
	
	interpreter.activeSentence = {}
	
	return true
end
:: stack.lua
--[[pod_format="raw",created="2026-10-07 22:36:45",modified="2026-10-30 22:34:30",revision=41,xstickers={}]]
include("errorhandler.lua")
--[[
Class: Stack

Elements:
 - values: The stack itself

Functions:
 - new: Returns a new Stack
 - pop: Returns the top value on the stack
 - push: Puts a value on top of the stack
 - drop: Drops i values starting at the top of the stack
]]
Stack = {
	values = {}
}

function Stack.new(values, pointer)
	local stack = {}
	setmetatable(stack, {__index = Stack})
	
	stack.values =
		values == nil	and	{}
						or		values
	stack.pointer =
		(pointer == nil or
		 type(pointer) != "number")	and	Stack.pointer
												or		pointer
												
	return stack
end

function Stack:clone()

	local stack = Stack.new()
	for key, value in ipairs(self.values) do
		add(stack.values, value, key)
	end
	
	return stack
end

function Stack:pop()
	local values = self.values
	if #values <= 0 then
		throw(-4, self)
		return nil
	end
	
	local popped = deli(values)
	return true, popped
end

function Stack:push(val)
	local values = self.values
	
	add(values, val)
	
	--print("Pushed " .. val .. " onto the stack.  Stack size: " .. #values)
	return true
end

function Stack:get(n)
	-- Return the nth value on the stack without altering the stack
	n =
		(type(n) != "number" or n == nil or n < 1)	and	1
																or		n
	
	local values = self.values
	
	if n > #values then
		return false, "Stack is less than n. Stack size: " .. #values .. ", n: " .. n
	end
	
	return true, values[n]
end
	

function Stack:pick(n)
	-- Get the nth value on the stack and place it on top of the stack
	n =
		(type(n) != "number" or n == nil or n < 1)	and	1
																or		n
	local values = self.values
	
	if n > #values then
		return false, "Stack is less than n. Stack size: " .. #values .. ", n: " .. n
	end
	
	local cell = #values - (n - 1)
	
	return try(self.push, self:push(values[cell]))
end

function Stack:drop(i)
	i =
		(type(i) != "number" or i == nil)	and		1
														or 	i
	local values = self.values
	
	if #values < i then
		return false, "Stack is less than i. Stack size: " .. #values .. ", i: " .. i
	end
	
	for i = 1, i do
		deli(values)
	end
	
	return true
end

function Stack:empty()
	self.values = {}
	return true
end

function Stack.convert64to32(num)
	local bits = 32
	local range = 2^bits
	local upperLimit = range / 2 - 1
	local lowerLimit = (upperLimit * -1) - 1
	
	if (num > upperLimit or num < lowerLimit) then
		throw(-711)
		return math.tointeger((num % range) - abs(lowerLimit))
	end
	
	return num
end
:: token.lua
--[[pod_format="raw",created="2026-10-24 05:28:37",modified="2026-10-30 22:51:11",revision=38,xstickers={}]]
include("errorhandler.lua")
--[[
Class: Token

Elements:
 - value: Split token (without spaces)
 - word: Value converted to lowercase with white space trimmed
 - start: Int representing token's starting position in its parent string

Functions:
 - new: Create a new token
--]]

Token = {
	value = "",
	phrase = "",
	start = -1
}

function Token.sanitizeString(inputString)
	-- Returns string converted to lowercase with whitespace condensed and trimmed
	if type(inputString) == "string" then
		local sanitizedString = trim(string.gsub(inputString:lower(), "%s+", " "))
		local sanitizedValue =
			tonumber(sanitizedString) != nil	and	tonumber(sanitizedString)	or
																sanitizedString
		return sanitizedValue
	end
	
	return inputString
end

function Token.new(value, start)
	local token = {}
	setmetatable(token, {__index = Token})
	
	token.value =
		value == nil	and	Token.value
						or		value
	
	token.phrase =
		value == nil						and	Token.phrase	or
													token.sanitizeString(value)
												
	local startIsValidInt =
		start != nil and
		type(start) == "number" and
		start > 0
	
	token.start =
		startIsValidInt == false	and	Token.start
										or		start
										
	return token	
end
:: word.lua
--[[pod_format="raw",created="2026-10-07 22:33:36",modified="2026-10-30 22:22:00",revision=50,xstickers={}]]
include("errorhandler.lua")
--[[
Class: Word

Elements:
 - name: String containing full word
 - mode: Number representing val's type
 - val: Value of some kind (func, number, or Forth definition)
 
Functions:
 - new: Return a new Word
 - validate: Validate all of a word's fields
 - interpret: Either executes a word
   or puts a number on the stack
]]
Word = {
	name = "<nil>",
	val = function() return end,
	mode = 0 -- 0 = unknown, 1 = func, 2 = number, 3 = Forth definition
}

function Word.new(name, val)
	local word = {}
	setmetatable(word, {__index = Word})
	
	word.name =
		name == nil	and	Word.name or
								name
	
	word.val =
		(type(val) == "function"	or
		type(val) == "number" or
		type(val) == "string")	and	val or
												Word.func
	
	word.mode =
		type(word.val) == "function"	and 	1 or
		type(word.val) == "number" 	and 	2 or
		type(word.val) == "string"		and	3 or
												Word.mode
	
	return word
end

function Word:validate()
	
	local nameIsValid =
		type(self.name) == "string" or
		type(self.name) == "number"
		
	local modes = {
		"function",
		"number",
		"string"
	}
		
	local modeIsValid =
		self.mode >= 0 and self.mode <= 3
	
	local valIsValid =
		type(self.val) == modes[self.mode]
		
	return nameIsValid and modeIsValid and valIsValid
end

function Word:interpret(interpreter)
	if interpreter.abort == true then
		return nil
	end
	
	local stack = 
		(stack == nil				or
		type(stack) != "table" 	or
		stack.values == nil) 		and	interpreter.stack
										or 	stack
	
	local successful = true
	
	if self.mode == 1 then
		successful = try(self.val, self.val(interpreter)) != nil
	elseif self.mode == 2 then
		successful = try(stack.push, stack:push(self.val)) != nil
	elseif self.mode == 3 then
		local sentence = Sentence.new(self.val, interpreter.dictionary)
		successful = try(sentence.interpret, sentence:interpret(interpreter)) != nil
	else
		return false, "Couldn't interpret word " .. self.name .. ". Word had mode " .. self.mode
	end
	
	if successful == false then
		return nil
	end
	
	return true
end
