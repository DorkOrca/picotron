--[[pod_format="raw",created="2026-10-06 19:12:47",modified="2026-10-07 08:20:13",revision=44,xstickers={}]]
function try(...)
	-- Try a function, evaluating results for errors
	
	-- result is a table containing return
	-- values from the executed function
	local result = {...}
	
	-- To be flagged, a function must return two arguments:
	-- false, and a string containing the error
	if result[1] == false and #result > 1 then
		local getinfo = debug.getinfo(func, "S")
		print("Error in " .. tostr(getinfo.short_src) .. ":" .. getinfo.linedefined .. " - " .. tostr(result[2]))
		return nil
	end
	
	-- If not flagged, then the results are returned as they were received
	return unpack(result)
end
