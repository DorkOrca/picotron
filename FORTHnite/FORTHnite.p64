		desc = function()
			return "Second test failed, aborting."
		end
	},
	[-222] = {
		name = "INTERPRET:word_failed",
		desc = function(vars)
			local counter = vars.counter
			local phrase = vars.phrase
			return "Word " .. counter .. ", '" .. phrase .. "' returned false, aborting."
		end
	},
	[-333] = {
		name = "INTERPRET:weird_word",
		desc = function(name)
			return "Word.name wasn't a string or number.  Val: " .. name
		end
	},
	[-711] = {
		name = "MATH:out_of_range",
		desc = function()
			return "Value out of range."
		end
	},
	[-712] = {
		name = "COMPILE:wrong_colon",
		desc = function()
			return "Colon detected while in compile mode."
		end
	},
	[-721] = {
		name = "SENTENCE:parse_open",
		desc = function()
			return "Parse never closed."
		end
	},
	[-722] = {
		name = "SENTENCE:test_open",
		desc = function()
			return "Test never closed."
		end
	},
	[-743] = {
		name = "MATH:floating_point_out_of_range",
		desc = function()
			return "Floating point out of range."
		end
	},
	[-791] = {
		name = "INTERPRET:wrong_semicolon",
		desc = function()
			return "Semicolon detected while in interpret mode, aborting."
		end
	},
	[-801] = {
		name = "SENTENCE:failed_interpret",
		desc = function()
			return "Sentence failed to interpret."
		end
	},
	[-997] = {
		name = "SENTENCE:already_testing",
		desc = function()
			return "Attempted to start a test inside of a test.\nOnly one test can be run at a time. Aborting."
		end
	},
	[-998] = {
		name = "SENTENCE:mode_not_found",
		desc = function(mode)
			return "Sentence is in unknown mode " .. mode .. ", aborting."
		end	
	},
	[-999] = {
		name = "error_not_found",
		desc = function(code) 
			return "Error code '" .. tostr(code) .. "' not found."
		end
	},
	
	-- Notices
	[7357] = {
		name = "TEST:stack_size_mismatch",
		desc = function(args)
			local savedTestStack = args.savedTestStack.values
			local testStack = args.testStack.values
			return "Test failed.\nStacks are different sizes.\n" ..
				"First test's stack: " .. #savedTestStack .. "\n" ..
				"Second test's stack: " .. #testStack
		end
	},
	[7358] = {
		name = "TEST:stack_val_mismatch",
		desc = function(args)
			local savedTestStack = args.savedTestStack.values
			local testStack = args.testStack.values
			local i = args.i
			return "Test failed.\nValue " .. i .. " on stacks don't match.\n" ..
				"First stack's value: " .. savedTestStack[i] .. "\n" ..
				"Second stack's value: " .. testStack[i]
		end
	},
}

function try(func, ...)
	-- Try a function, evaluating results for errors
	
	-- result is a table containing return
	-- values from the executed function
	local result = {...}
	
	-- To prompt an error, a function must return two arguments:
	-- false, and a string containing the error.
	if result[1] == false and #result > 1 then
		local getinfo = debug.getinfo(func, "S")
		-- Verbose error string below - need to find a better way to activate it
		-- print("Error in " .. tostr(getinfo.short_src) .. ":" .. getinfo.linedefined .. " - " .. tostr(result[2]))
		if result[2] != "nil" then
			print(" \fe\^:0810000000000000\-8\f8\^:0008181800001800\-8\f2\^:0000000008000008\-8\fn\^:1000000000000000\-8\fo\^:0000000010000010\f7 ERROR: " .. tostr(result[2]))
		end
		
		return nil
	end
	
	-- To silently error, then a function must return nil.
	if result[1] == nil and #result == 1 then
		return nil
	end
	
	-- If not flagged, then the results are returned as they were received
	return table.unpack(result)
end

function throw(code, ...)
	local vars = {...}
	
	if ERRORS[code] == nil then
		throw(-999, code)
		return false
	end
	
	local error = ERRORS[code]
	local errorDesc = error.desc(table.unpack(vars))
	
	local icon =
		code > 0 and " \f4\^:3c42810000000000\-8\fp\^:0000008118181800\-8\f9\^:000000008181423c\-8\f5\^:003c420000000000\-8\f1\^:0000244200000000\-8\fa\^:0000001866662400\-8\fm\^:0000182400000000\f7 CODE "
		or code == -222 and " h:00009900000000008r:00000081818142348g:00420000000000008c:003c42000000000081:3c002442000000008q:0000003c6666340083:00000000180000008j:00000000001800008a:00000000000008008p:00000000000000087 CRITICAL ERROR "
		or " \fe\^:0810000000000000\-8\f8\^:0008181800001800\-8\f2\^:0000000008000008\-8\fn\^:1000000000000000\-8\fo\^:0000000010000010\f7 ERROR "
	
	print(
		icon .. tostr(code) .. ": " .. errorDesc
	)
	
	return true
end
	
:: gfind.lua
--[[pod_format="raw",created="2026-10-27 22:52:39",modified="2026-10-29 00:31:39",revision=33,xstickers={}]]

--[[--[[--[[--[[--[[--[[--[[--[[


--[] Custom Iterator: gfind []--


--[[--[[--[[--[[--[[--[[--[[--[[

Description: 

This is an iterator to be used in for loops.

This function returns a function which iteratively
searches through a string for a pattern, returning
the matched substring as well as the substring's
starting and ending indices.

Parameters:

 - targetString: A string to execute gfind on.
 - patternString: A pattern, as defined in Lua 5.4 $6.4.1:
 	https://www.lua.org/manual/5.4/manual.html#6.4.1
 - offset: The starting index (defaults to 1, and values lower clamp to 1)

Returns:

 - A function "gfindNext" which iterates through the targetString
   by matching with the patternString starting at the offset every
   time it's called.
   
Iteration:

 - Starting at offset, find patternString in targetString
 
 - If a match for the pattern is found, then return...
   1. A substring matching the pattern, located at / after the offset index
   2. The starting index of the matched substring
   3. The ending index of the matched substring
 - Additionally, update offset so that the next search won't include the last result
   
 - If a match for the pattern is not found, then return...
   1. nil
   
Considerations:

 - Captures after the first match are dropped.
   
* Note on Lua's string.find:
*  - Empty matches have an ending index equal to the starting index minus one.
   
--]]--]]--]]--]]--]]--]]--]]--]]


function gfind(targetString, patternString, offset)
	if type(targetString) != "string" then
		error("Input string isn't valid.")
	end
	if type(patternString) != "string" then
		error("Pattern isn't valid.")
	end
	
	offset = 
		offset == nil	and	1	or
		offset < 1 		and	1	or
									offset
	
	local gfindNext = function()
		
		if offset <= #targetString + 1 then
			local matchStart, matchEnd = string.find(targetString, patternString, offset)
			
			if matchStart == nil then
				return nil
			end
			
			local match = string.sub(targetString, matchStart, matchEnd)
			
			if matchEnd < matchStart then
				offset = matchStart + 1
			else
				offset = matchEnd + 1
			end
			
			
			return match, matchStart, matchEnd
		end
		return nil
	end
	
	return gfindNext
end
:: interpreter.lua
--[[pod_format="raw",created="2026-10-06 08:54:46",modified="2026-10-31 00:26:38",revision=449,xstickers={}]]
include("errorhandler.lua")
include("word.lua")
include("dictionary.lua")
include("sentence.lua")
include("stack.lua")
include("token.lua")
--[[
Class: Interpreter

Elements:
 - dictionary: A Dictionary with words in it
 - stack: 
 - returnStack: 
 - testInterpreter: 
 - activeSentence: The sentence being parsed, from the start of Sentence:interpret() until it either ends or is aborted.
 - abort: Boolean indicating if interpretation should be ceased.
  	 Checked at the top of "interpret" functions in sentences and words.

]]
Interpreter = {
	dictionary = Dictionary.new(),
	stack = Stack.new(),
	returnStack = Stack.new(),
	testInterpreter = {},
	activeSentence = {},
	abort = false
}

function Interpreter.new(dictionary, stack, returnStack)
	local interpreter = {}
	setmetatable(interpreter, {__index = Interpreter})
	
	if dictionary == nil then
		interpreter.dictionary = Dictionary.new()
		local result = interpreter.dictionary:initialize(interpreter)
		local initalizeResult, wordCount = interpreter.dictionary:buildIndex()
		if result != nil then
			print("Dictionary initialized. Words: " .. wordCount)
		end
	else
		interpreter.dictionary = dictionary
	end
	
	interpreter.stack =
		stack == nil			and	Stack.new()
								or		stack
								
	interpreter.returnStack =
		returnStack == nil	and	Stack.new()
								or		returnStack
	
	
	interpreter.testInterpreter = interpreter:clone()
	
	interpreter.activeSentence = {}
	
	interpreter.abort = false
	
	return interpreter
end

function Interpreter:clone()
	-- Clones the interpreter WITHOUT test variables
	local interpreter = {}
	setmetatable(interpreter, {__index = Interpreter})
	interpreter.dictionary = self.dictionary:clone()
	interpreter.stack = self.stack:clone()
	interpreter.returnStack = self.returnStack:clone()
	return interpreter
end

function Interpreter.separateSentences(string)
	-- Separate a user-provided string into sentences, separated by chr(10) AKA \n
	local splitStr = split(string, chr(10), false)
	
	if splitStr == nil then
		return false, "split() function returned nil."
	end
	
	if #splitStr <= 0 then
		return false, "Split string is shorter than 0 elements."
	end
	
	return splitStr
end

function Interpreter:run(string)
	--Convert a string into sentences, then interpret the sentences
	local strings = self.separateSentences(string)
	if strings == false then
		strings = {string}
	end
	
	for index, evalString in pairs(strings) do
		-- Generate a sentence using the given string (and trim whitespace, and make it lowercase)
		local sentence = Sentence.new(evalString, self.dictionary)
		-- Print the sentence string
		print(" > " .. sentence.string)
		-- Interpret the sentence
		local _, result = try(sentence.interpret, sentence:interpret(self))
		if _ == nil then
			throw(-801)
		end
		
		if self.abort == true then
			self.abort = false
			break
		end
		
		-- Print the stack size
		print("Stack size: " .. #self.stack.values)
	end
end

function trim(s)
   return s:match("^%s*(.-)%s*$")
end
