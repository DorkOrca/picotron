--[[pod_format="raw",created="2026-10-06 08:54:46",modified="2026-10-06 09:48:59",revision=8,xstickers={}]]
local Word = {
	val = "",
	mode = 0, -- 0 = unknown 1 = text, 2 = number
	func = function() end
}

function Word.new(val, mode, func)
	local word = {}
	setmetatable(word, Word)
	
	word.val =
		val == nil	and	"<nil>" or
								val
	
	word.mode =
		type(val) == "string"		and 	1 or
		type(val) == "number" 	and 	2 or
												0
	
	word.func =
		type(func) == "function"	and	func or
												word.func
	
	return word
end

function Word:interpret()
	
end


local Sentence = {
	words = {}
}

function Sentence.splitString(string)
	local splitString = split(string, " ", true)
end

function Sentence:new(string)
	self.words = self.splitString(string)
end

function Sentence:interpret()
	
end
