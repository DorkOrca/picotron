--[[pod_format="raw",created="2026-10-06 08:54:46",modified="2026-10-07 08:59:01",revision=177,xstickers={}]]
include("errorhandler.lua")

--[[
Class: Word

Elements:
 - name: String containing full word
 - mode: Number representing val's type
 - val: Value of some kind (func, number, or forth string)
 
Functions:
 - new: Return a new Word
 - validate: Validate all of a word's fields
 - interpret: Either executes a word
   or puts a number on the stack
]]
local Word = {
	name = "<nil>",
	val = function() return end,
	mode = 0 -- 0 = unknown, 1 = func, 2 = number, 3 = forth string
}

function Word.new(name, val)
	local word = {}
	setmetatable(word, {__index = Word})
	
	word.name =
		name == nil	and	Word.name or
								name
	
	word.val =
		(type(val) == "function"	or
		type(val) == "number" or
		type(val) == "string")	and	val or
												Word.func
	
	word.mode =
		type(word.val) == "function"	and 	1 or
		type(word.val) == "number" 	and 	2 or
		type(word.val) == "string"		and	3 or
												Word.mode
	
	return word
end

function Word:validate()
	
	local nameIsValid =
		type(self.name) == "string" or
		type(self.name) == "number"
		
	local modeIsValid =
		self.mode >= 0 and self.mode <= 3
	
	local valIsValid =
		type(self.val) == "function" or
		type(self.val) == "number" or
		type(self.val) == "string"
		
	return nameIsValid and modeIsValid and valIsValid
end

function Word:interpret(interpreter)
	local pile = interpreter.stack.pile
	
	if self.mode == 1 then
		self.val(pile)
		return true
	else
		return false, "Word had mode " .. self.mode
	end
end

--[[
Class: Dictionary

Elements:
 - name: String label for the Dictionary
 - words: Table of Words
 - index: k/v pairs for word lookup
 
Functions:
 - new: Return a new Dictionary
 - addWord: Add a new Word to the
 	Dictionary
 - export: Export Dictionary table
 - import: Overwrite Dictionary with
 	another Dictionary's contents
 - buildIndex: Convert words to k/v pairs
 	where k = val and v = word
]]
local Dictionary = {
	name = "default",
	words = {},
	index = {}
}

function Dictionary:import(source)

end

function Dictionary:export(fileName)
	
end

function Dictionary:buildIndex()
	local words = self.words
	
	if #words <= 0 then
		--TODO:Error handling
		return false, "Dictionary has no words."
	end
	
	local index = {}
	
	for k, word in pairs(words) do
		index[word.name] = word
	end
	
	self.index = index
	
	return true
end

function Dictionary:addWord(word)
	if word:validate() == true then
		self.words[#self.words + 1] = word
		return self:buildIndex()
	else
		return false, "Word could not be validated."
	end
end

function Dictionary:generateWords(wordList)
	if #wordList <= 0 then
		return false, "wordList had 0 entries."
	end
	
	for k, v in ipairs(wordList) do
		local word = Word.new(v.name, v.val)
		self:addWord(word)
	end
	
	return true
end

function Dictionary:initialize(interpreter)
	local stack = interpreter.stack

	local defaultWords = {
		{name = ".", val = function() stack:pop() end},
		{name = "DROP", val = function() stack:drop() end},
		{name = "2DROP", val = function() stack:drop(2) end},
	}
	
	try(self:generateWords(defaultWords))
	
	return true
end

function Dictionary.new(name)
	local dictionary = {}
	setmetatable(dictionary, {__index = Dictionary})
	
	dictionary.name = name == nil and Dictionary.name or name
	
	return dictionary
end

--[[
Class: Sentence

Elements:
 - tokens: String split() into a table by spaces
 - dictionary: A Dictionary with words in it
 - mode: Whether sentence is being interpreted or compiled
 
Functions:
 - new: Return a new Sentence
 - splitString: Split string into table by spaces
 - interpret: Iterate through tokens, executing or compiling depending on mode
]]
local Sentence = {
	tokens = {},
	dictionary = Dictionary.new(),
	mode = 0 -- 0: interpret, 1: compile
}

function Sentence:splitString(string)
	local splitStr = split(string, " ", true)
	
	if splitStr == nil then
		return false, "split() function returned nil."
	end
	
	if #splitStr <= 0 then
		return false, "Split string is shorter than 0 elements."
	end
	
	self.tokens = splitStr
	
	return true
end

function Sentence.new(string, dictionary, mode)
	local sentence = {}
	setmetatable(sentence, {__index = Sentence})
	
	try(sentence:splitString(string))
	
	sentence.dictionary =
		dictionary == nil	and	Dictionary.new()
								or		dictionary
	sentence.mode =
		mode == nil			and	Sentence.mode
	return sentence
end

function Sentence:interpret(interpreter)
	local tokens = self.tokens
	local index = interpreter.dictionary.index
	local stack = interpreter.stack
	
	local compiledName = ""
	local compiledString = ""
	
	for counter, token in ipairs(tokens) do
		
		if self.mode == 0 then -- If sentence is in interpret mode
			if token == ":" then
				sentence.mode = 1
			elseif type(token) == "string" then
				local word = index[token]
				if word == nil then
					print(token .. "?")
					break
				end
				try(word:interpret(interpreter))
			elseif type(token) == "number" then -- If word represents a number
				try(stack:push(token))
			else -- If the word is some other forbidden thing
				print("Error in Sentence:interpret: word.name wasn't a string or number.  Val: " .. tostr(word.name));
			end
		elseif sentence.mode == 1 then -- If sentence is in compile mode
			if token == ";" then
				sentence.mode = 0
				local newWord = word.new()
			else
			
			end
		end
		
	end
end

--[[
Class: Stack

]]
Stack = {
	pile = {},
	pointer = 0
}

function Stack.new(pile, pointer)
	local stack = {}
	setmetatable(stack, {__index = Stack})
	
	stack.pile =
		pile == nil	and	{}
						or		pile
	stack.pointer =
		(pointer == nil or
		 type(pointer) != "number")	and	Stack.pointer
												or		pointer
												
	return stack
end

function Stack:pop()
	local pile = self.pile
	
	if #pile <= 0 then
		return false, "Stack pile is empty: " .. #pile
	end
	
	print(deli(pile))
	return true
end

function Stack:push(num)
	if type(num) != "number" then
		return false, "num isn't a number."
	end
	
	add(self.pile, num)
	return true
end

function Stack:drop(i)
	local i =
		(type(i) != "number" or i == nil)	and	1
														or 	i
	local pile = self.pile
	
	if #pile <= 0 then
		return false, "Stack pile is empty: " .. #pile
	end
	
	for i = 1, i do
		deli(pile)
	end
	
	return true
end

--[[
Class: Interpreter

Elements:
 - dictionary: A Dictionary with words in it


]]
Interpreter = {
	dictionary = Dictionary.new(),
	stack = Stack.new()
}

function Interpreter.new(dictionary, stack)
	local interpreter = {}
	setmetatable(interpreter, {__index = Interpreter})
	interpreter.dictionary =
		dictionary == nil	and	Dictionary.new()
								or		dictionary
	
	interpreter.dictionary:initialize(interpreter)
	interpreter.dictionary:buildIndex()
	
	print(#interpreter.dictionary.index)
	
	interpreter.stack =
		stack == nil			and	Stack.new()
								or		stack
								
	return interpreter
end

function Interpreter:run(string)
	-- Generate a sentence using the given string
	local sentence = Sentence.new(string)
	-- Interpret the sentence
	try(sentence:interpret(self))
	
end
