--[[pod_format="raw",created="2026-10-07 22:32:59",modified="2026-10-08 00:13:08",revision=35,xstickers={}]]
include("errorhandler.lua")
include("word.lua")
--[[
Class: Dictionary

Elements:
 - name: String label for the Dictionary
 - words: Table of Words
 - index: k/v pairs for word lookup
 
Functions:
 - new: Return a new Dictionary
 - addWord: Add a new Word to the
 	Dictionary
 - export: Export Dictionary table
 - import: Overwrite Dictionary with
 	another Dictionary's contents
 - buildIndex: Convert words to k/v pairs
 	where k = val and v = word
]]
Dictionary = {
	name = "default",
	words = {},
	index = {}
}

function Dictionary:import(source)
	
end

function Dictionary:export(fileName)
	
end

function Dictionary:buildIndex()
	local words = self.words
	
	if #words <= 0 then
		--TODO:Error handling
		return false, "Dictionary has no words."
	end
	
	local index = {}
	
	for k, word in pairs(words) do
		index[word.name] = word
	end
	
	self.index = index
	
	return true, #words
end

function Dictionary:addWord(word)
	if word:validate() == true then
		self.words[#self.words + 1] = word
		return self:buildIndex()
	else
		return false, "Word could not be validated."
	end
end

function Dictionary:generateWords(wordList)
	local result = true
	
	if #wordList <= 0 then
		return false, "wordList had 0 entries."
	end
	
	for k, v in ipairs(wordList) do
		local word = Word.new(v.name, v.val)
		result = self:addWord(word)
	end
	
	return result
end

function Dictionary:initialize(interpreter)
	local stack = interpreter.stack
	
	-- Forth 2012 Standard dictionary (WIP)
	if DICT_STANDARD == nil then
		DICT_STANDARD = {
		
			{name = "(", id = "6.1.0080", val = function()
				-- '(' is immediately handled in sentence.lua via Sentence:interpret().
				-- This function shouldn't ever actually run.
				return false, "Word '(' should not be runnable. Something is terribly wrong!"
			end},
		
			{name = "*", id = "6.1.0090", val = function()
				local _, y = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				return try(stack.push, stack:push(x * y))
			end},
			
			{name = "*/", id = "6.1.0100", val = function()
				local _, n3 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				if n3 == 0 then
					return false, "Tried to divide by 0."
				end
				
				local _, n2 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, n1 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				local d = n1 * n2
				local n4 = d / n3
				
				return try(stack.push, stack:push(n4));
			end},
			
			{name = "+", id = "6.1.0120", val = function() 
				local _, y = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				return try(stack.push, stack:push(x + y))
			end},
			
			{name = "-", id = "6.1.0160", val = function()
				local _, y = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				return try(stack.push, stack:push(x - y))
			end},
			
			{name = ".", id = "6.1.0180", val = function()
				local _, i = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				print(i)
				return true
			end},
			
			{name = "/", id = "6.1.0230", val = function()
				local _, y = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				return try(stack.push, stack:push(x / y))
			end},
			
			{name = "2drop", id = "6.1.0370", val = function()
				return try(stack.drop, stack:drop(2))
			end},
			
			{name = "drop", id = "6.1.1260", val = function()
				return try(stack.drop, stack:drop())
			end},
			
			{name = "exit", id = "", val = function()
				return exit(0)
			end}
		}
	end
	
	return try(self.generateWords, self:generateWords(DICT_STANDARD))
end

function Dictionary.new(name)
	local dictionary = {}
	setmetatable(dictionary, {__index = Dictionary})
	
	dictionary.name = name == nil and Dictionary.name or name
	dictionary.words = {}
	dictionary.index = {}
	
	return dictionary
end
:: errorhandler.lua
--[[pod_format="raw",created="2026-10-06 19:12:47",modified="2026-10-08 00:43:57",revision=66,xstickers={}]]
function try(func, ...)
	-- Try a function, evaluating results for errors
	
	-- result is a table containing return
	-- values from the executed function
	local result = {...}
	
	-- To be flagged, a function must return two arguments:
	-- false, and a string containing the error
	if result[1] == false and #result > 1 then
		local getinfo = debug.getinfo(func, "S")
		-- Verbose error string below - need to find a better way to activate it
		-- print("Error in " .. tostr(getinfo.short_src) .. ":" .. getinfo.linedefined .. " - " .. tostr(result[2]))
		print("e:081000000000000088:000818180000180082:00000000080000088n:10000000000000008o:00000000100000107 ERROR: " .. tostr(result[2]))
		return nil
	end
	
	-- If not flagged, then the results are returned as they were received
	return unpack(result)
end
	
:: interpreter.lua
--[[pod_format="raw",created="2026-10-06 08:54:46",modified="2026-10-08 00:39:23",revision=349,xstickers={}]]
include("errorhandler.lua")
include("word.lua")
include("dictionary.lua")
include("sentence.lua")
include("stack.lua")
--[[
Class: Interpreter

Elements:
 - dictionary: A Dictionary with words in it


]]
Interpreter = {
	dictionary = Dictionary.new(),
	stack = Stack.new()
}

function Interpreter.new(dictionary, stack)
	local interpreter = {}
	setmetatable(interpreter, {__index = Interpreter})
	interpreter.dictionary =
		dictionary == nil	and	Dictionary.new()
								or		dictionary
	
	interpreter.stack =
		stack == nil			and	Stack.new()
								or		stack
								
	interpreter.dictionary:initialize(interpreter)
	
	local initalizeResult, wordCount = interpreter.dictionary:buildIndex()
	
	print("Dictionary loaded. Words: " .. wordCount)
	return interpreter
end

function Interpreter:run(string)
	-- Generate a sentence using the given string (and trim whitespace, and make it lowercase)
	local sentence = Sentence.new(trim(string:lower()), self.dictionary)
	-- Interpret the sentence
	try(sentence.interpret, sentence:interpret(self))
	-- Print the stack size
	print("Stack size: " .. #self.stack.values)
end

function trim(s)
   return s:match("^%s*(.-)%s*$")
end
