--[[pod_format="raw",created="2026-10-07 22:32:59",modified="2026-10-24 00:39:26",revision=140,xstickers={}]]
include("errorhandler.lua")
include("word.lua")
--[[
Class: Dictionary

Elements:
 - name: String label for the Dictionary
 - words: Table of Words
 - index: k/v pairs for word lookup
 
Functions:
 - new: Return a new Dictionary
 - addWord: Add a new Word to the
 	Dictionary
 - export: Export Dictionary table
 - import: Overwrite Dictionary with
 	another Dictionary's contents
 - buildIndex: Convert words to k/v pairs
 	where k = val and v = word
]]
Dictionary = {
	name = "default",
	words = {},
	index = {}
}

function Dictionary:import(source)
	
end

function Dictionary:export(fileName)
	
end

function Dictionary:clone(name)
	local name =
		name == nil	and	self.name
						or		name
	local dictionary = Dictionary.new(name)
	
	for key, value in pairs(self.words) do
		dictionary.words[key] = self.words[key]
	end
	
	try(dictionary.buildIndex, dictionary:buildIndex())
	
	return dictionary
end

function Dictionary:buildIndex()
	local words = self.words
	
	if #words <= 0 then
		return false, "Dictionary has no words."
	end
	
	local index = {}
	
	for k, word in pairs(words) do
		index[word.name] = word
	end
	
	self.index = index
	
	return true, #words
end

function Dictionary:addWord(word)
	if word:validate() == true then
		self.words[#self.words + 1] = word
		return self:buildIndex()
	else
		return false, "Word could not be validated."
	end
end

function Dictionary:generateWords(wordList)
	local result = true
	
	if #wordList <= 0 then
		return false, "wordList had 0 entries."
	end
	
	for k, v in ipairs(wordList) do
		local word = Word.new(v.name, v.val)
		result = self:addWord(word)
	end
	
	return result
end

function Dictionary:initialize(interpreter)
	-- Forth 2012 Standard dictionary (WIP)
	if DICT_STANDARD == nil then
		DICT_STANDARD = {
		
			{name = "(", id = "6.1.0080", val = function()
				-- '(' is immediately handled in sentence.lua via Sentence:interpret().
				-- This function shouldn't ever actually run.
				return false, "Word '(' should not be runnable. Something is terribly wrong!"
			end},
		
			{name = "*", id = "6.1.0090", val = function(interpreter)
				local stack = interpreter.stack
				local _, y = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				local product = stack.convert64to32(x * y)
				return try(stack.push, stack:push(product))
			end},
			
			{name = "*/", id = "6.1.0100", val = ">r m* r> fm/mod swap drop"};
			
			{name = "*/mod", id = "6.1.0110", val = ">r m* r> fm/mod"},
			
			{name = "+", id = "6.1.0120", val = function(interpreter) 
				local stack = interpreter.stack
				local _, y = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				local sum = stack.convert64to32(x + y)
				return try(stack.push, stack:push(sum))
			end},
			
			{name = "-", id = "6.1.0160", val = function(interpreter)
				local stack = interpreter.stack
				local _, y = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				local difference = stack.convert64to32(x - y)
				return try(stack.push, stack:push(difference))
			end},
			
			{name = ".", id = "6.1.0180", val = function(interpreter)
				local stack = interpreter.stack
				local _, i = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				print(i .. " \0")
				return true
			end},
			
			
			{name = ".\"", id = "6.1.0190", val = function()
				
			end},
			
			{name = "/", id = "6.1.0230", val = ">r s>d r> fm/mod swap drop"},
			
			{name = "2drop", id = "6.1.0370", val = function(interpreter)
				local stack = interpreter.stack
				return try(stack.drop, stack:drop(2))
			end},
			
			{name = ">r", id = "6.1.0580", val = function(interpreter)
				local stack = interpreter.stack
				local returnStack = interpreter.returnStack
				
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				return try(returnStack.push, returnStack:push(x))
			end},
			
			{name = "cr", id = "6.1.0990", val = function()
				print("")
				return true
			end},
			
			{name = "drop", id = "6.1.1260", val = function(interpreter)
				local stack = interpreter.stack
				return try(stack.drop, stack:drop())
			end},
			
			{name = "fm/mod", id = "6.1.1561", val = function(interpreter)
				local stack = interpreter.stack
				-- Git tha bits
				local _, n1 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				local _, d1Most = try(stack.pop, stack:pop()) -- Most significant bit of double cell int
				if _ == nil then
					return false
				end
				local _, d1Least = try(stack.pop, stack:pop()) -- Least significant bit of double cell int
				if _ == nil then
					return false
				end
				-- Combine most and least significant bits of double into a 64-bit integer
				d1Most = d1Most << 32
				local d1 = d1Most | d1Least
				if n1 == 0 then
					return false, "Tried to divide by zero."
				end
				-- Do da math
				local n2 = d1 % n1
				local n3 = flr(d1 / n1)
				local _ = try(stack.push, stack:push(n2))
				if _ == nil then
					return false
				end
				return try(stack.push, stack:push(n3))
			end},
			
			{name = "m*", id = "6.1.1810", val = function(interpreter)
				-- ( n1 n2 -- d )
				local stack = interpreter.stack
				
				local _, n2 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				local _, n1 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				local d = stack.convert64to32(n1 * n2)
				local d1 = d 
				local d2 = d < 0 and -1 or 0
				
				local _ = try(stack.push, stack:push(d1))
				if _ == nil then
					return false
				end
				
				return try(stack.push, stack:push(d2))
			end},
			
			{name = "r>", id = "6.1.2060", val = function(interpreter)
				local stack = interpreter.stack
				local returnStack = interpreter.returnStack
				
				local _, x = try(returnStack.pop, returnStack:pop()) -- Get the top value from the return stack
				if _ == nil then
					return false
				end
				return try(stack.push, stack:push(x)) -- Put it on the main stack
			end},
			
			{name = "s>d", id = "6.1.2170", val = function(interpreter)
				-- Converts single-cell int on stack to double-cell int. The top number on the stack represents the most significant bit.
				local stack = interpreter.stack
				local _, x = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				_ = try(stack.push, stack:push(x))
				if _ == nil then
					return false
				end
				
				if x < 0 then
					return try(stack.push, stack:push(-1))
				end
				return try(stack.push, stack:push(0))
			end},
			
			{name = "sm/rem", id = "6.1.2214", val = function(interpreter)
				-- ( d1 n1 -- n2 n3 )
			end},
			
			{name = "[", id = "6.1.2500", val = function()
				-- '[' is immediately handled in sentence.lua via Sentence:interpret().
				-- This function shouldn't ever actually run.
				return false, "Word '(' should not be runnable. Something is terribly wrong!"
			end},
			
			{name = "swap", id = "6.1.2260", val = function(interpreter)
				-- ( x1 x2 -- x2 x1 )
				local stack = interpreter.stack
				
				local _, x2 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				local _, x1 = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				
				_ = try(stack.push, stack:push(x2))
				if _ == nil then
					return false
				end
				
				return try(stack.push, stack:push(x1))
			end},
			
			{name = "pick", id = "6.2.2030", val = function(interpreter)
				local stack = interpreter.stack
				local _, n = try(stack.pop, stack:pop())
				if _ == nil then
					return false
				end
				return try(stack.pick, stack:pick(n+1)) -- n is 0-indexed in Forth's "pick", but Lua tables are 1-indexed. The stack object's "pick" function treats tables as 1-indexed, as we're currently programming in Lua and not Forth.
			end},
			
			{name = "exit", id = "", val = function()
				return exit(0)
			end}
		}
	end
	
	return try(self.generateWords, self:generateWords(DICT_STANDARD))
end

function Dictionary.new(name)
	local dictionary = {}
	setmetatable(dictionary, {__index = Dictionary})
	
	dictionary.name = name == nil and Dictionary.name or name
	dictionary.words = {}
	dictionary.index = {}
	
	return dictionary
end
