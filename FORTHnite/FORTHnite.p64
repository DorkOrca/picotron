ERRORS = {
	-- Errors -1 through -79 are defined by forth-standard.org:
	-- https://forth-standard.org/standard/exception#table:throw
	
	[-1] = {
		name = "abort",
		desc = function()
			-- The word `abort` empties the data stack and performs the function of QUIT without displaying a message.
		end
	},
	[-2] = {
		name = "abort\"",
		desc = function()
			-- The word `abort"` parses a string delineated by `"` and checks the top value of the stack.
			-- If any bit of the top value is not zero, then it prints the parsed string and performs `abort`.
		end
	},
	[-3] = {
		name = "stack overflow",
		desc = function(stack)
