--[[pod_format="raw",created="2025-09-18 00:49:08",modified="2026-09-02 00:05:27",revision=204,xstickers={}]]
include("slimes.lua")
include("beauty.lua")

--		Variables
t = 0

-- 	Loops
function _init()
	backfieldA = generateField(0, 153, 480, 12, 0.5, 4, warms)
	backfieldB = generateField(0, 160, 480, 15, 0.5, 4, browns)
	backfieldC = generateField(0, 175, 480, 25, 0.5, 4, earths)
	forefieldA = generateField(0, 200, 480, 20, 0.5, 4, grays)
	forefieldB = generateField(0, 220, 480, 30, 0.5, 4, cools)
	forefieldC = generateField(0, 250, 480, 20, 0.5, 4, blues)
	generateSlime()
end

function _update()
	t += 1
	updateSlimes()
	physics()
	spawnSlimes()
end

function _draw()
	if t%2==0 then
		cls(21)
		rectfill(0,100,480,160,9)
		rectfill(0,50,480,100,31)
		rectfill(0,0,480,50,14)
		-- rectfill(slimes[1].x - slimes[1].width, slimes[1].y - slimes[1].height, slimes[1].x + slimes[1].width, slimes[1].y	, 7)
		line(backfieldA)
		line(backfieldB)
		line(backfieldC)
		drawSlimes()
		line(forefieldA)
		line(forefieldB)
		line(forefieldC)
	end
end
:: slimeAnimations.lua
--[[pod_format="raw",created="2025-09-18 20:12:26",modified="2026-06-03 17:51:10",revision=97,xstickers={}]]
function drawSlimeJump(_slime)
	if angle and _slime.y < floor then
		frame = flr((angle - 22.5) / 45) % 8 + 1
		_slime.sprite = slimeRotation[frame]
	end
end

slimeFlopL = {1, 11, 12, 11,}
slimeFlopR = {1, 12, 11, 12,}
slimeBounce = {}

function drawSlimeFlop(_slime)
	if _slime.yLast and _slime.yLast != _slime.y and _slime.y >= floor then
		_slime.frame = 16
	end
	
	if _slime.frame <= 0 and _slime.y >= floor-1*scale then
		_slime.sprite = 1
	elseif _slime.frame > 0 and _slime.y >= floor-1*scale then
		_slime.frame -= 1
		local tileset = (angle > 270 or angle <= 90) and slimeFlopR or slimeFlopL
		_slime.sprite = tileset[flr(_slime.frame/4) + 1]
	end
end
