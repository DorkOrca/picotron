--[[pod_format="raw",created="2025-09-18 00:49:08",modified="2026-01-31 01:15:42",revision=78,xstickers={}]]
include("slimes.lua")

-- 	World functions


-- Loops
function _init()
	generateSlime()
end

function _update()
	updateSlimes()
	physics()
	spawnSlimes()
end

function _draw()
	cls(31)
	rectfill(0,0,480,180,15)
	rectfill(slimes[1].x - slimes[1].width, slimes[1].y - slimes[1].height, slimes[1].x + slimes[1].width, slimes[1].y	, 7)
	drawSlimes()
end
:: slimeAnimations.lua
--[[pod_format="raw",created="2025-09-18 20:12:26",modified="2026-01-31 01:26:57",revision=68,xstickers={}]]
function drawSlimeJump(_slime)
	if angle and _slime.y < floor then
		frame = flr((angle - 22.5) / 45) % 8 + 1
		_slime.sprite = slimeRotation[frame]
	end
end

slimeFlopR = {1, 11, 12, 11,}
slimeFlopL = {1, 12, 11, 12,}
slimeBounce = {}

function drawSlimeFlop(_slime)
	if _slime.yLast then
		if _slime.yLast != _slime.y and _slime.y == floor then
			_slime.frame = 16
		end
	end
	
	if _slime.frame > 0 and _slime.y >= floor then
		_slime.frame -= 1
		if angle > 270 or angle <= 90 then
			_slime.sprite = slimeFlopR[flr(_slime.frame / 4) + 1]
		else
			_slime.sprite = slimeFlopL[flr(_slime.frame / 4) + 1]
		end
	elseif _slime.y >= floor then
		_slime.sprite = 1
	end
end
