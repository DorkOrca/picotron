greens = {3, 11, 17, 19, 26, 27}
lightgreens = {11, 26, 27}
darkgreens = {3, 17, 19}
warms = {10, 25, 31}
earths = {4, 20, 31, 5, 20, 22}
browns = {4, 20, 31}
grays = {5, 20, 22}
cools = {5, 20, 22, 1, 21}
blues = {5, 1, 21}

function generateField(x, y, width, height, density, bladeLength, bladeColors)
	
	density = density == nil and 0.5 or density
	bladeLength = bladeLength == nil and 4 or bladeLength
	bladeColors = bladeColors == nil and grays or bladeColors
	
	local totalSpace = width * height
	local totalBlades = flr(totalSpace * density)
	local field = userdata("f64", 5, totalBlades)
	
	for i = 0, totalBlades - 1 do
		local bladeX, bladeY = flr(rnd(width) + x), flr(rnd(height) + y)
		local bladeColor = bladeColors[flr(rnd(#bladeColors) + 1)]
		field:set(0, i, bladeX, bladeY, bladeX, bladeY - bladeLength, bladeColor)
		
	end
	
	return field
end

function animateField(field, time, mode)
	
end
