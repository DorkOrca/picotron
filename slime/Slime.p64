--[[pod_format="raw",created="2025-09-18 20:00:44",modified="2026-09-01 23:32:11",revision=286,xstickers={}]]
include("slimeAnimations.lua")

slimes = {}

slimeVariables = {
	["Spawn Variables"] = {
	
		["Spawn Frequency"] = 180,
		["Starting Color"] = 0,
	}
}

-- Gravity variables
floor = 180
gravity = 3
density = 0.1
dampening = 0.6

dt = 1/60

spawnFrequency = 20
startingColor = 0
spawnTimer = spawnFrequency

maxspeed = 3
minspeed = -3
maxvel = 5
minvel = 2

scale = 2

slimeRotation = 
{
	3,
	4,
	5,
	6,
	7,
	8,
	9,
	10,
}

nameParts =
{
	nameStart = 
	{
		"Ba","Bi","Bu","Be","Bo",
		"Da","Di","Du","De","Do",
		"Ga","Gi","Gu","Ge","Go",
		"Ja","Ji","Ju","Je","Jo",
		"Ka","Ki","Ku","Ke","Ko",
		"Pa","Pi","Pu","Pe","Po",
		"Za","Zi","Zu","Ze","Zo",
	},
	nameMid =
	{
		"mba","mbi","mbo",
		"nba","nbi","nbo",
		"sba","sbi","sbo",
		"tba","tbi","tbo",
		"yba","ybi","ybo",
		"rba", "rbi", "rbo",
		"gba", "gbi", "gbo",
	},
	nameEnd =
	{
	"ba","bi","bu","be","bo",
	"da","di","du","de","do",
	"ga","gi","gu","ge","go",
	"ja","ji","ju","je","jo",
	"ka","ki","ku","ke","ko",
	"ma","mi","mu","me","mo",
	"na","ni","nu","ne","no",
	"pa","pi","pu","pe","po",
	"za","zi","zu","ze","zo",
	}
}

palettes = {
	{8, 14, 23,},
	{25, 9, 10,},
	{3, 27, 26,},
	{30, 29, 26,},
	{16, 12, 28,},
	{5, 22, 6,},
}

function physics()
	for i=1,#slimes do
		if slimes[i].animFreeze == false then
			_slimeX = slimes[i].x
			_slimeY = slimes[i].y
	
			_speed = slimes[i].speed
			_velocity = slimes[i].velocity
			
			if _velocity < gravity then
				_velocity += density
			end
			
			slimes[i].xLast = _slimeX
			slimes[i].yLast = _slimeY
			
			_slimeX += _speed * scale
			_slimeY += _velocity * scale
	
			-- Ensure that position is above world floor
			if _slimeY > floor then
				_slimeY = floor
				_speed *= dampening
				_velocity *= -dampening
			end
			
			-- Wrap around on X axis
			if _slimeX < 0 then
				_slimeX += 480
			elseif _slimeX > 480 then
				_slimeX -= 480
			end
			
			slimes[i].x = _slimeX
			slimes[i].y = _slimeY
			slimes[i].speed = _speed
			slimes[i].velocity = _velocity
		end
	end
end

-- Main functions
-- 	Slime generation
function generateName()
	_name = ""
	
	_nameParts =
	{
		nameParts.nameStart[flr(rnd(#nameParts.nameStart)) + 1],
		nameParts.nameMid[flr(rnd(#nameParts.nameMid)) + 1],
		nameParts.nameEnd[flr(rnd(#nameParts.nameEnd)) + 1],
	}	

	for i=1,3 do
		_name = _name.._nameParts[i] 
	end
	
	return _name
end

function generateSlime()
	slimes[#slimes+1] =
	{
		name = generateName(),
		x = flr(rnd(400)) + 40,
		y = -100,
		xLast = x,
		yLast = y,
		sprite = 1,
		frame = 0,
		speed = 0,
		velocity = 0,
		animFreeze = false,
		inertia = 100,
		size = startingColor * 4 + 1,
		width = 3,
		height = 6,
		color = rnd(#palettes),
	}
end

function spawnSlimes()
	spawnTimer -= 1
	
	if spawnTimer <= 0 then
		for i=1,2 do
			generateSlime()
		end
		spawnTimer = spawnFrequency
	end
end

-- 	Slime behavior
function updateSlimes()
	for i=1,#slimes do
		_slime = slimes[i]	
		
		if _slime.y >= floor and flr(rnd(500)) == 0 then
			slimeJump(_slime)
		end
		
		slimes[i] = _slime
	end
	
	slimeMerge()
end
	
function slimeJump(_slime)
	if flr(_slime.y) >= 180 and abs(_slime.velocity) < 0.1 then
		_slime.velocity = -flr(rnd(maxvel - minvel) + minvel)
		_slime.speed = flr(rnd(maxspeed - minspeed) - maxspeed)
	end
end

function slimeMerge()
	for i=1,#slimes do
		for j=i,#slimes do
			if j < #slimes then
				_slime1 = slimes[i]
				_slime2 = slimes[j+1]
				
				local slime1 = {}
				local slime2 = {}
				
				if _slime1.size > _slime2.size then
					slime1 = _slime1
					slime2 = _slime2
				else
					slime1 = _slime2
					slime2 = _slime1
				end
				
				local s1Color = flr((slime1.size-1) / 4)%6+1
				local s2Color = flr((slime2.size-1) / 4)%6+1
				
				if s1Color == s2Color then
				
					_left = slime1.x - slime1.width * scale < slime2.x + slime2.width * scale
					_right = slime1.x + slime1.width * scale > slime2.x - slime2.width * scale
					_bottom = slime1.y > slime2.y + - slime2.height * scale
					_top = slime1.y - slime1.height * scale < slime2.y
					
					local sizeMod = (slime1.size-1)%4
					
					if _left and _right and _top and _bottom then
						slime1.speed = slime1.speed * 0.8 + slime2.speed * 0.8
						slime1.velocity += slime2.velocity
						slime1.size +=  max(1, slime2.size-1)%4 / (1 + sizeMod)
						if _slime1.size > _slime2.size then
							table.remove(slimes, j+1)
						else
							table.remove(slimes, i)
						end
					end
				end
			end
		end
	end
end

function slimePop(_slime)
	if _slime == nil then
	error("Slime can't pop: " .. _slime);
		return false
	end
	
	local slime = slimes[_slime]
	
end

function splash()
	
end

--		Slime drawing
function drawSlimes()
	for i=#slimes,1,-1 do
		_slime = slimes[i]
		
		if _slime.yLast != nil then
			angle = (atan2(_slime.yLast - _slime.y, _slime.xLast - _slime.x) * 360)
		end
		
		drawSlimeJump(_slime)
		drawSlimeFlop(_slime)
		
		local sprSize = min(flr((_slime.size-1)%4), 3) * 12
		local sprWidth = get_spr(_slime.sprite + sprSize):width()
		local sprHeight = get_spr(_slime.sprite + sprSize):height()
		local sprColor = flr((_slime.size-1) / 4)%6+1
		
		for i = 1, 3 do
			pal(palettes[1][i], palettes[sprColor][i])
		end
		
		local slimeY = _slime.y > floor-1 and floor or _slime.y
		
		sspr(_slime.sprite + sprSize, 0, 0, sprHeight, sprWidth, (flr(_slime.x/2)*2 - sprWidth) - 2 * scale, (flr(slimeY/2)*2) - sprHeight + 2 * scale, sprWidth * scale, sprHeight * scale)
		-- print(string.sub(tostring(_slime.size),1,3), _slime.x - 14, _slime.y + 24, 7)
		-- print(_slime.name, (_slime.x - 52) - print(_slime.name, -100, -100)/2, _slime.y + 36, 7)
	end
	
	pal()
end
