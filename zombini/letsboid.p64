--[[pod_format="raw",created="2026-06-09 23:25:56",modified="2026-06-16 09:20:51",revision=64,xstickers={}]]
-- !!! Currently unused
points = {}

function newPoint(_x, _y)
	-- Return a 2d vector where x = _x, y = _y
	local x = _x == nil and rnd(480) or _x
	local y = _y == nil and rnd(270) or _y
	
	-- Class "point"
	local point = {
		-- Variables
		x = x,
		y = y,
		-- Functions
		add = function(this, diff)
				return newPoint(this.x + diff.x, this.y + diff.y)
			end,
		div = function(this, d)
			return newPoint(this.x / d, this.y / d)
			end,
		mult = function(this, d)
			return newPoint(this.x * d, this.y * d)
			end,
		diff = function(this, other)
				return newPoint(abs(other.x - this.x), abs(other.y - this.y))
			end,
		new = function()
			local point = newPoint() add(points, point) 
			end,
		midpoint = function(this, other)
			return this.func.add(this.diff(other).div(2))
			end,
		distance = function(this, p)
			local dx = p.x - this.y
			local dy = p.y - this.y
			return sqrt(dx * dx + dy * dy)
			end
	}
	
	return point
end

function newRect(_p1, _p2)
	-- Return a rectangle where "p1" and "p2" are points representing opposite corners of the rect
	local p1 = _p1 == nil and newPoint(0, 0) or _p1
	local p2 = _p2 == nil and newPoint(480, 270) or _p2
	-- Class "rect"
	local rect = {
		-- Variables
		p1 = p1,
		p2 = p2,
		-- Functions
		contains = function(this, p)
			return this.p1.x <= p.x and this.p2.x >= p.x and
				this.p1.y <= p.y and this.p2.y >= p.y
			end,
		size = function(this)
			return this.p2.diff(this.p1)
			end,
		move = function(this, v)
			return newRect(this.p1.add(v), this.p2.add(v))
			end,
		intersects = function(this, r2)
			return this.p2.x >= r2.p1.x and this.p1.x <= r2.p2.x and
				this.p2.y >= r2.p1.y and this.p1.y <= r2.p2.y
			end,
		distanceToPoint = function(this, point)
			local px = point.x
			local py = point.y
			
			local closestX = max(this.p1.x, min(px, this.p2.x))
			local closestY = max(this.p1.y, min(py, this.p2.y))
			
			local dx = px - closestX
			local dy = py - closestY
			
			return sqrt(dx * dx + dy * dy)
			end
	}
	
	return rect
end

function newQuadtree(_area, _threshold)
	-- Return a quadtree where _area = table from newRect() and _threshold = number (4 by default)
	local area = _area == nil and newRect() or _area
	local threshold = _threshold == nil and 4 or _threshold
	
	-- Class "quadtree"
	local quadtree = {
		-- Variables
		zones = {
			find = function(this, point)
				for key, zone in ipairs(this.zones) do
					if zone.contains(zone, point) then
						return key
						end
					end
				return nil
				end
		},
		elements = {
			push = function(this, element)
				add(this.elements, element)
				end
		},
		-- Functions
		insert = function(this, element)
			if (#this.zones > 0) then
				local intersecting = this.zones.find(this, element)
				if intersecting ~= nil then
					this.zones.intersecting.insert(element)
					end
				return
				end
			
			this.elements.push(element)
			if (#this.elements >= this.threshold and this.area.size.x > 1 and this.area.size.y > 1) then
				local halfSize = this.area.size.div(2)
				local rect = newRect(this.area.p1, this.aprea.p1.add(halfSize))
				this.zones = {
					newQuadtree(rect, this.threshold), -- NW
					newQuadtree(rect.move(new Point(halfSize.x, 0)), this.threshold), -- NE
					newQuadtree(rect.move(new Point(0, halfSize.y)), this.threshold), -- SW
					newQuadtree(rect.move(halfSize), this.threshold) -- SE
					}
				for key, element in ipairs(this.elements) do
					this.insert(element)
					end
				end
				
				this.elements = {
					push = function(this, element)
						add(this.elements, element)
						end
					}
			end
	}
	
	return quadtree
end

drawQuadtree(_quad)
	
end
:: utilities.lua
--[[pod_format="raw",created="2026-06-08 20:14:14",modified="2026-06-16 00:00:05",revision=99,xstickers={}]]
function angleDiff(a1, a2)
	local diff = (a2 - a1) % 360
	
	if diff > 180 then
		diff -= 360
	end
	
	return diff
end

function clamp(i, _minVal, _maxVal)
	-- Return i clamped between _minVal and _maxVal. Clamps between 0 and 1 if _minVal and _maxVal aren't provided
	local minVal = _minVal == nil and 0 or _minVal
	local maxVal = _maxVal == nil and 1 or _maxVal
	
	return min(maxVal, max(minVal, i))
end

function euclidDistSq(x1, y1, x2, y2)
	local dx = x2 - x1
	local dy = y2 - y1
	return dx * dx + dy * dy
end

function drawPointer(_obj, _size, _filled)
	local x = _obj.x
	local y = _obj.y
	local col = _obj.color
	local size = _size == nil and 4 or _size
	local filled = _filled ~= nil and _filled or false
	
	if filled == true then
		circfill(x, y, size / 2, col)
	end
	
	for i = 0, 3 do
		local vx = cos((_obj.angle + 120 * i) / 360) * size
		local vy = sin((_obj.angle + 120 * i) / 360) * size
		if i == 0 then
			local vx2 = cos((_obj.angle + 120 * i-1%3) / 360) * size
			local vy2 = sin((_obj.angle + 120 * i-1%3) / 360) * size
			line(x + vx, y + vy, x + vx2, y + vy2, col)
		else
			line(x + vx, y + vy, col)
			if filled == true then
				circfill(x + vx / 2, y + vy / 2, size / 4, col)
			end
		end
	end
end

function getAngle2D(_obj, _target)
	-- Return 360-degree angle from _obj to _target
	local dx = _target.x - _obj.x
	local dy = _target.y - _obj.y
	local a = atan2(dx, dy)
	return a * 360
end

function printShadow(_string, _x, _y, _mainColor, _shadowColor)
	-- Print text with shadow 1px below
	print(_string, _x, _y, _shadowColor)
	return print(_string, _x, _y-1, _mainColor)
end

rainbow = {8, 24, 25, 9, 10, 26, 11, 27, 17, 12, 28, 29, 23, 14, 30} 
function showSelector(_x, _y) 
	-- Show cursor for selecting options in GUI 
	local selectorX = (sin(t() / 3) * 4) + _x 
	local selectorY = (cos(t() / 2) * 3) + _y 
	circfill(selectorX, selectorY, 2, rainbow[flr(t() * 10) % #rainbow + 1]) 
end 

function sortTableBy(_table, _dir, _key)
	-- Sort table in "ascending" or "descending" corner, with optional _key to sort list of objects by
	if _table == nil or #_table == 0 then
		error("sortTableBy(): Table is nil or empty.")
	end
	
	local dir = _dir == nil and "ascending" or _dir
	local key = _key == nil and nil or _key
	
	local sortedTable = {}
	
	for i = #_table, 1, -1 do
		if #sortedTable == 0 then
			add(sortedTable, _table[i])
			goto STBcontinue
		end
		
		if not (_key == nil) then
			local inserted = false
			for j = #sortedTable, 1, -1 do
				local tableComparison = false
				if dir == "ascending" then
					tableComparison = _table[i][_key] > sortedTable[j][_key]
				else
					tableComparison = _table[i][_key] < sortedTable[j][_key]
				end
				
				if tableComparison == true then
					add(sortedTable, _table[i], j+1)
					inserted = true
					break
				end
			end
			if inserted == false then
				add(sortedTable, _table[i], 1)
			end
		else
			local inserted = false
			for j = #sortedTable, 1, -1 do
				local tableComparison = false
				if dir == "ascending" then
					tableComparison = _table[i] > sortedTable[j]
				else
					tableComparison = _table[i] < sortedTable[j]
				end
				
				if tableComparison == true then
					add(sortedTable, _table[i], j+1)
					inserted = true
					break
				end
			end
			if inserted == false then
				add(sortedTable, _table[i], 1)
			end
		end
		
		::STBcontinue::
	end
	
	return sortedTable
end

function tableAverage(_table)
	-- Returns average of all values in table
	if _table == nil or #_table == 0 then
		error("tableAverage(): _table is nil or empty.")
	end
	
	local average = 0
	
	for index, value in ipairs(_table) do
		average += value
	end
	
	return average / #_table
end
