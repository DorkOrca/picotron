--[[GROUP:Initialization]]
function initBoidControls()
	local boidControls = {
		visible = true,
		mainmenu = {
			menus = {
				"submenu1",
				"submenu2",
				"submenu3"
			},
			selected = 1,
			btnpAction = {
				-- Up
				[2] = function()
					boidControls.mainmenu.selected = (boidControls.mainmenu.selected - 2) % #boidControls.mainmenu.menus + 1
				end,
				-- Down
				[3] = function()
					boidControls.mainmenu.selected = boidControls.mainmenu.selected % #boidControls.mainmenu.menus + 1
				end,
				-- O button / Z key
				[4] = function()
					boidControlMenu = boidControls.mainmenu.menus[boidControls.mainmenu.selected]
				end,
			}
		},
