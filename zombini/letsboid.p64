--[[GROUP:General]]
function newBoid(_obj)
	-- Add a table to the provided object containing 3 boid parameters.
	if _obj.angle == nil then
		error("Error in newBoid(): object does not have an angle :(  -  " .. _obj)
	end
	_obj.boid = {
		angle = _obj.angle,
		diff = 0,
		separationStrength = boidControls.submenu1.orderedList[1].value,
		alignmentStrength = boidControls.submenu1.orderedList[2].value,
		cohesionStrength = boidControls.submenu1.orderedList[3].value,
		contained = boidControls.submenu1.orderedList[4].value,
		borderStrength = 0.15,
		borderDist = 50,
		targetStrength = 0.5,
		neighborDist = boidControls.submenu1.orderedList[5].value * 2,
		personalDist = boidControls.submenu1.orderedList[5].value,
		personalNeighbors = {},
		longNeighbors = {},
		target = nil,
	}
	
	return _obj
end

function updateBoids(_boids)
	if boidControlMenu == "submenu2" and boidPresetChanged == true then
		boidControls.submenu1.orderedList[1].value = boidPresets[boidPresetChoice].separation
		boidControls.submenu1.orderedList[2].value = boidPresets[boidPresetChoice].alignment
		boidControls.submenu1.orderedList[3].value = boidPresets[boidPresetChoice].cohesion
		boidControls.submenu1.orderedList[4].value = boidPresets[boidPresetChoice].contained
		boidControls.submenu1.orderedList[5].value = boidPresets[boidPresetChoice].gridSize
		boidControls.submenu1.orderedList[6].value = boidPresets[boidPresetChoice].maxNeighbors
		boidPresetChanged = false
	end
	
	for key, obj in ipairs(_boids) do
		if obj.boid ~= nil then
			obj.boid.separationStrength = boidControls.submenu1.orderedList[1].value
			obj.boid.alignmentStrength = boidControls.submenu1.orderedList[2].value
			obj.boid.cohesionStrength = boidControls.submenu1.orderedList[3].value
			obj.boid.contained = boidControls.submenu1.orderedList[4].value
			obj.boid.neighborDist = boidControls.submenu1.orderedList[5].value * 2
			obj.boid.personalDist = boidControls.submenu1.orderedList[5].value
		end
	end
end

function drawBoid(_boid)
	boidGraphics[boidGraphicsChoice].func(_boid)
end

function drawBoids(_boids)
	local boids = _boids
	
	for key = #boids, 1, -1 do
		local boid = boids[key]
		
		drawBoid(boid)
		--[[
		if key == 1 then
			circ(boid.x, boid.y, boid.boid.neighborDist, boid.color)
			circ(boid.x, boid.y, boid.boid.personalDist, boid.color)
		end
		]]
		
		
	end
end



--[[GROUP:Controls]]

function toggleBoidControls()
	if (btnp(5) or keyp("space")) and (boidControls[boidControlMenu] ~= nil) then
		if boidControls.visible == true then
			boidControls.visible = false
		else
			boidControls.visible = true
		end
	end
	return _boidControls
end

function navigateBoidControls(_boidControls)
	if boidControls.visible == true then
		local boidControlsChanged = false
		
		for button, func in pairs(boidControls[boidControlMenu].btnpAction) do
			if btnp(button) then
				boidControls[boidControlMenu].btnpAction[button]()
				boidControlsChanged = true
			end
		end
		
		if boidControlsChanged == true then
			updateBoids(boids)
		end
	end
end

function drawBoidControls()
	if (boidControls[boidControlMenu] ~= nil) and (boidControls.visible == true) then
		local selectorOffset = (boidControls[boidControlMenu].selected - 1) * 10
		
		if boidControlMenu == "mainmenu" then
			rrect(-2, -2, 98, 37, 2, 5)
			rrect(-2, -2, 98, 36, 2, 6)
			rrectfill(-2, -2, 97, 35, 1, 6)
			rrectfill(2, 2 + selectorOffset, 92, 10, 3, 7)
			showSelector(88, 7 + selectorOffset)
			printShadow("Main Parameters", 4, 4, 0, 22)
			printShadow("Presets", 45, 14, 0, 22)
			printShadow("Settings", 41, 24, 0, 22)
			return
		end
		
		if boidControlMenu == "submenu1" then
			rrect(-2, -2, 98, 67, 2, 5)
			rrect(-2, -2, 98, 66, 2, 6)
			rrectfill(-2, -2, 97, 65, 1, 6)
			rrectfill(2, 2 + selectorOffset, 92, 10, 3, 7)
			showSelector(88, 7 + selectorOffset)
			
			for i = 1, #boidControls[boidControlMenu].orderedList do
				local list = boidControls[boidControlMenu].orderedList[i]
				local name = list.name
				local val = list.value
				
				local printLength = print(name, -100, -100, 0)
				printShadow(name .. ": " .. val, -47 - printLength, 4 + 10 * (i - 1), 0, 22)
			end
		end
		
		if boidControlMenu == "submenu2" then
			rrect(-2, -2, 98, 37, 2, 5)
			rrect(-2, -2, 98, 36, 2, 6)
			rrectfill(-2, -2, 97, 35, 1, 6)
			rrectfill(2, 2, 92, 10, 3, 7)
			showSelector(88, 7)
			
			local presetLabel =
				boidControls.submenu2.selected == 1 and "Parameters" or
				boidControls.submenu2.selected == 2 and "Graphics"
			local presetValue =
				boidControls.submenu2.selected == 1 and boidPresetChoice or
				boidControls.submenu2.selected == 2 and boidGraphicsChoice
			
			printShadow(presetLabel, 4, 4, 0, 22)
			printShadow("Preset: " .. presetValue, 4, 14, 0, 22)
			
			if boidControls.submenu2.selected == 1 then
				printShadow(boidPresets[boidPresetChoice].name, 4, 24, 0, 22)
			elseif boidControls.submenu2.selected == 2 then
				printShadow(boidGraphics[boidGraphicsChoice].name, 4, 24, 0, 22)
			end
			
			return
		end
		
		if boidControlMenu == "submenu3" then
			rrect(-2, -2, 120, 67, 2, 5)
			rrect(-2, -2, 120, 66, 2, 6)
			rrectfill(-2, -2, 119, 65, 1, 6)
			rrectfill(2, 2 + selectorOffset, 114, 10, 3, 7)
			showSelector(110, 7 + selectorOffset)
			
			for i = 1, #boidControls[boidControlMenu].orderedList do
				local list = boidControls[boidControlMenu].orderedList[i]
				local name = list.name
				local val = list.value
				
				local printLength = print(name, -100, -100, 0)
				printShadow(name .. ": " .. val, -17 - printLength, 4 + 10 * (i - 1), 0, 22)
			end
		end
	end
end



--[[GROUP:Grid]]
function buildGrid(_boids, _cellSize)
	local grid = {}
	for _, boid in ipairs(_boids) do
		local cx, cy = flr(boid.x / _cellSize), flr(boid.y / _cellSize)
		local key = cx + cy * 480
		grid[key] = grid[key] or {}
		add(grid[key], boid)
	end
	return grid
end

function gridNeighbors(_obj, _grid, _cellSize, _dist)
	local cx, cy = flr(_obj.x / _cellSize), flr(_obj.y / _cellSize)
	local dist = _dist == nil and _obj.boid.neighborDist or _dist
	local r2 = dist * dist
	local out = {}
	for dy = -1, 1 do
		for dx = -1, 1 do
			if #out >= boidControls.submenu1.orderedList[6].value then break end
			
			local cell = _grid[(cx+dx) + (cy+dy) * 480]
			
			if cell == nil then
				goto gridNeighborsContinue1
			end
			
			for _, t in ipairs(cell) do
				if t == _obj then
					goto gridNeighborsContinue2
				end
				
				local d = euclidDistSq(_obj.x, _obj.y, t.x, t.y)
				if d < r2 then
					t.dist = d
					add(out, t)
				end
				
				
				::gridNeighborsContinue2::
			end
			
			::gridNeighborsContinue1::
		end
	end
	
	return out
end



--[[GROUP:Separation]]
function boidGetNeighbors(_obj, _targets, _sorted, _dist)
	-- Return a table of objects within neighborDist range of _obj (NO GRID, COMPARES AGAINST ALL NEIGHBORS)
	if _obj == nil then
		error("boidGetNeighbors(): _obj provided was nil.")
	end
	
	if _targets == nil then
		error("boidGetNeighbors(): _targets provided was nil.")
	end
	
	local maxDistFromObjToNeighbors = _dist == nil and _obj.boid.neighborDist or _dist
	local listShouldBeSorted = _sorted == nil and false or _sorted
	
	local neighbors = {}
	local foundSelf = false
	
	for index, target in ipairs(_targets) do
		local neighborDist = euclidDistSq(_obj.x, _obj.y, target.x, target.y)
		if neighborDist == 0 and foundSelf == false then
			foundSelf = true
			goto BGNcontinue
		end
		
		if neighborDist < maxDistFromObjToNeighbors * maxDistFromObjToNeighbors then
			if listShouldBeSorted == true then
				target.dist = neighborDist
			end
			
			add(neighbors, target)
		end
		
		::BGNcontinue::
	end
	
	if listShouldBeSorted == true and #neighbors > 0 then
		neighbors = sortTableBy(neighbors, "ascending", "dist")
	end 
	
	return neighbors
end

function boidSeparation(_obj, _neighbors)
	-- Update boid angle, turning away from neighbors that are too close
	local obj = _obj
	local separationDiff = 0
	local personalNeighbors = {}
	
	if #_neighbors > 0 then
		local neighbors = _neighbors
		local intersectRange = max(1, obj.boid.personalDist)
		intersectRange = intersectRange * intersectRange
		
		local neighborInfluence = {x = 0, y = 0}
	
		for key, neighbor in ipairs(neighbors) do
			
			local neighborDist = neighbor.dist
			if neighborDist < intersectRange then
				add(personalNeighbors, neighbor)
				--obj.color = (obj.color + 1) % 31 + 1
				local targetAngle = getAngle2D(neighbor, obj)
				local influenceFactor = (intersectRange - neighborDist) / intersectRange
				local vx, vy = cos(targetAngle / 360) * influenceFactor, sin(targetAngle / 360) * influenceFactor
				neighborInfluence.x += vx
				neighborInfluence.y += vy
			end
		end
		
		local diff = 0
		
		if neighborInfluence.x ~= 0 and neighborInfluence.y ~= 0 then
			local objAngle = (obj.boid.angle % 360) / 360
			
			local desiredAngle = atan2(neighborInfluence.x, neighborInfluence.y) * 360
			local diff = angleDiff(objAngle * 360, desiredAngle)
			obj.boid.diff = diff
			
			if diff ~= 0 then
				local separationInfluence = obj.boid.separationStrength
				separationDiff = diff * separationInfluence * 0.02
			end
		end
	end
	
	return separationDiff, personalNeighbors
end



--[[GROUP:Alignment]]
function boidGetNeighborAverageAngle(_obj, _neighbors)
	-- Returns value equal to average angle of _obj and _neighbors
	local angleTable = {}
	
	for index, neighbor in ipairs(_neighbors) do
		add(angleTable, neighbor.angle%360)
	end
	
	local sx, sy = 0, 0
	
	for _, a in ipairs(angleTable) do
		sx += cos(a/360)
		sy += sin(a/360)
	end
	
	if sx == 0 and sy == 0 then
		return _obj.angle
	end
	
	return atan2(sx, sy) * 360
end

function boidAlignment(_obj, _neighbors)
	-- Update boid angle, pointing toward average angle of neighbors
	local alignmentDiff = 0
	local neighborAvgAngle = nil
	
	if #_neighbors > 0 then
		neighborAvgAngle = boidGetNeighborAverageAngle(_obj, _neighbors)
		local alignmentInfluence = _obj.boid.alignmentStrength
		
		alignmentDiff = angleDiff(_obj.angle, neighborAvgAngle) * alignmentInfluence * 0.05
	end
	return alignmentDiff, neighborAvgAngle
end



--[[GROUP:Cohesion]]
function boidGetNeighborAveragePosition(_obj, _neighbors)
	-- Returns table with "x" and "y" values equal to average position of _obj and _neighbors
	local avgXTable = {}
	local avgYTable = {}
	
	add(avgXTable, _obj.x)
	add(avgYTable, _obj.y)
	
	for index, neighbor in ipairs(_neighbors) do
		add(avgXTable, neighbor.x)
		add(avgYTable, neighbor.y)
	end
	
	local avgX = tableAverage(avgXTable)
	local avgY = tableAverage(avgYTable)
	
	return {
		x = avgX,
		y = avgY
	}
end

function boidCohesion(_obj, _neighbors)
	-- Update boid angle, pointing toward center mass of neighbors
	local cohesionDiff = 0
	local neighborAvgPos = nil
	
	if #_neighbors > 0 then
		neighborAvgPos = boidGetNeighborAveragePosition(_obj, _neighbors)
		local targetAngle = getAngle2D(_obj, neighborAvgPos)
		local cohesionInfluence = _obj.boid.cohesionStrength
		
		cohesionDiff = angleDiff(_obj.angle, targetAngle) * cohesionInfluence * 0.05
	end
	
	return cohesionDiff, neighborAvgPos
end



--[[GROUP:Targeting]]
function boidTargeting(_obj)
	-- Update boid angle, pointing toward _obj.boid.target
	local targetingDiff = 0
	
	if not (_obj.boid.target == nil) then
		local targetAngle = getAngle2D(_obj, _obj.boid.target)
		local targetInfluence = clamp(_obj.boid.targetStrength)
		targetingDiff = angleDiff(_obj.angle, targetAngle) * targetInfluence * 0.05
	end
	
	return targetingDiff
end



--[[GROUP:]]
function boidDiffAngles(_obj, _neighbors)
	local separationDiff = 0
	local alignmentDiff = 0
	local cohesionDiff = 0
	
end



--[[GROUP:Extras]]
function containBoid(_obj)
	local x = _obj.x
	local y = _obj.y
	
	local borderDist = _obj.boid.borderDist
	local borderStrength = _obj.boid.borderStrength
	
	local angleX, angleY = 0, 0
	local xInfluence, yInfluence = 0, 0
	
	if x < borderDist then
		angleX = 180
		xInfluence = min(borderDist, max(0, borderDist - x)) / borderDist * borderStrength
	elseif x > 480 - borderDist then
		angleX = 0
		xInfluence = min(borderDist, max(0, borderDist - (x - 430))) / borderDist * borderStrength
	end
	
	if y < borderDist then
		angleY = 90
		yInfluence = min(borderDist, max(0, borderDist - y)) / borderDist * borderStrength
	elseif y > 270 - borderDist then
		angleY = 270
		yInfluence = min(borderDist, max(0, borderDist - (y - 220))) / borderDist * borderStrength
	end
	
	local xDiff = angleDiff(angleX, _obj.angle) * xInfluence
	local yDiff = angleDiff(angleY, _obj.angle) * yInfluence
	
	return xDiff, yDiff
end

function initTrail()
	trailBuffer = userdata("u8", 480, 270)
	set_draw_target(trailBuffer)
	cls(7)
	for i = 1, 2000 do
		for j = 0, 2 do
			pset(rnd(480), rnd(270), 15 + j * 8)
		end
	end
	set_draw_target()
end

function updateTrail(group)
	local trailEnabled = boidControls.submenu3.orderedList[4].value
	local trailSize = boidControls.submenu3.orderedList[5].value
	
	if trailEnabled == 1 and #group > 0 then
		set_draw_target(trailBuffer)
		local trailRadius = boidControls.submenu3.orderedList[5].value
		
		for key, obj in ipairs(group) do
			circfill(obj.x, obj.y, trailSize, obj.color)
		end
	end
	
	set_draw_target()
end

function drawTrail()
	blit(trailBuffer, get_draw_target(), 0, 0, 0, 0, 480, 270)
end



--[[GROUP:Main Loop]]
function updateBoid(_obj, _allies, _grid)
	-- Update boid's angle of influence
	if _obj.boid == nil then
		_obj = newBoid(_obj)
	else
		_obj.boid.angle = _obj.angle
	end
	
	--local neighbors = boidGetNeighbors(_obj, _allies)
	local neighbors = gridNeighbors(_obj, _grid, boidControls.submenu1.orderedList[5].value)
	_obj.boid.longNeighbors = neighbors
	local diffs = {}
	
	if #neighbors > 0 then
		local separationDiff, personalNeighborList = boidSeparation(_obj, neighbors)
		_obj.boid.personalNeighbors = personalNeighborList
		if separationDiff ~= 0 then
			add(diffs, separationDiff)
		else
			_obj.boid.personalNeighbors = {}
		end
		
		local alignmentDiff, neighborAvgAngle = boidAlignment(_obj, neighbors)
		_obj.boid.neighborAvgAngle = neighborAvgAngle
		if alignmentDiff ~= 0 then
			add(diffs, alignmentDiff)
		end
		
		local cohesionDiff, neighborAvgPos = boidCohesion(_obj, neighbors)
		_obj.boid.neighborAvgPos = neighborAvgPos
		if cohesionDiff ~= 0 then
			add(diffs, cohesionDiff)
		end
		
		local targetingDiff = boidTargeting(_obj)
		if targetingDiff ~= 0 then
			add(diffs, targetingDiff)
		end
		
		if _obj.boid.contained == 1 then
			local xDiff, yDiff = containBoid(_obj)
			if xDiff ~= 0 then
				add(diffs, xDiff)
			end
			if yDiff ~= 0 then
				add(diffs, yDiff)
			end
		end
		
		local totalDiff = 0
		
		if #diffs > 0 then
			
			for key, value in ipairs(diffs) do
				totalDiff += value
			end
			
			_obj.boid.angle = angleDiff(_obj.angle, _obj.angle + totalDiff) % 360
			_obj.angle = (_obj.angle + totalDiff) % 360
		else
			_obj.boid.angle = _obj.angle
		end
	else
		if _obj.boid.contained == 1 then
			local xDiff, yDiff = containBoid(_obj)
			if xDiff ~= 0 then
				add(diffs, xDiff)
			end
			if yDiff ~= 0 then
				add(diffs, yDiff)
			end
		end
		
		local totalDiff = 0
		
		if #diffs > 0 then
			
			for key, value in ipairs(diffs) do
				totalDiff += value
			end
			
			_obj.boid.angle = angleDiff(_obj.angle, _obj.angle + totalDiff) % 360
			_obj.angle = (_obj.angle + totalDiff) % 360
		else
			_obj.boid.angle = _obj.angle
		end
	end
	
	return _obj
end
:: main.lua
--[[pod_format="raw",created="2026-06-08 20:12:47",modified="2026-06-16 19:28:34",revision=405,xstickers={}]]
include("boid.lua")
include("movement.lua")

function _init()
	boidControls = initBoidControls()
	boids = {}
	startingBoidCount = 50
	
	for i = 1, startingBoidCount do
		spawnBoid()
	end
	
	initTrail()
end

function spawnBoid(_color)
	local color = _color == nil and rainbow[flr(rnd(#rainbow)) + 1] or _color
	
	local newBoid = {
		x = rnd(480),
		y = rnd(270),
		angle = rnd(360),
		speed = 0,
		acceleration = 0.5,
		color = color,
	}
	
	while newBoid.color == 7 do
		newBoid.color = rainbow[flr(rnd(#rainbow)) + 1]
	end
	
	add(boids, newBoid)
end

function moveBoids()
	local grid = buildGrid(boids, boidControls.submenu1.orderedList[5].value)
	
	for key, boid in ipairs(boids) do
		boid = updateBoid(boid, boids, grid)
		boid = moveForward(boid)
		boid = infiniteScreen(boid)
	end
end

function regulateBoids()
	local maxBoids = boidControls.submenu3.orderedList[1].value
	if #boids > maxBoids then
		for i = #boids, maxBoids + 1, -1 do
			deli(boids)
		end
	elseif #boids < maxBoids then
		for i = #boids, maxBoids do
			spawnBoid()
		end
	end
end

function drawNeighborConnections(_obj, _full)
	local drawLinks = boidControls.submenu3.orderedList[3].value
	if drawLinks ~= 1 then
		return
	end
	
	-- Draw line between object and neighbors. _full = true: draw affecting forces
	local neighborSpace = _obj.boid.neighborDist * _obj.boid.neighborDist
	
	for key, neighbor in ipairs(_obj.boid.longNeighbors) do
		local distanceBetween = euclidDistSq(_obj.x, _obj.y, neighbor.x, neighbor.y)
		if distanceBetween <= neighborSpace then
			line(_obj.x, _obj.y, neighbor.x, neighbor.y, 6)
		end
	end
	
	
	if _full == nil or _full ~= 1 then
		return
	end
	
	-- Draw affecting forces
	if _obj.boid.separationStrength > 0 then
		local personalSpace = _obj.boid.personalDist * _obj.boid.personalDist
		for key, neighbor in ipairs(_obj.boid.personalNeighbors) do
			local distanceBetween = euclidDistSq(_obj.x, _obj.y, neighbor.x, neighbor.y)
			if distanceBetween <= personalSpace then
				line(_obj.x, _obj.y, neighbor.x, neighbor.y, 0)
			end
		end
	end
	
	if _obj.boid.cohesionStrength > 0 and _obj.neighborAvgPos ~= nil then
		local nPos = _obj.boid.neighborAvgPos
		circ(nPos.x, nPos.y, 4, _obj.color)
		pset(nPos.x, nPos.y, _obj.color)		
	end
	
	if _obj.boid.alignmentStrength > 0 and _obj.boid.neighborAvgAngle ~= nil then
		local nAng = _obj.boid.neighborAvgAngle / 360
		local nX = _obj.x + cos(nAng) * 20
		local nY = _obj.y + sin(nAng) * 20
		line(_obj.x, _obj.y, nX, nY, 6)
	end
	
	local nAng = _obj.angle / 360
	local nX = _obj.x + cos(nAng) * 10
	local nY = _obj.y + sin(nAng) * 10
	line(_obj.x, _obj.y, nX, nY, _obj.color)
end

function attractBoids(_boidList)
	local boids = _boidList
	local mx, my, mb = mouse()
	if mb == 0x1 and boids[1].boid.target == nil then
		for key, obj in ipairs(boids) do
			obj.boid.target = {x = mx, y = my}
		end
	elseif mb == 0 and boids[1].boid.target ~= nil then
		for key, obj in ipairs(boids) do
			obj.boid.target = nil
		end
	end
	
	return boids
end

function _update()
	regulateBoids()
	
	if (1 - stat(1) > 0.1) and (#boids < flr(t()) + startingBoidCount) then
		--spawnBoid()
	end
	
	navigateBoidControls()
	moveBoids()
	updateTrail(boids)
	
	if #boids > 0 then
		boids = attractBoids(boids)
	end
	
	toggleBoidControls()
end

function _draw()
	local bgColor = boidControls.submenu3.orderedList[2].value
	cls(bgColor)
	
	local trailActive = boidControls.submenu3.orderedList[4].value
	if trailActive == 1 then
		drawTrail()
	end
	
	for key = #boids, 1, -1 do
		local boid = boids[key]
		--local full = (key == 1) and 1 or 0
		drawNeighborConnections(boid, full)
	end
	drawBoids(boids)
	drawBoidControls()
	
	local cpuActive = boidControls.submenu3.orderedList[6].value
	if cpuActive == 1 then
		print(stat(1), 461, 3, 0)
	end
end
:: movement.lua
--[[pod_format="raw",created="2026-06-08 20:28:37",modified="2026-06-15 18:59:13",revision=93,xstickers={}]]
-- movement.lua
function moveForward(_obj, _style)
	_obj.speed = min(_obj.speed + _obj.acceleration / 10, _obj.acceleration)
	
	local wobbleVariance = 0
	
	if style == 1 then
		wobbleVariance = sin(time()*_obj.acceleration)/12
	end
	
	
	_obj.collisionAngle = _obj.angle + wobbleVariance
	_vx = cos((_obj.angle + wobbleVariance) / 360) * _obj.speed
	_vy = sin((_obj.angle + wobbleVariance) / 360) * _obj.speed
	
	_obj.x += _vx
	_obj.y += _vy
	
	return _obj
end

function infiniteScreen(_obj)
	_obj.x = _obj.x%480
	_obj.y = _obj.y%270
	
	return _obj
end
