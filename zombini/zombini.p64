--[[pod_format="raw",created="2026-06-05 21:38:58",modified="2026-06-06 00:59:39",revision=107,xstickers={}]]
include("collision.lua")



--[[GROUP:Utility]]
function clamp(i, _minVal, _maxVal)
	-- Return i clamped between _minVal and _maxVal. Defaults between 0 and 1
	local minVal = _minVal == nil and 0 or _minVal
	local maxVal = _maxVal == nil and 1 or _maxVal
	
	return min(minVal, max(maxVal, i))
end

function tableAverage(_table)
	-- Returns average of all values in table
	local average = 0
	
	for value in _table do
		average += value
	end
	
	return average / #_table
end

--[[GROUP:Initialization]]
function newBoid(_obj)
	-- Add a table to the provided object containing 3 boid parameters.
	if _obj.angle == nil then
		error("Error in newBoid(): object does not have an angle :(  -  " .. _obj)
	end
	_obj.boid = {
		angle = _obj.angle,
		separationStrength = 1,
		alignmentStrength = 1,
		cohesionStrength = 1,
		targetStrength = 0.2,
		targetDist = 20,
		target = nil,
	}
	
	return _obj
end

--[[GROUP:Cohesion]]
function boidGetNeighbors(_obj, _targets, _dist)
	-- Return a table of objects within targetDist range of _obj
	if _obj == nil then
		error("boidGetNeighbors(): _obj provided was nil.")
	end
	
	if _targets == nil then
		error("boidGetNeighbors(): _targets provided was nil.")
	end
	
	local dist = _dist == nil and _obj.boid.targetDist or _dist
	
	local neighbors = {}
	
	for target in _targets do
		if euclidDist(_obj, target) < dist then
			add(neighbors, target)
		end
	end
	
	return neighbors
end
 
--[[BOOKMARK:Need to work on dir]]
function sortTableBy(_table, _key, _dir)
	--
	if _table == nil or #_table < 0 then
		error("sortTableBy(): Table is nill or empty.")
	end
	
	local dir = _dir == nil and "ascending" or _dir
	
	local sortedTable = {}
	
	for i = #_table, 1, -1 do
		if #sortedTable > 0 then
			add(sortedTable, _table[i])
			goto STBcontinue
		end
		
		if not _key == nil then
			for j = #sortedTable, 1, -1 do
				if _table[i]._key > sortedTable[j]._key then
					add(sortedTable, _table[i], j+1)
				end
			end
		else
			for j = #sortedTable, 1, -1 do
				if _table[i] > sortedTable[j] then
					add(sortedTable, _table[i], j+1)
				end
			end
		end
		
		::STBcontinue::
	end
	
	
end

function boidGetNeighborAveragePosition(_obj, _neighbors)
	-- Returns table with "x" and "y" values equal to average position of _obj and _neighbors
	local avgXTable = {}
	local avgYTable = {}
	
	add(avgXTable, _obj.x)
	add(avgYTable, _obj.y)
	
	for neighbor in _neighbors do
		add(avgXTable, neighbor.x)
		add(avgYTable, neighbor.y)
	end
	
	local avgX = tableAverage(avgXTable)
	local avgY = tableAverage(avgYTable)
	
	return {
		x = avgX,
		y = avgY
	}
end

function boidGetNeighborAverageAngle(_obj, _neighbors)
	-- Returns value equal to average angle of _obj and _neighbors
	local angleTable = {}
	
	add(angleTable, _obj.angle)
	
	for neighbor in _neighbors do
		add(angleTable, neighbor)
	end
	
	return tableAverage(angleTable)
end

function boidCohesion(_obj, _neighbors)
	
end

--[[GROUP:Targeting]]
function boidFindTargetAngle(_obj, _target)
	-- Return 360-degree angle from _obj to _target
	local dx = _target.x - _obj.x
	local dy = _target.y - _obj.y
	local a = atan2(dy, dx)
	return a * (180 / 3.14159)
end

function boidTargeting(_obj)
	if not _obj.boid.target == nil then
		local targetAngle = boidFindTarget(_obj, _obj.boid.target)
		local targetInfluence = clamp(_obj.boid.targetStrength)
		_obj.angle += _obj.angle - targetAngle * targetInfluence
	end
	
	return _obj
end


--[[GROUP:Main Loop]]
function updateBoid(_obj)
	-- Update boid's angle of influence
	if _obj.boid == nil then
		_obj = newBoid(_obj)
	end
	
	-- Separation
	
	-- Alignment
	
	-- Cohesion
	
	-- Targeting
	_obj = boidTargeting(_obj)
	
	
	return _obj
end
:: collision.lua
--[[pod_format="raw",created="2025-10-08 00:26:05",modified="2026-06-05 23:32:53",revision=329,xstickers={}]]
--MODULE: AABB collision

--[[
 	Axis-aligned boundary box collision for circles and squares.
	Collision is based on sprites with the "0" flag in the active map.
	Currently only for box colliders, not round colliders.
	
	Box colliders are implemented through a table with four sub-tables with x/y coords.
	These coords coorespond with the corners of the boundary box as follows:
	
		- 1: Top-left
		- 2: Top-right
		- 3: Bottom-left
		- 4: Bottom-right
	
	Comes with functions for getting current and neighbor sprites in order to 
	detect their flags.
--]]

-- Add a table to the provided object with presumed edges of box collider, for use in collision functions
-- Top-left, top-right, bottom-left, bottom-right
function boxCollider(_obj)
	-- "_obj.width" and "_obj.height" variables in table indicate "rect" or "rectfill" drawing methods
	if _obj.width and _obj.height then
		-- Calculate dimensions of boundary box based on rect size
		-- Left side: x
		-- Right side: x + width
		-- Top: y
		-- Bottom: y + width
		_col =
		{
			[1] = {
				x = _obj.x,
				y = _obj.y,
			},
			[2] = {
				x = _obj.x + _obj.width,
				y = _obj.y,
			},
			[3] = {
				_obj.x,
				_obj.y + _obj.height,
			},
			[4] = {
			x = _obj.x + _obj.width,
			y = _obj.y + _obj.height,
			},
		}
		-- "_obj.size" variable indicates "circ" or "circfill" drawing method
	elseif _obj.size then
		-- Calculate dimensions of boundary box based on circle size
		-- Left side: x - size
		-- Right side: x + size
		-- Top: y - size
		-- Bottom: y + size
		_col =
		{
			[1] = {
				x = _obj.x - _obj.size,
				y = _obj.y - _obj.size,
			},
			[2] = {
				x = _obj.x + _obj.size,
				y = _obj.y + _obj.size,
			},
			[3] = {
				x = _obj.x - _obj.size,
				y = _obj.y + _obj.size,
			},
			[4] = {
				x = _obj.x + _obj.size,
				y = _obj.y + _obj.size,
			},
		}
	-- Otherwise, give an error because _obj doesn't have named variables required to do boundary box calculations
	else
		error("collision.lua/boxCollider(): Unable to identify object shape. Check function comments to correct the name of this object's size and position variables.")
	end

	-- Put the table listing the box collider's corners into _obj
	_obj.collision = _col
	
	return _obj
end

-- Get the sprite number of a map cell that _obj is currently occupying
-- Can manually offset map cells using _xMod or _yMod
	-- _xMod: 
		-- Positive = cells to the right
		-- Negative = cells to the left
	-- _yMod:
		-- Positive: cells below
		-- Negative: cells above
function getMapSprite(_obj, _xMod, _yMod)
	_x = _xMod != nil and _xMod or 0
	_y = _yMod != nil and _yMod or 0
	return mget(_obj.x // 16 + _x, _obj.y // 16 + _y)
end

function getMapCell(_x, _y, _xMod, _yMod)
	_xMod = _xMod != nil and _xMod or 0
	_yMod = _yMod != nil and _yMod or 0
	
	_cell = {
		x = (_x // 16 + _xMod) * 16,
		y = (_y // 16 + _yMod) * 16,
		width = 16,
		height = 16,
	}
	
	return _cell	
end

function getCellFlag(_x, _y, _flag)
	for i = 1, #layers do
		memmap(layers[i].bmp, 0x100000)
		_sprite = mget(_x // 16, _y // 16)
		if fget(_sprite, _flag) then
			_flagSet = true
			break
		end
	end
	
	memmap(layers[4].bmp, 0x100000)
	
	return _flagSet
end

function drawObjectIntersects(_obj, _color)
	_x = _obj.x
	_y = _obj.y
	_width = _obj.width
	_height = _obj.height
	_size = _obj.size
	
	_x1, _y1, _x2, _y2 = 0, 0, 0, 0
	
	if _size != nil then
		_x1 = _x - _size
		_y1 = _y - _size
		_x2 = _x + _size
		_y2 = _y + _size
	elseif _width != nil then
		_x1 = _x
		_y1 = _y
		_x2 = _x + _width
		_y2 = _y + _height
	end
	
	if _x1 != nil and _y1 != nil and _x2 != nil and _y2 != nil then
		line(_x1, _y1, _x2, _y1, _color)
		line(_x1, _y1, _x1, _y2, _color)
		line(_x2, _y2, _x2, _y1, _color)
		line(_x2, _y2, _x1, _y2, _color)
	end
end

-- DEBUG: Draws squares around neighbor cells in given colors to indicate collision.
-- _color1: Cell is not collidable
-- _color2: Cell is collidable, but not currently intersected with
-- _color3: Cell is collidable and currently intersected with
function drawNeighborIntersects(_obj, _color1, _color2, _color3)
	_cells, _collidable = fetchNeighbors(_obj)
	
	_color1 = _color1 or 16
	_color2 = _color2 or 28
	_color3 = _color3 or 9
	
	_empty = {}
	_blocked = {}
	_collided = {}
	
	
	for _i = 1, #_cells do
		_intersects = objectIntersects(_obj, _cells[_i], 1)
		_intersecting = _intersects[1] and _intersects[2] and _intersects[3] and _intersects[4]
		
		if _collidable[_i] == false then
			add(_empty, _cells[_i])
		elseif _collidable[_i] == true and not _intersecting then
			add(_blocked, _cells[_i])
		elseif _collidable[_i] == true and _intersecting then
			add(_collided, _cells[_i])
		end
	end
	
	if _empty[1] then
		for _i = 1, #_empty do
			drawObjectIntersects(_empty[_i], _color1)
		end
	end
	
	if _blocked[1] then
		for _i = 1, #_blocked do
			drawObjectIntersects(_blocked[_i], _color2)
		end
	end
	
	if _collided[1] then
		for _i = 1, #_collided do
			drawObjectIntersects(_collided[_i], _color3)
		end
	end
end

-- _mod is optional
function objectIntersects(_obj1, _obj2, _mod)
	_mod = not _mod and 0 or _mod
	if _obj1.size != nil and _obj2.width != nil then
		
		-- From object's perspective:
		--    Intersecting on left, right, top and bottom edges
		_intersects =
		{
			_obj1.x - _obj1.size < _obj2.x + _obj2.width + _mod,
			_obj1.x + _obj1.size > _obj2.x - _mod,
			_obj1.y - _obj1.size < _obj2.y + _obj2.height + _mod,
			_obj1.y + _obj1.size > _obj2.y - _mod,
		}

		return _intersects
	elseif _obj1.width != nil and _obj2.width != nil then
		return _obj1.x > _obj2.x + _obj2.width and
				 _obj1.y > _obj2.y + _obj2.height and true or
				 _obj1.x + _obj1.width < _obj2.x and
				 _obj1.y + _obj1.height < _obj2.y
	end
end

function intersectDifference(_obj1, _obj2)
	if _obj1.size != nil and _obj2.width != nil then
		
		-- From object's perspective:
		--    Intersecting on left, right, top and bottom edges
		_intersects =
		{
			(_obj2.x + _obj2.width) - (_obj1.x - _obj1.size),
			(_obj1.x + _obj1.size) - _obj2.x,
			(_obj2.y + _obj2.height) - (_obj1.y - _obj1.size),
			(_obj1.y + _obj1.size) - _obj2.y, 
		}

		return _intersects
	elseif _obj1.width != nil and _obj2.width != nil then
		-- TODO: Build out intersect diff for square aabb colllision
		return nil
	end
end

function fetchNeighbors(_obj)
	local _leftCell = getMapCell(_obj.x, _obj.y, -1, 0)
	local _rightCell = getMapCell(_obj.x, _obj.y, 1, 0)
	local _topCell = getMapCell(_obj.x, _obj.y, 0, -1)
	local _botCell = getMapCell(_obj.x, _obj.y, 0, 1)
	local _sameCell = getMapCell(_obj.x, _obj.y, 0, 0)
	local _tlCell = getMapCell(_obj.x, _obj.y, -1, -1)
	local _trCell = getMapCell(_obj.x, _obj.y, 1, -1)
	local _blCell = getMapCell(_obj.x, _obj.y, -1, 1)
	local _brCell = getMapCell(_obj.x, _obj.y, 1, 1)
	
	local _cells = {
		_leftCell,
		_rightCell,
		_topCell,
		_botCell,
		_sameCell,
		_tlCell,
		_trCell,
		_blCell,
		_brCell,
	}
	
	local _leftSprite = fget(getMapSprite(_obj, -1, 0), 0)
	local _rightSprite = fget(getMapSprite(_obj, 1, 0), 0)
	local _topSprite = fget(getMapSprite(_obj, 0, -1), 0)
	local _botSprite = fget(getMapSprite(_obj, 0, 1), 0)
	local _sameSprite = fget(getMapSprite(_obj, 0, 0), 0)
	local _tlSprite = fget(getMapSprite(_obj, -1, -1), 0)
	local _trSprite = fget(getMapSprite(_obj, 1, -1), 0)
	local _blSprite = fget(getMapSprite(_obj, -1, 1), 0)
	local _brSprite = fget(getMapSprite(_obj, 1, 1), 0)
	
	local _collidable = {
		_leftSprite,
		_rightSprite,
		_topSprite,
		_botSprite,
		_sameSprite,
		_tlSprite,
		_trSprite,
		_blSprite,
		_brSprite,
	}
	
	return _cells, _collidable
end


-- Return a table containing colliders that have intersected
-- Box: Top-left, top-right, bottom-left, bottom-right
function checkCollision(_obj)
	if _obj.collision then
		local _collideList = {}
		
		for i = 1, #_obj.collision do
			local _collider = _obj.collision[i]
			-- Check for intersections with cells that have flag 0 enabled
			local _collideDetected = getCellFlag(_collider.x, _collider.y, 0)
			add(_collideList, _collideDetected)
		end
		
		return _collideList
	else
		error("collision.lua/checkCollision(): Unable to detect collider for this object.")
	end
end

function wallCollisionLoop(_obj)
	local cells, collidable = fetchNeighbors(_obj)
	
	local intersected = {}
	local intersecting = false
	
	for _i = 1, #cells do
		if collidable[_i] then
			local hit = objectIntersects(_obj, cells[_i])
			if hit[1] and hit[2] and hit[3] and hit[4] then
				intersecting = true
				break
			end
		end
	end
	
	return intersecting
end

function weaponCollides(_obj, _intersects)
	-- For an object with a tool, check if it collides with a destructible object
	local xOffset = sin(_obj.z + _zMod) * _xMod
	local yOffset = cos(_obj.z + _zMod) * _yMod
	
	-- Initialize and sort list of vertices that make up the weapon
	local collisionList = {}
	for i = 0, _obj.tool:height() - 2 do
	
		-- Get vertices at base and tip of weapon
		local base = userdata("i16", 2, 1,
			_obj.tool:get(i, 0),
			_obj.tool:get(i, 1)
		)
		
		local tip = userdata("i16", 2, 1,
			_obj.tool:get(i, 2),
			_obj.tool:get(i, 3)
		)
		
		-- Calculate position of X midpoints
		-- where X = _intersects
		local length = userdata("i16", 2, 1,
			abs(base[0] - tip[0]),
			abs(base[1] - tip[1])
		)
		
		local section = length / _intersects
		
		-- Assemble one big userdata with all of the intersection points
		local weaponVertices = {
			base,
			tip
		}
		
		add(collisionList, weaponVertices)
	end
	
	
end

local sqrt = sqrt

function euclidDist(x1, y1, x2, y2)
	local dx = x2 - x1
	local dy = y2 - y1
	return dx * dx + dy * dy
end
:: ease.lua
--[[pod_format="raw",created="2026-02-04 23:33:59",modified="2026-02-12 22:47:50",revision=19,xstickers={}]]
function easeOutExpo(x, reverse)
	reverse = reverse or false
	if reverse == false then
		return x == 1 and 1 or 1 - (2 ^ (-10 * x))
	else
		return x == 1 and 1 or -1 / 10 * log2(1 - x)
	end
end

function easeOutQuad(x, reverse)
reverse = reverse or false
	if reverse == false then
		return x < 0.5 and 2 * x * x or 1 - (-2 * x + 2) ^ 2 / 2
	else
		return x == 1 and 1 or 1 - sqrt(1 - x)
	end
end

-- log2 table with 20 indices and FP precision of 2
log2_tbl = {
	-4.32,
	-3.32,
	-2.73,
	-2.32,
	-2.0,
	-1.73,
	-1.51,
	-1.32,
	-1.15,
	-1.0,
	-0.86,
	-0.73,
	-0.62,
	-0.51,
	-0.41,
	-0.32,
	-0.23,
	-0.15,
	-0.07,
	0.0,
}

function log2(x)
	p = x * 20
	i = max(flr(p), 1)
	j = min(i + 1, 20)
	f = p - i
	l1 = log2_tbl[i]
	l2 = log2_tbl[j]
	diff = l2 - l1
	return l1 + (diff) * f
end
:: enemy.lua
--[[pod_format="raw",created="2025-10-11 00:15:30",modified="2026-06-06 00:08:58",revision=353,xstickers={}]]
include("blur.lua")
include("collision.lua")
include("movement.lua")

moveOptions =
{
	[0] = moveWobble,
	[1] = moveWait,
}

function enemyInitialize(_x, _y, _size, _color)
	_enemy =
	{
		-- X and Y coords on screen
		x = _x,
		y = _y,
		-- Movement speed and velocity vars
		speed = rnd(0.5) + 0.3,
		angle = 0,
		acceleration = 0,
		collisionAngle = 0,
		-- Timer for movement function
		-- -1 = random, otherwise count down until -1 is reached
		moveStep = -1,
		-- Movement function - will be replaced during enemyMove()
		moveType = nil,
		animTimer = 0,
		z = 0,
		size = 5,
		color = 27,
	}
	
	return _enemy
end

function enemyMove(_enemy)
	if _enemy.moveStep <= -1 then
		_enemy.moveType = moveOptions[flr(rnd(#moveOptions + 1))]
		_enemy.moveStep = 0
	end
	
	local intersecting = wallCollisionLoop(_enemy)
	
	-- Step away from collided walls and pick a diff. move func.
	if intersecting == true then
		_enemy = moveBack(_enemy)
		return _enemy
	end
	
	-- If no collision is detected, then keep moving
	_enemy = _enemy.moveType(_enemy)
	
	return _enemy
end

function enemySpawn(_enemyList)
	_x = flr(rnd(440) + 20)
	_y = flr(rnd(230) + 20)
	local _enemy = enemyInitialize(_x, _y, 7, 27)
	add(_enemyList, _enemy)
	return _enemyList
end

function enemiesToUserdata(_enemyList)
	_uData = userdata("f64", 4, #_enemyList)
	for k, v in pairs(_enemyList) do
		_uData:set(0, k, tonum(v.x), tonum(v.y), tonum(v.size), tonum(v.color))
	end
	return _uData
end
