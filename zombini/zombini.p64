	},
}

function shade(_color, _light)
	_lighting = _light > 5 and 5 or _light
	_shade = shadingLookupTable[_color][_light]
	return _shade
end

function setShade(_light)
	for _i = 1, 31 do
		pal(_i, shade(_i, _light))
	end
end
