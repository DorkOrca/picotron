--[[pod_format="raw",created="2025-10-11 00:15:30",modified="2026-02-17 19:29:30",revision=327,xstickers={}]]
include("blur.lua")
include("collision.lua")
include("movement.lua")

moveOptions =
{
	[0] = moveForward,
	[1] = moveWait,
}

function enemyInitialize(_x, _y, _size, _color)
	_enemy =
	{
		-- X and Y coords on screen
		x = _x,
		y = _y,
		-- Movement speed and velocity vars
		speed = 1,
		incVel = 0.3,
		decVel = 0.2,
		maxVel = 1.5,
		-- Timer for movement function
		-- -1 = random, otherwise count down until -1 is reached
		moveStep = -1,
		-- Movement function - will be replaced during enemyMove()
		moveType = function() end,
		animTimer = 0,
		z = 0,
		angle = 0,
		size = 5,
		color = 27,
	}
	
	return _enemy
end

function enemyMove(_enemy)
	if _enemy.moveStep <= -1 then
		_enemy.moveType = moveOptions[flr(rnd(#moveOptions + 1))]
		_enemy.moveStep = 0
	end
	
	local intersecting = wallCollisionLoop(_enemy)
	
	-- Step away from collided walls and pick a diff. move func.
	if intersecting == true then
		_enemy = moveBack(_enemy)
		_enemy.moveStep = -1
		return _enemy
	end
	
	-- If no collision is detected, then keep moving
	_enemy = _enemy.moveType(_enemy)
	
	return _enemy
end

function enemySpawn(_enemyList)
	_x = flr(rnd(440) + 20)
	_y = flr(rnd(230) + 20)
	local _enemy = enemyInitialize(_x, _y, 7, 27)
	add(_enemyList, _enemy)
	return _enemyList
end

function enemiesToUserdata(_enemyList)
	_uData = userdata("f64", 4, #_enemyList)
	for k, v in pairs(_enemyList) do
		_uData:set(0, k, tonum(v.x), tonum(v.y), tonum(v.size), tonum(v.color))
	end
	return _uData
end
