--[[pod_format="raw",created="2025-10-04 00:27:00",modified="2026-06-05 00:34:06",revision=304,xstickers={}]]
include("player.lua")
include("enemy.lua")
include("shading.lua")
include("collision.lua")

function _init()
	-- Initialize various variables
	
	-- Initialize player
	player = playerInitialize()
	
	-- Initialize table of enemies
	enemies =
	{
		enemyInitialize(210, 300, 7, 27),
		enemyInitialize(10, 10, 7, 17),
	}
	
	-- Initialize list of destructible objects (just enemies for now)
	destructible = enemies
	
	-- Initialize camera focus
	cFocus = player
	
	-- Initialize random enemy spawn bool
	randomSpawnTimer = 1
	
	-- Initialize variable for adjusting light level
	lightLevel = 5
	
	-- Initialize map with all layers
	-- (for reference during collision checks)
	layers = fetch("map/2.map")
	
	-- Set the wall layer of the map as the active map
	-- (so that it gets taken into account during collision checks)
	memmap(layers[4].bmp, 0x100000)
	
	debug = true
end

function _update()
	updateMainStage()
end

function updateMainStage()
	-- Main update method for base gameplay
	
	-- Capture player input for movement (WASD or arrows)
	-- Also does collision
	playerMove()
	-- Update player's rotation and weapon position using mouse
	player = toolWield(player)
	player = toolSwing(player)
	
	-- DEBUG VARIABLE: Manually adjust lighting with Q / E keys
	shadeTest()
	
	-- Focus camera on player
	camera(cFocus.x - 240, cFocus.y - 135)
	
	-- Move enemies automatically and randomly
	if enemies[1] != nil then
		for _i = 1, #enemies do
			enemies[_i] = enemyMove(enemies[_i])
		end
	end
	
	-- Spawn an enemy every second
	if randomSpawnTimer != flr(t()) then
		enemies = enemySpawn(enemies)
		randomSpawnTimer = flr(t())
	end
	
	-- Update list of destructible objects (just enemies currently)
	destructible = enemies
end

function _draw()
	drawMainStage()
end

function drawMainStage()
	-- Main draw method for base gameplay
	
	cls(0)
	-- Adjust the palette to simulate shading according to the current light level
	setShade(lightLevel)
	
	-- Draw all layers of the map
	map(layers[4].bmp)
	map(layers[3].bmp)
	map(layers[2].bmp)
	map(layers[1].bmp)
	
	-- Draw the player
	objectDraw(player)
	-- Draw the player's held tool
	toolDraw(player)
	
	-- DEBUG: Draw stuff for first enemy
	drawNeighborIntersects(enemies[1])
	print("Enemy 1 movestep: " .. enemies[1].moveStep, cFocus.x - 238, cFocus.y - 123, 1)
	print("Enemy 1 movestep: " .. enemies[1].moveStep, cFocus.x - 237, cFocus.y - 124, 7)
	
	-- Draw all enemies in the enemy table
	local elist = enemiesToUserdata(enemies)
	objBatchDraw(elist)
	
	-- Document and print CPU usage
	local _h = sub(tostr(stat(1)), 0, 4)
	print("CPU: " .. _h, cFocus.x - 238, cFocus.y - 133, 1)
	print("CPU: " .. _h, cFocus.x - 237, cFocus.y - 134, 7)
	
	-- Document and print player orientation and weapon stats
	print("Player zStep: " .. sub(tostr(player.zStep), 0, 4), cFocus.x - 238, cFocus.y - 113, 1)
	print("Player zStep: " .. sub(tostr(player.zStep), 0, 4), cFocus.x - 237, cFocus.y - 114, 7)
	print("Player ease: " .. sub(tostr(player.zEase(player.zStep)), 0, 4), cFocus.x - 238, cFocus.y - 103, 1)
	print("Player ease: " .. sub(tostr(player.zEase(player.zStep)), 0, 4), cFocus.x - 237, cFocus.y - 104, 7)
end

-- Adjust the palette to simulate shading according to the current light level
function shadeTest()
	if keyp("e") then
		lightLevel = lightLevel < 5 and lightLevel + 1 or 5
	end
	
	if keyp("q") then
		lightLevel = lightLevel > 1 and lightLevel - 1 or 1
	end
end

function enemyStresstest()
	
end
:: movement.lua
--[[pod_format="raw",created="2025-10-15 22:53:01",modified="2026-06-05 18:31:17",revision=161,xstickers={}]]
include("collision.lua")

function moveRandAngle(_obj)
	_obj.angle = flr((rnd(360) + 1)) / 360
	
	return _obj
end

function moveSetBase(_obj)
	_obj.bx = _obj.x
	_obj.by = _obj.y
	
	return _obj
end

function moveReturnToBase(_obj)
	_obj.x = _obj.bx
	_obj.y = _obj.by
	
	return _obj
end

function moveForward(_obj, _style)
	if _obj.moveStep == 0 and _obj.acceleration == 0 then
		_obj = moveRandAngle(_obj)
		_obj.animTimer = flr(rnd(4) + 2) * 60
	end
	
	local style = _style == nil and 0 or _style
	
	_obj.moveStep += 1
	
	_obj.acceleration = min(_obj.acceleration + _obj.speed / 50, _obj.speed)
	
	local wobbleVariance = 0
	
	if style == 1 then
		wobbleVariance = sin(time()*_obj.acceleration)/12
	end
	
	
	_obj.collisionAngle = _obj.angle + wobbleVariance
	_vx = cos(_obj.angle + wobbleVariance) * _obj.acceleration
	_vy = sin(_obj.angle + wobbleVariance) * _obj.acceleration
	
	_obj.x += _vx
	_obj.y += _vy
	
	if _obj.moveStep >= _obj.animTimer then
		_obj.moveStep = -1
	end
	
	return _obj
end

function moveWobble(_obj)
	return moveForward(_obj, 1)
end

function moveBack(_obj)
	_vx = cos(_obj.collisionAngle) * _obj.speed
	_vy = sin(_obj.collisionAngle) * _obj.speed
	
	_obj.x -= _vx
	_obj.y -= _vy
	
	_obj.acceleration = 0
	
	_obj.moveStep = -1
	
	
	return _obj
end

function moveWait(_obj)
	if _obj.moveStep == 0 then
		_obj.animTimer = flr((rnd(2) + 1) * 60)
	end
	
	_obj.acceleration = _obj.acceleration * 0.96
	
	_vx = cos(_obj.angle) * _obj.acceleration
	_vy = sin(_obj.angle) * _obj.acceleration
	
	_obj.x += _vx
	_obj.y += _vy
	
	_obj.moveStep += 1
	
	if _obj.moveStep >= _obj.animTimer then
		_obj.moveStep = -1
	end
	
	return _obj
end
:: player.lua
--[[pod_format="raw",created="2025-10-04 00:27:14",modified="2026-02-18 01:17:30",revision=860,xstickers={}]]
include("blur.lua")
include("collision.lua")
include("ease.lua")

function playerInitialize()
	_player =
	{
		x = 240,
		y = 135,
		blur = {},
		blurCount = 5,
		blurDist = 1,
		blurSize = 2,
		xVel = 0,
		yVel = 0,
		incVel = 0.5,
		decVel = 0.25,
		maxVel = 2,
		z = 0,
		zStep = 0,
		zBaseMod = 0.2,
		zMod = 0.2,
		zEase = easeOutQuad,
		rot = 0,
		size = 5,
		color = 7,
		ctrls =
		{
			l = 0,
			r = 1,
			u = 2,
			d = 3,
			x = 5
		},
		keys =
		{
			l = "a",
			r = "d",
			u = "w",
			d = "s",
			x = "space"
		}
	}
	
	_player = blurSetup(_player, _player.blurCount)
	
	return _player
end

function playerMove()
	local x = player.x
	local y = player.y
	local xVel = player.xVel
	local yVel = player.yVel
	local incVel = player.incVel
	local decVel = player.decVel
	local maxVel = player.maxVel
	local c = player.ctrls
	local k = player.keys
	
	local mapWidth = 512
	local mapHeight = 512
	
	-- Surrounding cells - uses collision.lua to ID them
	cells, collidable = fetchNeighbors(player)
	
	-- Adjust x velocity if left or right is pressed
	if (btn(c.l) or key(k.l)) and (not btn(c.r) and not key(k.r)) then
		xVel -= incVel
	elseif (btn(c.r) or key(k.r)) and (not btn(c.l) and not key(k.l)) then
		xVel += incVel
	else
		xVel = xVel < 0 and xVel + decVel or xVel > 0 and xVel - decVel or 0
	end
	
	-- Adjust y velocity if up or down is pressed
	if (btn(c.u) or key(k.u)) and (not btn(c.d) and not key(k.d)) then
		yVel -= incVel
	elseif (btn(c.d) or key(k.d)) and (not btn(c.u) and not key(k.u)) then
		yVel += incVel
	else
		yVel = yVel < 0 and yVel + decVel or yVel > 0 and yVel - decVel or 0
	end
	
	-- Cap velocity
	xVel = xVel <= -maxVel and -maxVel or xVel >= maxVel and maxVel or xVel
	yVel = yVel <= -maxVel and -maxVel or yVel >= maxVel and maxVel or yVel
	
	blur(player, player.blurCount)
	
	-- prevent fractional velocities below minimum decrease value
	xVel = xVel < decVel and xVel > -decVel and 0 or xVel
	yVel = yVel < decVel and yVel > -decVel and 0 or yVel
	
	-- Check for collides with map boundaries, and don't increase speed if currently colliding
	if player.xVel != 0 and player.yVel != 0 then
		x = x <= mapWidth - player.size and x >= 0 + player.size and x + xVel / 1.5 or x
		y = y <= mapHeight - player.size and y >= 0 + player.size and y + yVel / 1.5 or y
	else
		x = x <= mapWidth - player.size and x >= 0 + player.size and x + xVel or x
		y = y <= mapHeight - player.size and y >= 0 + player.size and y + yVel or y
	end
	
	-- Contain player within bounds of map
	x = x > mapWidth - player.size and mapWidth - player.size or x < 0 + player.size and 0 + player.size or x
	y = y > mapHeight - player.size and mapHeight - player.size or y < 0 + player.size and 0 + player.size or y
	
	-- Set player's position and velocity variables
	player.x = x
	player.y = y
	player.xVel = xVel
	player.yVel = yVel
	
	-- Check for collides with map walls, and don't increase speed if currently colliding
	for _i = 1, #cells do
		intersected = objectIntersects(player, cells[_i])
		intersecting = intersected[1] and intersected[2] and intersected[3] and intersected[4]
		intDiff = intersectDifference(player, cells[_i])
		
		if collidable[_i] == true and intersecting then
			-- Check cardinals
			for _j = 1, #intersected do
				if _j == 1 and _i == 1 and player.xVel < 0 then
					player.x = cells[_i].x + cells[_i].width + player.size
					player.xVel = 0
				end
				
				if _j == 2 and _i == 2 and player.xVel > 0 then
					player.x = cells[_i].x - player.size - 1
					player.xVel = 0
				end
				
				if _j == 3 and _i == 3 and player.yVel < 0 then
					player.y = cells[_i].y + cells[_i].height + player.size
					player.yVel = 0
				end
				
				if _j == 4 and _i == 4 and player.yVel > 0 then
					player.y = cells[_i].y - player.size - 1
					player.yVel = 0
				end
			end
			
			-- Check diagonals
			-- TODO: Bug: _i 8 clips when approaching with bottom edge of player aligned with top edge of wall
			if intDiff then
				if _i == 6 then
					if intDiff[1] < intDiff[3] then
						player.x = cells[_i].x + cells[_i].width + player.size
						player.xVel = 0
					elseif intDiff[1] >= intDiff[3] then
						player.y = cells[_i].y + cells[_i].height + player.size
						player.yVel = 0
					end
				end
				
				if _i == 7 then
					if intDiff[2] < intDiff[3] then
						player.x = cells[_i].x - player.size - 1
						player.xVel = 0
					elseif intDiff[2] >= intDiff[3] then
						player.y = cells[_i].y + cells[_i].height + player.size
						player.yVel = 0
					end
				end
				
				if _i == 8 then
					if intDiff[1] < intDiff[4] then
						player.x = cells[_i].x + cells[_i].width + player.size
						player.xVel = 0
					elseif intDiff[1] >= intDiff[4] then
						player.y = cells[_i].y - player.size - 1
						player.yVel = 0
					end
				end
				
				if _i == 9 then
					if intDiff[2] > intDiff[4] then
						player.y = cells[_i].y - player.size - 1
						player.yVel = 0
					elseif intDiff[2] <= intDiff[4] then
						player.x = cells[_i].x - player.size - 1
						player.xVel = 0
					end
				end
			end
		end
	end
end

-- TODO: Optimize object drawing by using batch gfx operations with userdata
function objectDraw(object)
	circfill(object.x, object.y + 2, object.size, object.color - 2)
	
	for i = object.blurCount, 1, -1 do
		if i % object.blurDist == 0 and object.blur[i].y then
			_size = object.size - (i / object.blurCount) * (object.size / object.blurSize)
			circfill(object.blur[i].x, object.blur[i].y + 2, _size, object.color - 2)
		end
	end
	
	circfill(object.x, object.y + 1, object.size, object.color - 1)
	
	for i = object.blurCount, 1, -1 do
		if i % object.blurDist == 0 and object.blur[i].y then
			_size = object.size - (i / object.blurCount) * (object.size / object.blurSize)
			circfill(object.blur[i].x, object.blur[i].y + 1, _size, object.color - 1)
		end
	end
	
	for i = object.blurCount, 1, -1 do
		if i % object.blurDist == 0 then
			_size = object.size - (i / object.blurCount) * (object.size / object.blurSize)
			circfill(object.blur[i].x, object.blur[i].y, _size, object.color)
		end
	end
	
	circfill(object.x, object.y, object.size, object.color)
end

function objBatchDraw(_objList)
	return circfill(_objList)
end

function toolWield(_obj)
	local _x = _obj.x
	local _y = _obj.y
	local _xMod = 6
	local _yMod = 6
	local _zMod = (_obj.zMod * 2 * _obj.zEase(_obj.zStep)) - _obj.zMod
	local _color = 31
	local _length = 16
	
	_mouseX, _mouseY = mouse()
	_obj.z = atan2(_mouseY - 270 / 2, _mouseX - 480 / 2)
	
	_xOffset = sin(_obj.z + _zMod) * _xMod
	_yOffset = cos(_obj.z + _zMod) * _yMod
	
	_xLength = sin(_obj.z + _zMod) * _length
	_yLength = cos(_obj.z + _zMod) * _length
	
	_x1 = _x + _xOffset
	_x2 = _x + _xLength
	_y1 = _y + _yOffset + 1
	_y2 = _y + _yLength + 1
	
	_tool = userdata("f64", 5, 5)
	_tool:set(0, 0, 
		_x1, _y1, _x2, _y2, _color,
		_x1 + 1, _y1, _x2 + 1, _y2, _color,
		_x1 + 1, _y1 + 1, _x2 + 1, _y2 + 1, _color,
		_x1, _y1 + 1, _x2, _y2 + 1, _color
		)
		
	_obj.tool = _tool
	return _obj
end

function toolSwing(_obj)
	local c = _obj.ctrls
	local k = _obj.keys
	
	if (not btn(c.x) and not key(k.x)) then
		if _obj.zEase != easeOutQuad then
			if _obj.zStep >= 0.6 then
				_obj.zStep = easeOutQuad(_obj.zEase(_obj.zStep), true)
				_obj.zEase = easeOutQuad
				charging = false
			else
				charging = true
			end
		end
		
		if charging == false then
			if _obj.zStep > 0 then
				_obj.zStep -= 0.03
			else
				_obj.zStep = 0
			end
		end
	else
		charging = true
	end
	
	if charging == true then
		if _obj.zEase != easeOutExpo then
			_obj.zStep = easeOutExpo(_obj.zEase(_obj.zStep), true)
			_obj.zEase = easeOutExpo
		end
		
		if _obj.zStep < 1 then
			_obj.zStep += 0.05
		else
			_obj.zStep = 1
		end
	end
	
	return _obj
end

function toolDraw(_obj)
	line(_obj.tool)
end

function toolSwitch()
	
end
