-- boid.lua
include("utilities.lua")

--[[GROUP:Initialization]]
function initBoid()
	local boidControls = {
		separation = 0.45,
		alignment = 0.15,
		cohesion = 0.1,
		orderedList = {
			"separation",
			"alignment",
			"cohesion"
		},
		selected = 1,
		keypAction = {
			up = function() boidControls.selected = (boidControls.selected - 2) % 3 + 1 end,
			down = function() boidControls.selected = (boidControls.selected) % 3 + 1 end,
			left = function() boidControls[boidControls.orderedList[boidControls.selected]] = max(boidControls[boidControls.orderedList[boidControls.selected]] - 0.01, 0) end,
			right = function() boidControls[boidControls.orderedList[boidControls.selected]] = min(boidControls[boidControls.orderedList[boidControls.selected]] + 0.01, 1) end
		}
	}
	
	return boidControls
end

function newBoid(_obj)
	-- Add a table to the provided object containing 3 boid parameters.
	if _obj.angle == nil then
		error("Error in newBoid(): object does not have an angle :(  -  " .. _obj)
	end
	_obj.boid = {
		angle = _obj.angle,
		diff = 0,
		separationStrength = boidControls.separation,
		alignmentStrength = boidControls.alignment,
		cohesionStrength = boidControls.cohesion,
		targetStrength = 0.3,
		targetDist = 100,
		personalDist = 50,
		personalNeighbors = {},
		longNeighbors = {},
		target = nil,
	}
	
	return _obj
end

function updateBoids(_boids)
	for key, obj in ipairs(_boids) do
		if obj.boid ~= nil then
			obj.boid.separationStrength = boidControls.separation
			obj.boid.alignmentStrength = boidControls.alignment
			obj.boid.cohesionStrength = boidControls.cohesion
		end
	end
end



--[[GROUP:Controls]]
function navigateBoidControls()
	local boidControlsChanged = false
	
	for key, func in pairs(boidControls.keypAction) do
		if keyp(key) then
			boidControls.keypAction[key]()
			boidControlsChanged = true
		end
	end
	
	if boidControlsChanged == true then
		updateBoids(boids)
	end
end

function drawBoidControls()
	if not (boidControls.separation == nil) then
		rrect(2, 2, 88, 31, 2, 31)
		rrectfill(2, 2, 87, 30, 1, 7)
		print("Separation: " .. boidControls.separation, 4, 4, 24)
		print("Separation: " .. boidControls.separation, 4, 3, 0)
		print("Alignment: " .. boidControls.alignment, 9, 12, 24)
		print("Alignment: " .. boidControls.alignment, 9, 13, 0)
		print("Cohesion: " .. boidControls.cohesion, 14, 22, 24)
		print("Cohesion: " .. boidControls.cohesion, 14, 23, 0)
		circfill(95, 6 + ((boidControls.selected - 1) * 10), 2, 8)
	end
end



--[[GROUP:Separation]]
function boidGetNeighbors(_obj, _targets, _sorted, _dist)
	-- Return a table of objects within targetDist range of _obj
	if _obj == nil then
		error("boidGetNeighbors(): _obj provided was nil.")
	end
	
	if _targets == nil then
		error("boidGetNeighbors(): _targets provided was nil.")
	end
	
	local maxDistFromObjToNeighbors = _dist == nil and _obj.boid.targetDist or _dist
	local listShouldBeSorted = _sorted == nil and false or _sorted
	
	local neighbors = {}
	local foundSelf = false
	
	for index, target in ipairs(_targets) do
		local targetDist = euclidDist(_obj.x, _obj.y, target.x, target.y)
		if targetDist == 0 and foundSelf == false then
			foundSelf = true
			goto BGNcontinue
		end
		
		if targetDist < maxDistFromObjToNeighbors then
			if listShouldBeSorted == true then
				target.dist = targetDist
			end
			
			add(neighbors, target)
		end
		
		::BGNcontinue::
	end
	
	if listShouldBeSorted == true and #neighbors > 0 then
		neighbors = sortTableBy(neighbors, "ascending", "dist")
	end 
	
	return neighbors
end

function boidSeparation(_obj, _neighbors)
	-- Update boid angle, turning away from neighbors that are too close
	local obj = _obj
	local separationDiff = 0
	local personalNeighbors = {}
	
	if #_neighbors > 0 then
		local neighbors = _neighbors
		local intersectRange = max(1, obj.boid.personalDist)
		
		local neighborInfluence = {x = 0, y = 0}
	
		for key, neighbor in ipairs(neighbors) do
			
			local neighborDist = euclidDist(obj.x, obj.y, neighbor.x, neighbor.y)
			
			if neighborDist < intersectRange then
				
				add(personalNeighbors, neighbor)
				--obj.color = (obj.color + 1) % 31 + 1
				local targetAngle = getAngle2D(neighbor, obj)
				local influenceFactor = (intersectRange - neighborDist) / intersectRange
				local vx, vy = cos(targetAngle / 360) * influenceFactor, sin(targetAngle / 360) * influenceFactor
				neighborInfluence.x += vx
				neighborInfluence.y += vy
			end
		end
		
		local diff = 0
		
		if neighborInfluence.x ~= 0 and neighborInfluence.y ~= 0 then
			local objAngle = (obj.boid.angle % 360) / 360
			
			local desiredAngle = atan2(neighborInfluence.x, neighborInfluence.y) * 360
			local diff = angleDiff(objAngle * 360, desiredAngle)
			obj.boid.diff = diff
			
			if diff ~= 0 then
				local separationInfluence = obj.boid.separationStrength
				separationDiff = diff * separationInfluence * 0.02
			end
		end
	else
		
	end
	
	return separationDiff, personalNeighbors
end



--[[GROUP:Alignment]]
function boidGetNeighborAverageAngle(_obj, _neighbors)
	-- Returns value equal to average angle of _obj and _neighbors
	local angleTable = {}
	
	for index, neighbor in ipairs(_neighbors) do
		add(angleTable, neighbor.angle%360)
	end
	
	local sx, sy = 0, 0
	
	for _, a in ipairs(angleTable) do
		sx += cos(a/360)
		sy += sin(a/360)
	end
	
	if sx == 0 and sy == 0 then
		return _obj.angle
	end
	
	return atan2(sx, sy) * 360
end

function boidAlignment(_obj, _neighbors)
	-- Update boid angle, pointing toward average angle of neighbors
	local alignmentDiff = 0
	local neighborAvgAngle = nil
	
	if #_neighbors > 0 then
		neighborAvgAngle = boidGetNeighborAverageAngle(_obj, _neighbors)
		local alignmentInfluence = _obj.boid.alignmentStrength
		
		alignmentDiff = angleDiff(_obj.angle, neighborAvgAngle) * alignmentInfluence * 0.05
	end
	return alignmentDiff, neighborAvgAngle
end



--[[GROUP:Cohesion]]
function boidGetNeighborAveragePosition(_obj, _neighbors)
	-- Returns table with "x" and "y" values equal to average position of _obj and _neighbors
	local avgXTable = {}
	local avgYTable = {}
	
	add(avgXTable, _obj.x)
	add(avgYTable, _obj.y)
	
	for index, neighbor in ipairs(_neighbors) do
		add(avgXTable, neighbor.x)
		add(avgYTable, neighbor.y)
	end
	
	local avgX = tableAverage(avgXTable)
	local avgY = tableAverage(avgYTable)
	
	return {
		x = avgX,
		y = avgY
	}
end

function boidCohesion(_obj, _neighbors)
	-- Update boid angle, pointing toward center mass of neighbors
	local cohesionDiff = 0
	local neighborAvgPos = nil
	
	if #_neighbors > 0 then
		neighborAvgPos = boidGetNeighborAveragePosition(_obj, _neighbors)
		local targetAngle = getAngle2D(_obj, neighborAvgPos)
		local cohesionInfluence = _obj.boid.cohesionStrength
		
		cohesionDiff = angleDiff(_obj.angle, targetAngle) * cohesionInfluence * 0.05
	end
	
	return cohesionDiff, neighborAvgPos
end



--[[GROUP:Targeting]]
function boidTargeting(_obj)
	-- Update boid angle, pointing toward _obj.boid.target
	local targetingDiff = 0
	
	if not (_obj.boid.target == nil) then
		local targetAngle = getAngle2D(_obj, _obj.boid.target)
		local targetInfluence = clamp(_obj.boid.targetStrength)
		targetingDiff = angleDiff(_obj.angle, targetAngle) * targetInfluence * 0.05
	end
	
	return targetingDiff
end



--[[GROUP:Extras]]
function containBoid(_obj)
	local x = _obj.x
	local y = _obj.y
	
	local influenceDist = 50
	
	local angleX, angleY = 0, 0
	local influenceX, influenceY = 0, 0
	
	if x < 240 then
		angleX = 270
		influenceX = min(influenceDist, max(0, influenceDist - x)) / influenceDist
	else
		angleX = 90
		influenceX = min(influenceDist, max(0, influenceDist - (x - 240 + influenceDist))) / influenceDist
	end
	
	if y < 135 then
		angleY = 0
		influenceY = min(influenceDist, max(0, influenceDist - y)) / influenceDist
	else
		angleY = 180
		influenceY = min(influenceDist, max(0, influenceDist - (x - 240 + influenceDist))) / influenceDist
	end
	--[[BOOKMARK: This whole function is WIP, but especially this part]]
	return angleX, influenceX, angleY, influenceY
end

function initTrail()
	trailBuffer = userdata("u8", 480, 270)
	set_draw_target(trailBuffer)
	cls(7)
	for i = 1, 2000 do
		for j = 0, 2 do
			pset(rnd(480), rnd(270), 15 + j * 8)
		end
	end
	set_draw_target()
end

function updateTrail(group)
	if #group > 0 then
		set_draw_target(trailBuffer)
		
		for key, obj in ipairs(group) do
			--circfill(obj.x, obj.y, 1, obj.color)
			pset(obj.x, obj.y, obj.color)
		end
	end
	
	set_draw_target()
end

function drawTrail()
	blit(trailBuffer, get_draw_target(), 0, 0, 0, 0, 480, 270)
end



--[[GROUP:Main Loop]]
function updateBoid(_obj, _allies)
	-- Update boid's angle of influence
	if _obj.boid == nil then
		_obj = newBoid(_obj)
	else
		_obj.boid.angle = _obj.angle
	end
	
	local neighbors = boidGetNeighbors(_obj, _allies, true)
	_obj.boid.longNeighbors = neighbors
	
	if #neighbors > 0 then
		local diffs = {}
		
		local separationDiff, personalNeighborList = boidSeparation(_obj, neighbors)
		_obj.boid.personalNeighbors = personalNeighborList
		if separationDiff ~= 0 then
			add(diffs, separationDiff)
		end
		
		local alignmentDiff, neighborAvgAngle = boidAlignment(_obj, neighbors)
		_obj.boid.neighborAvgAngle = neighborAvgAngle
		if alignmentDiff ~= 0 then
			add(diffs, alignmentDiff)
		end
		
		local cohesionDiff, neighborAvgPos = boidCohesion(_obj, neighbors)
		_obj.boid.neighborAvgPos = neighborAvgPos
		if cohesionDiff ~= 0 then
			add(diffs, cohesionDiff)
		end
		
		local targetingDiff = boidTargeting(_obj)
		if targetingDiff ~= 0 then
			add(diffs, targetingDiff)
		end
		
		local containX, influenceX, containY, influenceY = containBoid(_obj)
		if containX ~= 0 then
		
		end
		if containY ~= 0 then
		
		end
		
		local totalDiff = 0
		
		if #diffs > 0 then
			
			for key, value in ipairs(diffs) do
				totalDiff += value
			end
			
			_obj.boid.angle = angleDiff(_obj.angle, _obj.angle + totalDiff) % 360
			_obj.angle = (_obj.angle + totalDiff) % 360
		else
			_obj.boid.angle = _obj.angle
		end
	else
		_obj.boid.angle = _obj.angle
	end
	
	return _obj
end
