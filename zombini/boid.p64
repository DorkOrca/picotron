--[[GROUP:Initialization]]
function initBoidControls()
	local boidControls = {
	visible = true,
		mainmenu = {
			menus = {
				"submenu1",
				"submenu2",
			},
			selected = 1,
			btnpAction = {
				-- Up
				[2] = function()
					boidControls.mainmenu.selected = (boidControls.mainmenu.selected - 2) % 2 + 1
				end,
				-- Down
				[3] = function()
					boidControls.mainmenu.selected = boidControls.mainmenu.selected % 2 + 1
				end,
				-- O button / Z key
				[4] = function()
					boidControlMenu = boidControls.mainmenu.menus[boidControls.mainmenu.selected]
				end,
			}
		},
		submenu1 = {
			-- Direct variable adjustment
			separation = boidPresets[boidPresetChoice].separation,
			alignment = boidPresets[boidPresetChoice].alignment,
			cohesion = boidPresets[boidPresetChoice].cohesion,
			contained = boidPresets[boidPresetChoice].contained,
			orderedList = {
				"separation",
				"alignment",
				"cohesion",
				"contained",
				"gridSize",
				"maxNeighbors"
			},
			gridSize = boidPresets[boidPresetChoice].gridSize,
			maxNeighbors = boidPresets[boidPresetChoice].maxNeighbors,
			selected = 1,
			presetChoice = boidPresetChoice,
			btnpAction = {
				-- Left
				[0] = function()
					local val = boidControls.submenu1[boidControls.submenu1.orderedList[boidControls.submenu1.selected]]
					
					if boidControls.submenu1.selected <= 3 then
						val = max(val - 0.01, 0)
					elseif boidControls.submenu1.selected >= 5 then
						val -= 1
					else
						if val == true then
							val = false
						else
							val = true
						end
					end
					
					boidControls.submenu1[boidControls.submenu1.orderedList[boidControls.submenu1.selected]] = val
				end,
				-- Right
				[1] = function()
					local val = boidControls.submenu1[boidControls.submenu1.orderedList[boidControls.submenu1.selected]]
					
					if boidControls.submenu1.selected <= 3 then
						val = min(val + 0.01, 1)
					elseif boidControls.submenu1.selected >= 5 then
						val += 1
					else
						if val == true then
							val = false
						else
							val = true
						end
					end
					
					boidControls.submenu1[boidControls.submenu1.orderedList[boidControls.submenu1.selected]] = val
					
				end,
				-- Up
				[2] = function()
					boidControls.submenu1.selected = (boidControls.submenu1.selected - 2) % 6 + 1
				end,
				-- Down
				[3] = function()
					boidControls.submenu1.selected = boidControls.submenu1.selected % 6 + 1
				end,
				-- X
				[4] = function()
					boidControlMenu = "mainmenu"
				end,
			}
		},
		submenu2 = {
			-- Presets
			orderedList = {
				{
					name = Parameters,
					value = boidPresetChoice
				},
				{
					name = Graphics,
					value = 1
				}
			},
			selected = 1,
			btnpAction = {
				-- Left
				[0] = function()
					local referenceList = {}
					if boidControls.submenu2.selected == 1 then
						referenceList = boidPresets
						boidControls.submenu2.orderedList[boidControls.submenu2.selected].value = (boidControls.submenu2.orderedList[boidControls.submenu2.selected].value - 2) % #referenceList + 1
						boidPresetChoice = boidControls.submenu2.orderedList[boidControls.submenu2.selected].value
					elseif boidControls.submenu2.selected == 2 then
						referenceList = boidGraphics
						boidControls.submenu2.orderedList[boidControls.submenu2.selected].value = (boidControls.submenu2.orderedList[boidControls.submenu2.selected].value - 2) % #referenceList + 1
						boidGraphicsChoice = boidControls.submenu2.orderedList[boidControls.submenu2.selected].value
					end
				end,
				-- Right
				[1] = function()
					local referenceList = {}
					if boidControls.submenu2.selected == 1 then
						referenceList = boidPresets
						boidControls.submenu2.orderedList[boidControls.submenu2.selected].value = boidControls.submenu2.orderedList[boidControls.submenu2.selected].value % #referenceList + 1
						boidPresetChoice = boidControls.submenu2.orderedList[boidControls.submenu2.selected].value
					elseif boidControls.submenu2.selected == 2 then
						referenceList = boidGraphics
						boidControls.submenu2.orderedList[boidControls.submenu2.selected].value = boidControls.submenu2.orderedList[boidControls.submenu2.selected].value % #referenceList + 1
						boidGraphicsChoice = boidControls.submenu2.orderedList[boidControls.submenu2.selected].value
					end
				end,
				-- Up
				[2] = function()
					boidControls.submenu2.selected = (boidControls.submenu2.selected - 2) % 2 + 1
				end,
				-- Down
				[3] = function()
					boidControls.submenu2.selected = boidControls.submenu2.selected % 2 + 1
				end,
				-- X
				[4] = function() boidControlMenu = "mainmenu" end,
			}
		}
	}
	
	return boidControls
end

--[[GROUP:General]]
function newBoid(_obj)
	-- Add a table to the provided object containing 3 boid parameters.
	if _obj.angle == nil then
		error("Error in newBoid(): object does not have an angle :(  -  " .. _obj)
	end
	_obj.boid = {
		angle = _obj.angle,
		diff = 0,
		separationStrength = boidControls.submenu1.separation,
		alignmentStrength = boidControls.submenu1.alignment,
		cohesionStrength = boidControls.submenu1.cohesion,
		contained = boidControls.submenu1.contained,
		borderStrength = 0.15,
		borderDist = 50,
		targetStrength = 0.3,
		neighborDist = 100,
		personalDist = 50,
		personalNeighbors = {},
		longNeighbors = {},
		target = nil,
	}
	
	return _obj
end

function updateBoids(_boids)
	if boidControlMenu == "submenu2" then
		boidControls.submenu1.separation = boidPresets[boidPresetChoice].separation
		boidControls.submenu1.alignment = boidPresets[boidPresetChoice].alignment
		boidControls.submenu1.cohesion = boidPresets[boidPresetChoice].cohesion
		boidControls.submenu1.contained = boidPresets[boidPresetChoice].contained
		boidControls.submenu1.gridSize = boidPresets[boidPresetChoice].gridSize
		boidControls.submenu1.maxNeighbors = boidPresets[boidPresetChoice].maxNeighbors
	end
	
	for key, obj in ipairs(_boids) do
		if obj.boid ~= nil then
			obj.boid.separationStrength = boidControls.submenu1.separation
			obj.boid.alignmentStrength = boidControls.submenu1.alignment
			obj.boid.cohesionStrength = boidControls.submenu1.cohesion
			obj.boid.contained = boidControls.submenu1.contained
		end
	end
end

function drawBoid(_boid)
	boidGraphics[boidGraphicsChoice].func(_boid)
end

function drawBoids(_boids)
	local boids = _boids
	
	for key = #boids, 1, -1 do
		local boid = boids[key]
		
		drawBoid(boid)
		--[[
		if key == 1 then
			circ(boid.x, boid.y, boid.boid.neighborDist, boid.color)
			circ(boid.x, boid.y, boid.boid.personalDist, boid.color)
		end
		]]
		
		
	end
end



--[[GROUP:Controls]]

function toggleBoidControls()
	if (btnp(5) or keyp("space")) and (boidControls[boidControlMenu] ~= nil) then
		if boidControls.visible == true then
			boidControls.visible = false
		else
			boidControls.visible = true
		end
	end
	return _boidControls
end

function navigateBoidControls(_boidControls)
	if boidControls.visible == true then
		local boidControlsChanged = false
		
		for button, func in pairs(boidControls[boidControlMenu].btnpAction) do
			if btnp(button) then
				boidControls[boidControlMenu].btnpAction[button]()
				boidControlsChanged = true
			end
		end
		
		if boidControlsChanged == true then
			updateBoids(boids)
		end
	end
end

function drawBoidControls()
	if (boidControls[boidControlMenu] ~= nil) and (boidControls.visible == true) then
		local selectorOffset = (boidControls[boidControlMenu].selected - 1) * 10
		
		if boidControlMenu == "submenu2" then
			rrect(-2, -2, 98, 37, 2, 5)
			rrect(-2, -2, 98, 36, 2, 6)
			rrectfill(-2, -2, 97, 35, 1, 6)
			rrectfill(2, 2, 92, 10, 3, 7)
			showSelector(88, 7)
			
			local presetLabel =
				boidControls.submenu2.selected == 1 and "Parameters" or
				boidControls.submenu2.selected == 2 and "Graphics"
			local presetValue =
				boidControls.submenu2.selected == 1 and boidPresetChoice or
				boidControls.submenu2.selected == 2 and boidGraphicsChoice
			
			printShadow(presetLabel, 4, 4, 0, 22)
			printShadow("Preset: " .. presetValue, 4, 14, 0, 22)
			
			if boidControls.submenu2.selected == 1 then
				printShadow(boidPresets[boidPresetChoice].name, 4, 24, 0, 22)
			elseif boidControls.submenu2.selected == 2 then
				printShadow(boidGraphics[boidGraphicsChoice].name, 4, 24, 0, 22)
			end
			
			return
		end
		
		if boidControlMenu == "mainmenu" then
			rrect(-2, -2, 98, 37, 2, 5)
			rrect(-2, -2, 98, 36, 2, 6)
			rrectfill(-2, -2, 97, 35, 1, 6)
			rrectfill(2, 2 + selectorOffset, 92, 10, 3, 7)
			showSelector(88, 7 + selectorOffset)
			printShadow("Main Parameters", 4, 4, 0, 22)
			printShadow("Presets", 45, 14, 0, 22)
			return
		end
		
		if boidControlMenu == "submenu1" then
			rrect(-2, -2, 108, 67, 2, 5)
			rrect(-2, -2, 108, 66, 2, 6)
			rrectfill(-2, -2, 107, 65, 1, 6)
			rrectfill(2, 2 + selectorOffset, 102, 10, 3, 7)
			showSelector(98, 7 + selectorOffset)
			
			printShadow("Separation: " .. boidControls.submenu1.separation, 4, 4, 0, 22)
			printShadow("Alignment: " .. boidControls.submenu1.alignment, 9, 14, 0, 22)
			printShadow("Cohesion: " .. boidControls.submenu1.cohesion, 14, 24, 0, 22)
			local contained = boidControls.submenu1.contained == true and "Yes" or "No"
			printShadow("Contained: " .. contained, 9, 34, 0, 22)
			printShadow("Grid Size: " .. boidControls.submenu1.gridSize, 10, 44, 0, 22)
			printShadow("Neighbors: " .. boidControls.submenu1.maxNeighbors, 9, 54, 0, 22)
		end
	end
end



--[[GROUP:Grid]]
function buildGrid(_boids, _cellSize)
	local grid = {}
	for _, boid in ipairs(_boids) do
		local cx, cy = flr(boid.x / _cellSize), flr(boid.y / _cellSize)
		local key = cx + cy * 480
		grid[key] = grid[key] or {}
		add(grid[key], boid)
	end
	return grid
end

function gridNeighbors(_obj, _grid, _cellSize, _dist)
	local cx, cy = flr(_obj.x / _cellSize), flr(_obj.y / _cellSize)
	local dist = _dist == nil and _obj.boid.neighborDist or _dist
	local r2 = dist * dist
	local out = {}
	for dy = -1, 1 do
		for dx = -1, 1 do
			if #out >= boidControls.submenu1.maxNeighbors then break end
			
			local cell = _grid[(cx+dx) + (cy+dy) * 480]
			
			if cell == nil then
				goto gridNeighborsContinue1
			end
			
			for _, t in ipairs(cell) do
				if t == _obj then
					goto gridNeighborsContinue2
				end
				
				local d = euclidDistSq(_obj.x, _obj.y, t.x, t.y)
				if d < r2 then
					t.dist = d
					add(out, t)
				end
				
				
				::gridNeighborsContinue2::
			end
			
			::gridNeighborsContinue1::
		end
	end
	
	return out
end



--[[GROUP:Separation]]
function boidGetNeighbors(_obj, _targets, _sorted, _dist)
	-- Return a table of objects within neighborDist range of _obj (NO GRID, COMPARES AGAINST ALL NEIGHBORS)
	if _obj == nil then
		error("boidGetNeighbors(): _obj provided was nil.")
	end
	
	if _targets == nil then
		error("boidGetNeighbors(): _targets provided was nil.")
	end
	
	local maxDistFromObjToNeighbors = _dist == nil and _obj.boid.neighborDist or _dist
	local listShouldBeSorted = _sorted == nil and false or _sorted
	
	local neighbors = {}
	local foundSelf = false
	
	for index, target in ipairs(_targets) do
		local neighborDist = euclidDistSq(_obj.x, _obj.y, target.x, target.y)
		if neighborDist == 0 and foundSelf == false then
			foundSelf = true
			goto BGNcontinue
		end
		
		if neighborDist < maxDistFromObjToNeighbors * maxDistFromObjToNeighbors then
			if listShouldBeSorted == true then
				target.dist = neighborDist
			end
			
			add(neighbors, target)
		end
		
		::BGNcontinue::
	end
	
	if listShouldBeSorted == true and #neighbors > 0 then
		neighbors = sortTableBy(neighbors, "ascending", "dist")
	end 
	
	return neighbors
end

function boidSeparation(_obj, _neighbors)
	-- Update boid angle, turning away from neighbors that are too close
	local obj = _obj
	local separationDiff = 0
	local personalNeighbors = {}
	
	if #_neighbors > 0 then
		local neighbors = _neighbors
		local intersectRange = max(1, obj.boid.personalDist)
		intersectRange = intersectRange * intersectRange
		
		local neighborInfluence = {x = 0, y = 0}
	
		for key, neighbor in ipairs(neighbors) do
			
			local neighborDist = neighbor.dist
			if neighborDist < intersectRange then
				add(personalNeighbors, neighbor)
				--obj.color = (obj.color + 1) % 31 + 1
				local targetAngle = getAngle2D(neighbor, obj)
				local influenceFactor = (intersectRange - neighborDist) / intersectRange
				local vx, vy = cos(targetAngle / 360) * influenceFactor, sin(targetAngle / 360) * influenceFactor
				neighborInfluence.x += vx
				neighborInfluence.y += vy
			end
		end
		
		local diff = 0
		
		if neighborInfluence.x ~= 0 and neighborInfluence.y ~= 0 then
			local objAngle = (obj.boid.angle % 360) / 360
			
			local desiredAngle = atan2(neighborInfluence.x, neighborInfluence.y) * 360
			local diff = angleDiff(objAngle * 360, desiredAngle)
			obj.boid.diff = diff
			
			if diff ~= 0 then
				local separationInfluence = obj.boid.separationStrength
				separationDiff = diff * separationInfluence * 0.02
			end
		end
	end
	
	return separationDiff, personalNeighbors
end



--[[GROUP:Alignment]]
function boidGetNeighborAverageAngle(_obj, _neighbors)
	-- Returns value equal to average angle of _obj and _neighbors
	local angleTable = {}
	
	for index, neighbor in ipairs(_neighbors) do
		add(angleTable, neighbor.angle%360)
	end
	
	local sx, sy = 0, 0
	
	for _, a in ipairs(angleTable) do
		sx += cos(a/360)
		sy += sin(a/360)
	end
	
	if sx == 0 and sy == 0 then
		return _obj.angle
	end
	
	return atan2(sx, sy) * 360
end

function boidAlignment(_obj, _neighbors)
	-- Update boid angle, pointing toward average angle of neighbors
	local alignmentDiff = 0
	local neighborAvgAngle = nil
	
	if #_neighbors > 0 then
		neighborAvgAngle = boidGetNeighborAverageAngle(_obj, _neighbors)
		local alignmentInfluence = _obj.boid.alignmentStrength
		
		alignmentDiff = angleDiff(_obj.angle, neighborAvgAngle) * alignmentInfluence * 0.05
	end
	return alignmentDiff, neighborAvgAngle
end



--[[GROUP:Cohesion]]
function boidGetNeighborAveragePosition(_obj, _neighbors)
	-- Returns table with "x" and "y" values equal to average position of _obj and _neighbors
	local avgXTable = {}
	local avgYTable = {}
	
	add(avgXTable, _obj.x)
	add(avgYTable, _obj.y)
	
	for index, neighbor in ipairs(_neighbors) do
		add(avgXTable, neighbor.x)
		add(avgYTable, neighbor.y)
	end
	
	local avgX = tableAverage(avgXTable)
	local avgY = tableAverage(avgYTable)
	
	return {
		x = avgX,
		y = avgY
	}
end

function boidCohesion(_obj, _neighbors)
	-- Update boid angle, pointing toward center mass of neighbors
	local cohesionDiff = 0
	local neighborAvgPos = nil
	
	if #_neighbors > 0 then
		neighborAvgPos = boidGetNeighborAveragePosition(_obj, _neighbors)
		local targetAngle = getAngle2D(_obj, neighborAvgPos)
		local cohesionInfluence = _obj.boid.cohesionStrength
		
		cohesionDiff = angleDiff(_obj.angle, targetAngle) * cohesionInfluence * 0.05
	end
	
	return cohesionDiff, neighborAvgPos
end



--[[GROUP:Targeting]]
function boidTargeting(_obj)
	-- Update boid angle, pointing toward _obj.boid.target
	local targetingDiff = 0
	
	if not (_obj.boid.target == nil) then
		local targetAngle = getAngle2D(_obj, _obj.boid.target)
		local targetInfluence = clamp(_obj.boid.targetStrength)
		targetingDiff = angleDiff(_obj.angle, targetAngle) * targetInfluence * 0.05
	end
	
	return targetingDiff
end



--[[GROUP:]]
function boidDiffAngles(_obj, _neighbors)
	local separationDiff = 0
	local alignmentDiff = 0
	local cohesionDiff = 0
	
end



--[[GROUP:Extras]]
function containBoid(_obj)
	local x = _obj.x
	local y = _obj.y
	
	local borderDist = _obj.boid.borderDist
	local borderStrength = _obj.boid.borderStrength
	
	local angleX, angleY = 0, 0
	local xInfluence, yInfluence = 0, 0
	
	if x < borderDist then
		angleX = 180
		xInfluence = min(borderDist, max(0, borderDist - x)) / borderDist * borderStrength
	elseif x > 480 - borderDist then
		angleX = 0
		xInfluence = min(borderDist, max(0, borderDist - (x - 430))) / borderDist * borderStrength
	end
	
	if y < borderDist then
		angleY = 90
		yInfluence = min(borderDist, max(0, borderDist - y)) / borderDist * borderStrength
	elseif y > 270 - borderDist then
		angleY = 270
		yInfluence = min(borderDist, max(0, borderDist - (y - 220))) / borderDist * borderStrength
	end
	
	local xDiff = angleDiff(angleX, _obj.angle) * xInfluence
	local yDiff = angleDiff(angleY, _obj.angle) * yInfluence
	
	return xDiff, yDiff
end

function initTrail()
	trailBuffer = userdata("u8", 480, 270)
	set_draw_target(trailBuffer)
	cls(7)
	for i = 1, 2000 do
		for j = 0, 2 do
			pset(rnd(480), rnd(270), 15 + j * 8)
		end
	end
	set_draw_target()
end

function updateTrail(group)
	if #group > 0 then
		set_draw_target(trailBuffer)
		
		for key, obj in ipairs(group) do
			--circfill(obj.x, obj.y, 1, obj.color)
			pset(obj.x, obj.y, obj.color)
		end
	end
	
	set_draw_target()
end

function drawTrail()
	blit(trailBuffer, get_draw_target(), 0, 0, 0, 0, 480, 270)
end



--[[GROUP:Main Loop]]
function updateBoid(_obj, _allies, _grid)
	-- Update boid's angle of influence
	if _obj.boid == nil then
		_obj = newBoid(_obj)
	else
		_obj.boid.angle = _obj.angle
	end
	
	--local neighbors = boidGetNeighbors(_obj, _allies)
	local neighbors = gridNeighbors(_obj, _grid, boidControls.submenu1.gridSize)
	_obj.boid.longNeighbors = neighbors
	local diffs = {}
	
	if #neighbors > 0 then
		local separationDiff, personalNeighborList = boidSeparation(_obj, neighbors)
		_obj.boid.personalNeighbors = personalNeighborList
		if separationDiff ~= 0 then
			add(diffs, separationDiff)
		else
			_obj.boid.personalNeighbors = {}
		end
		
		local alignmentDiff, neighborAvgAngle = boidAlignment(_obj, neighbors)
		_obj.boid.neighborAvgAngle = neighborAvgAngle
		if alignmentDiff ~= 0 then
			add(diffs, alignmentDiff)
		end
		
		local cohesionDiff, neighborAvgPos = boidCohesion(_obj, neighbors)
		_obj.boid.neighborAvgPos = neighborAvgPos
		if cohesionDiff ~= 0 then
			add(diffs, cohesionDiff)
		end
		
		local targetingDiff = boidTargeting(_obj)
		if targetingDiff ~= 0 then
			add(diffs, targetingDiff)
		end
		
		if _obj.boid.contained == true then
			local xDiff, yDiff = containBoid(_obj)
			if xDiff ~= 0 then
				add(diffs, xDiff)
			end
			if yDiff ~= 0 then
				add(diffs, yDiff)
			end
		end
		
		local totalDiff = 0
		
		if #diffs > 0 then
			
			for key, value in ipairs(diffs) do
				totalDiff += value
			end
			
			_obj.boid.angle = angleDiff(_obj.angle, _obj.angle + totalDiff) % 360
			_obj.angle = (_obj.angle + totalDiff) % 360
		else
			_obj.boid.angle = _obj.angle
		end
	else
		if _obj.boid.contained == true then
			local xDiff, yDiff = containBoid(_obj)
			if xDiff ~= 0 then
				add(diffs, xDiff)
			end
			if yDiff ~= 0 then
				add(diffs, yDiff)
			end
		end
		
		local totalDiff = 0
		
		if #diffs > 0 then
			
			for key, value in ipairs(diffs) do
				totalDiff += value
			end
			
			_obj.boid.angle = angleDiff(_obj.angle, _obj.angle + totalDiff) % 360
			_obj.angle = (_obj.angle + totalDiff) % 360
		else
			_obj.boid.angle = _obj.angle
		end
	end
	
	return _obj
end
:: main.lua
--[[pod_format="raw",created="2026-06-08 20:12:47",modified="2026-06-15 23:24:26",revision=362,xstickers={}]]
include("boid.lua")
include("movement.lua")

function _init()
	boidControls = initBoidControls()
	boids = {}
	startingBoidCount = 52
	
	for i = 1, startingBoidCount do
		spawnBoid()
	end
	
	initTrail()
end

function spawnBoid(_color)
	local color = _color == nil and flr(rnd(31))+1 or _color
	
	local newBoid = {
		x = rnd(480),
		y = rnd(270),
		angle = rnd(360),
		speed = 0,
		acceleration = 0.5,
		color = color,
	}
	
	while newBoid.color == 7 do
		newBoid.color = flr(rnd(31)) + 1
	end
	
	add(boids, newBoid)
end

function moveBoids()
	local grid = buildGrid(boids, boidControls.submenu1.gridSize)
	
	for key, boid in ipairs(boids) do
		boid = updateBoid(boid, boids, grid)
		boid = moveForward(boid)
		boid = infiniteScreen(boid)
	end
end

function drawNeighborConnections(_obj, _full)
	-- Draw line between object and neighbors. _full = true: draw affecting forces
	local neighborSpace = _obj.boid.neighborDist * _obj.boid.neighborDist
	
	for key, neighbor in ipairs(_obj.boid.longNeighbors) do
		local distanceBetween = euclidDistSq(_obj.x, _obj.y, neighbor.x, neighbor.y)
		if distanceBetween <= neighborSpace then
			line(_obj.x, _obj.y, neighbor.x, neighbor.y, 6)
		end
	end
	
	
	if _full == nil or _full ~= 1 then
		return
	end
	
	-- Draw affecting forces
	if _obj.boid.separationStrength > 0 then
		local personalSpace = _obj.boid.personalDist * _obj.boid.personalDist
		for key, neighbor in ipairs(_obj.boid.personalNeighbors) do
			local distanceBetween = euclidDistSq(_obj.x, _obj.y, neighbor.x, neighbor.y)
			if distanceBetween <= personalSpace then
				line(_obj.x, _obj.y, neighbor.x, neighbor.y, 0)
			end
		end
	end
	
	if _obj.boid.cohesionStrength > 0 and _obj.neighborAvgPos ~= nil then
		local nPos = _obj.boid.neighborAvgPos
		circ(nPos.x, nPos.y, 4, _obj.color)
		pset(nPos.x, nPos.y, _obj.color)		
	end
	
	if _obj.boid.alignmentStrength > 0 and _obj.boid.neighborAvgAngle ~= nil then
		local nAng = _obj.boid.neighborAvgAngle / 360
		local nX = _obj.x + cos(nAng) * 20
		local nY = _obj.y + sin(nAng) * 20
		line(_obj.x, _obj.y, nX, nY, 6)
	end
	
	local nAng = _obj.angle / 360
	local nX = _obj.x + cos(nAng) * 10
	local nY = _obj.y + sin(nAng) * 10
	line(_obj.x, _obj.y, nX, nY, _obj.color)
end

function attractBoids(_boidList)
	local boids = _boidList
	local mx, my, mb = mouse()
	if mb == 0x1 and boids[1].boid.target == nil then
		for key, obj in ipairs(boids) do
			obj.boid.target = {x = mx, y = my}
		end
	elseif mb == 0 and boids[1].boid.target ~= nil then
		for key, obj in ipairs(boids) do
			obj.boid.target = nil
		end
	end
	
	return boids
end

function _update()
	if (1 - stat(1) > 0.1) and (#boids < flr(t()) + startingBoidCount) then
		--spawnBoid()
	end
	
	navigateBoidControls()
	for i = 1, 1 do
		moveBoids()
	end
	
	for i = 1, 1 do
		updateTrail(boids)
	end
	
	if #boids > 0 then
		boids = attractBoids(boids)
	end
	
	toggleBoidControls()
end

function _draw()
	cls(7)
	--drawTrail()
	for key = #boids, 1, -1 do
		local boid = boids[key]
		--local full = (key == 1) and 1 or 0
		drawNeighborConnections(boid, full)
	end
	drawBoids(boids)
	drawBoidControls()
	print(stat(1), 461, 3, 0)
	--print(#boids, 461, 13, 0)
end
:: movement.lua
--[[pod_format="raw",created="2026-06-08 20:28:37",modified="2026-06-15 18:59:13",revision=93,xstickers={}]]
-- movement.lua
function moveForward(_obj, _style)
	_obj.speed = min(_obj.speed + _obj.acceleration / 10, _obj.acceleration)
	
	local wobbleVariance = 0
	
	if style == 1 then
		wobbleVariance = sin(time()*_obj.acceleration)/12
	end
	
	
	_obj.collisionAngle = _obj.angle + wobbleVariance
	_vx = cos((_obj.angle + wobbleVariance) / 360) * _obj.speed
	_vy = sin((_obj.angle + wobbleVariance) / 360) * _obj.speed
	
	_obj.x += _vx
	_obj.y += _vy
	
	return _obj
end

function infiniteScreen(_obj)
	_obj.x = _obj.x%480
	_obj.y = _obj.y%270
	
	return _obj
end
:: quadtree.lua
--[[pod_format="raw",created="2026-06-09 23:25:56",modified="2026-06-10 01:02:40",revision=63,xstickers={}]]
points = {}

function newPoint(_x, _y)
	-- Return a 2d vector where x = _x, y = _y
	local x = _x == nil and rnd(480) or _x
	local y = _y == nil and rnd(270) or _y
	
	-- Class "point"
	local point = {
		-- Variables
		x = x,
		y = y,
		-- Functions
		add = function(this, diff)
				return newPoint(this.x + diff.x, this.y + diff.y)
			end,
		div = function(this, d)
			return newPoint(this.x / d, this.y / d)
			end,
		mult = function(this, d)
			return newPoint(this.x * d, this.y * d)
			end,
		diff = function(this, other)
				return newPoint(abs(other.x - this.x), abs(other.y - this.y))
			end,
		new = function()
			local point = newPoint() add(points, point) 
			end,
		midpoint = function(this, other)
			return this.func.add(this.diff(other).div(2))
			end,
		distance = function(this, p)
			local dx = p.x - this.y
			local dy = p.y - this.y
			return sqrt(dx * dx + dy * dy)
			end
	}
	
	return point
end

function newRect(_p1, _p2)
	-- Return a rectangle where "p1" and "p2" are points representing opposite corners of the rect
	local p1 = _p1 == nil and newPoint(0, 0) or _p1
	local p2 = _p2 == nil and newPoint(480, 270) or _p2
	-- Class "rect"
	local rect = {
		-- Variables
		p1 = p1,
		p2 = p2,
		-- Functions
		contains = function(this, p)
			return this.p1.x <= p.x and this.p2.x >= p.x and
				this.p1.y <= p.y and this.p2.y >= p.y
			end,
		size = function(this)
			return this.p2.diff(this.p1)
			end,
		move = function(this, v)
			return newRect(this.p1.add(v), this.p2.add(v))
			end,
		intersects = function(this, r2)
			return this.p2.x >= r2.p1.x and this.p1.x <= r2.p2.x and
				this.p2.y >= r2.p1.y and this.p1.y <= r2.p2.y
			end,
		distanceToPoint = function(this, point)
			local px = point.x
			local py = point.y
			
			local closestX = max(this.p1.x, min(px, this.p2.x))
			local closestY = max(this.p1.y, min(py, this.p2.y))
			
			local dx = px - closestX
			local dy = py - closestY
			
			return sqrt(dx * dx + dy * dy)
			end
	}
	
	return rect
end

function newQuadtree(_area, _threshold)
	-- Return a quadtree where _area = table from newRect() and _threshold = number (4 by default)
	local area = _area == nil and newRect() or _area
	local threshold = _threshold == nil and 4 or _threshold
	
	-- Class "quadtree"
	local quadtree = {
		-- Variables
		zones = {
			find = function(this, point)
				for key, zone in ipairs(this.zones) do
					if zone.contains(zone, point) then
						return key
						end
					end
				return nil
				end
		},
		elements = {
			push = function(this, element)
				add(this.elements, element)
				end
		},
		-- Functions
		insert = function(this, element)
			if (#this.zones > 0) then
				local intersecting = this.zones.find(this, element)
				if intersecting ~= nil then
					this.zones.intersecting.insert(element)
					end
				return
				end
			
			this.elements.push(element)
			if (#this.elements >= this.threshold and this.area.size.x > 1 and this.area.size.y > 1) then
				local halfSize = this.area.size.div(2)
				local rect = newRect(this.area.p1, this.aprea.p1.add(halfSize))
				this.zones = {
					newQuadtree(rect, this.threshold), -- NW
					newQuadtree(rect.move(new Point(halfSize.x, 0)), this.threshold), -- NE
					newQuadtree(rect.move(new Point(0, halfSize.y)), this.threshold), -- SW
					newQuadtree(rect.move(halfSize), this.threshold) -- SE
					}
				for key, element in ipairs(this.elements) do
					this.insert(element)
					end
				end
				
				this.elements = {
					push = function(this, element)
						add(this.elements, element)
						end
					}
			end
	}
	
	return quadtree
end

drawQuadtree(_quad)
	
end
:: utilities.lua
--[[pod_format="raw",created="2026-06-08 20:14:14",modified="2026-06-16 00:00:05",revision=99,xstickers={}]]
function angleDiff(a1, a2)
	local diff = (a2 - a1) % 360
	
	if diff > 180 then
		diff -= 360
	end
	
	return diff
end

function clamp(i, _minVal, _maxVal)
	-- Return i clamped between _minVal and _maxVal. Clamps between 0 and 1 if _minVal and _maxVal aren't provided
	local minVal = _minVal == nil and 0 or _minVal
	local maxVal = _maxVal == nil and 1 or _maxVal
	
	return min(maxVal, max(minVal, i))
end

function euclidDistSq(x1, y1, x2, y2)
	local dx = x2 - x1
	local dy = y2 - y1
	return dx * dx + dy * dy
end

function drawPointer(_obj, _size, _filled)
	local x = _obj.x
	local y = _obj.y
	local col = _obj.color
	local size = _size == nil and 4 or _size
	local filled = _filled ~= nil and _filled or false
	
	if filled == true then
		circfill(x, y, size / 2, col)
	end
	
	for i = 0, 3 do
		local vx = cos((_obj.angle + 120 * i) / 360) * size
		local vy = sin((_obj.angle + 120 * i) / 360) * size
		if i == 0 then
			local vx2 = cos((_obj.angle + 120 * i-1%3) / 360) * size
			local vy2 = sin((_obj.angle + 120 * i-1%3) / 360) * size
			line(x + vx, y + vy, x + vx2, y + vy2, col)
		else
			line(x + vx, y + vy, col)
			if filled == true then
				circfill(x + vx / 2, y + vy / 2, size / 4, col)
			end
		end
	end
end

function getAngle2D(_obj, _target)
	-- Return 360-degree angle from _obj to _target
	local dx = _target.x - _obj.x
	local dy = _target.y - _obj.y
	local a = atan2(dx, dy)
	return a * 360
end

function printShadow(_string, _x, _y, _mainColor, _shadowColor)
	-- Print text with shadow 1px below
	print(_string, _x, _y, _shadowColor)
	return print(_string, _x, _y-1, _mainColor)
end

rainbow = {8, 24, 25, 9, 10, 26, 11, 27, 17, 12, 28, 29, 23, 14, 30} 
function showSelector(_x, _y) 
	-- Show cursor for selecting options in GUI 
	local selectorX = (sin(t() / 3) * 4) + _x 
	local selectorY = (cos(t() / 2) * 3) + _y 
	circfill(selectorX, selectorY, 2, rainbow[flr(t() * 10) % #rainbow + 1]) 
end 

function sortTableBy(_table, _dir, _key)
	-- Sort table in "ascending" or "descending" corner, with optional _key to sort list of objects by
	if _table == nil or #_table == 0 then
		error("sortTableBy(): Table is nil or empty.")
	end
	
	local dir = _dir == nil and "ascending" or _dir
	local key = _key == nil and nil or _key
	
	local sortedTable = {}
	
	for i = #_table, 1, -1 do
		if #sortedTable == 0 then
			add(sortedTable, _table[i])
			goto STBcontinue
		end
		
		if not (_key == nil) then
			local inserted = false
			for j = #sortedTable, 1, -1 do
				local tableComparison = false
				if dir == "ascending" then
					tableComparison = _table[i][_key] > sortedTable[j][_key]
				else
					tableComparison = _table[i][_key] < sortedTable[j][_key]
				end
				
				if tableComparison == true then
					add(sortedTable, _table[i], j+1)
					inserted = true
					break
				end
			end
			if inserted == false then
				add(sortedTable, _table[i], 1)
			end
		else
			local inserted = false
			for j = #sortedTable, 1, -1 do
				local tableComparison = false
				if dir == "ascending" then
					tableComparison = _table[i] > sortedTable[j]
				else
					tableComparison = _table[i] < sortedTable[j]
				end
				
				if tableComparison == true then
					add(sortedTable, _table[i], j+1)
					inserted = true
					break
				end
			end
			if inserted == false then
				add(sortedTable, _table[i], 1)
			end
		end
		
		::STBcontinue::
	end
	
	return sortedTable
end

function tableAverage(_table)
	-- Returns average of all values in table
	if _table == nil or #_table == 0 then
		error("tableAverage(): _table is nil or empty.")
	end
	
	local average = 0
	
	for index, value in ipairs(_table) do
		average += value
	end
	
	return average / #_table
end
