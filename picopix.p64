--[[pod_format="raw",created="2026-04-30 22:12:28",modified="2026-05-06 02:11:54",revision=538,xstickers={}]]
function canvas_init()
	-- Primary canvas
	gc = newCanvas()
	
	-- Current color used for painting
	paintColor = 8
	-- Transparent color when image is exported
	transColor = gc[1][1]
	-- Text following the pasted character will be this color
	textColor = 7
	-- Mouse contained in canvas
	mContained = false
	
	-- Undo stack
	stack = create_undo_stack(function() return gc end, function(_obj) gc = _obj end)
	
	menuitem{
		id="mirrorh",
		label="Mirror horizontal",
		shortcut="ALT-D",
		action=mirror
	}
	
	menuitem{
		id="mirrorv",
		label="Mirror vertical",
		shortcut="ALT-F",
		action=function() mirror(true) end
	}
	
	menuitem{
		id="rotater",
		label="Rotate right",
		shortcut="ALT-R",
		action=rotate
	}
	
	menuitem{
		id="rotatel",
		label="Rotate left",
		shortcut="ALT-E",
		action=function() rotate(true) end
	}
end

function canvas_update()
	stack = trackMouse(stack)
	colorHotkeys()
	copy()
	stack = undo(stack)
	stack = redo(stack)
	dropLoad()
end

-- Returns a canvas object with specified width, height, color
function newCanvas(_w, _h, _color)
	local w = _w == nil and cw or _w
	local h = _h == nil and ch or _h
	local col = _color == nil and math.random(31) or math.min(0, math.max(32, _color))
	local canvas = {}
	
	for i = 1, w do
		canvas[i] = {}
		for j = 1, h do
			canvas[i][j] = col
		end
	end
	
	return canvas
end

-- What do you think this does?
function drawCanvas(_canvas)
	local canvas = _canvas == nil and gc or _canvas
	
	for x = 1, #canvas do
		for y = 1, #canvas[1] do
			local xi = cSize*(x-1)
			local yi = cSize*(y-1)
			
			rectfill(xi, yi, xi+cSize, yi+cSize, canvas[x][y])
		end
	end
	rect(0, 0, cwpx-1, chpx-1, 7)
end

-- Mouse event handler
function trackMouse(_stack)
	local mx, my, mb = mouse()
	mx = math.floor(mx / cSize) + 1
	my = math.floor(my / cSize) + 1
	
	if mb == M1 then
		paint(mx, my)
	elseif mb == M2 then
		eyedrop(mx, my)
	else
		mContained = false
		_stack:checkpoint()
	end
	
	return _stack
end

-- Check if mouse is hovering over canvas
function inCanvasRange(_x, _y)
	local inX = _x >= 1 and _x <= cw
	local inY = _y >= 0 and _y <= ch
	return inX == true and inY == true
end

-- Paint on canvas at x / y coords
function paint(_x, _y)
	local action = interact(_x, _y)
	if action ~= nil then
		action()
	end
end

-- Get color at x / y coords
function eyedrop(_x, _y)
	local action = interact(_x, _y, 1)
	if action ~= nil then
		action()
	end
end

-- Set canvas color to provided color
function bucket(_c)
	local c = _c == nil and 0 or _c
	for x = 1, cw do
		for y = 1, ch do
			gc[x][y] = c
		end
	end
end

-- Core function for paint, eyedrop, bucket, and other mouse-based interactions
function interact(_x, _y, _type)
	local x = _x == nil and -1 or _x
	local y = _y == nil and -1 or _y
	local type = _type == nil and 0 or _type
	
	if inCanvasRange(x, y) then
		mContained = true
		if key("ctrl") then
			return bucket(paintColor)
		else
			return
				type == 0 and function() gc[x][y] = paintColor end or
				type == 1 and function() paintColor = gc[x][y] end
		end
	elseif mContained == false then
		local mx, my, mb = mouse()
		if mx > 0 and mx < cwpx and my > 0 and my < chpx + 40 then
			if key("ctrl") then
				if mb == M1 then
					return function() setTrans(pget(mx, my)) paintColor = pget(mx, my) end
				elseif mb == M2 then
					return function() setTextColor(pget(mx, my)) end
				end
			else
				if mb == M1 then
					return function() paintColor = pget(mx, my) end
				elseif mb == M2 then
					return function() setTrans(pget(mx, my)) end
				end
			end
		else
			return nil
		end
		
		mContained = true
	end
end

function mirror(_vertical)
	local verticalFlip = _vertical == nil and false or _vertical
	local tempCanvas = {}
	
	if verticalFlip == true then
		for x = 1, #gc do
			add(tempCanvas, {})
			for y = #gc[1], 1, -1 do
				add(tempCanvas[x], gc[x][y])
			end
		end
	else
		for x = #gc, 1, -1 do
			add(tempCanvas, gc[x])
		end
	end
	
	gc = tempCanvas
end

function rotate(_counterclockwise)
	local clockwise =
		_counterclockwise == nil and false
		or _counterclockwise
		
	local tempCanvas = {}
	for y = 1, #gc[1] do
		add(tempCanvas, {})
		for x = 1, #gc do
			add(tempCanvas[y], {})
		end
	end
	
	if clockwise == true then
		for x = 1, #tempCanvas do
			for y = 1, #tempCanvas[1] do
				tempCanvas[x][y] = gc[#gc[1]-y+1][x]
			end
		end
	else
		for x = 1, #tempCanvas do
			for y = 1, #tempCanvas[1] do
				tempCanvas[x][y] = gc[y][#gc-x+1]
			end
		end
	end
	
	gc = tempCanvas
end

function translate(_x, _y)
	local ix = _x == nil and 0 or _x
	local iy = _y == nil and 0 or _y
	
	local tempCanvas = {}
	for y = 1, #gc[1] do
		add(tempCanvas, {})
		for x = 1, #gc do
			add(tempCanvas[y], {})
		end
	end
	
	for x = 1, #gc do
		for y = 1, #gc[1] do
			local xOffset = (x+ix-1)%#gc+1
			local yOffset = (y+iy-1)%#gc[1]+1
			tempCanvas[xOffset][yOffset] = gc[x][y]
		end
	end
	
	gc = tempCanvas
end

-- Set transColor
function setTrans(_c)
	local c = _c == nil and 0 or _c
	transColor = c
end

-- Set textColor
function setTextColor(_c)
	local c = _c == nil and 7 or _c
	textColor = c
end

-- Implement hotkeys 0 - 9, a - v for colors
function colorHotkeys()
	if not key("alt") then
		for i = 1, #decTable do
			if keyp(superdecimal(i)) then
				if (superdecimal(i) ~= "c" or key("ctrl") == false) and i < 32 then
					paintColor = i
				end
			end
		end
		
		if keyp("up") then
			translate(0, -1)
		elseif keyp("down") then
			translate(0, 1)
		elseif keyp("left") then
			translate(-1)
		elseif keyp("right") then
			translate(1)
		end
	else
		if keyp("s") then
			save()
		elseif keyp("w") then
			load()
		elseif keyp("c") then
			stage = 1
		elseif keyp("d") then
			mirror()
		elseif keyp("f") then
			mirror(true)
		elseif keyp("r") then
			rotate()
		elseif keyp("e") then
			rotate(true)
		elseif keyp("q") then
			stage = 1
		end
	end
end

-- Draw palette
function palette()
	for i = 0, 32 do
		local w = cwpx / 8
		local x = i%8*w
		local y = math.floor(i/w) * 8
		
		if i < 32 then	
			rectfill(x, y+chpx, x+w-1, y+chpx+w-1, i)
		else
			rectfill(x, y+chpx, x+w*8-1, y+chpx+w, paintColor)
			print("\014hello", x+2, y+chpx+2, textColor)
			crosshatch()
			rectfill(x + cwpx/2, y + chpx, x + w*8-1, y+chpx+w-1, transColor)
			crosshatch(false)
			rect(x, y+chpx, x+w*8-1, y+chpx+w, 7)
		end
	end
end

-- Binarize canvas and copy result to clipboard
function copy()
	if key("c") and key("ctrl") then
		binarizeCanvas()
		tx = ti
	end
end

-- Stack undo
function undo(_stack)
	if keyp("z") and key("ctrl") then
		_stack:undo()
	end
	return _stack
end

-- Stack redo
function redo(_stack)
	if keyp("y") and key("ctrl") then
		_stack:redo()
	end
	return _stack
end

-- Takes a canvas and returns a hexadecimal string for that canvas' colors
function binarizeCanvas(_canvas)
	local canvas = _canvas == nil and gc or _canvas
	local result = ""
	
	local colors = countColors()
	
	if colors ~= nil then
		for i = 1, #colors do
			if colors[i] ~= transColor then
				local cap = i < #colors and "\-8" or ""
				local insert = isolateColor(colors[i])
				result = insert ~= nil and result .. insert .. cap or result
			end
		end
	end
	
	result = result .. "\f" .. superdecimal(textColor)
	
	if #result > 0 then
		set_clipboard(result)
	end
end

-- Returns list of all non-transparent colors on the canvas
function countColors(_canvas)
	local canvas = _canvas == nil and gc or _canvas
	local colors = {}
	for x = 1, #canvas do
		for y = 1, #canvas[1] do
			if #colors > 0 then
				local alreadyMatched = false
				
				for i = 1, #colors do
					if canvas[x][y] == colors[i] or canvas[x][y] == transColor then
						alreadyMatched = true
						break
					end
				end
				
				if alreadyMatched == false then
					table.insert(colors, canvas[x][y])
				end
			else
				if canvas[x][y] ~= 0 then
					colors[1] = canvas[x][y]
				end
			end
		end
	end
	
	return #colors > 0 and colors or nil
end

-- Returns colored one off character given a color and canvas
function isolateColor(_c, _canvas)
	local canvas = _canvas == nil and gc or _canvas
	local result = ""
	
	if _c == nil or _c < 0 or _c > 31 then
		return nil
	else
		result = "\f" .. superdecimal(_c)
	end
	
	result = result .. "\^:"
	
	for y = 1, #canvas do
		local val = 0
		local ref = 1
		
		for x = 1, #canvas[1] do
			if canvas[x][y] == _c then
				val = val + ref
			end
			ref = ref * 2
		end
		local attach = tostr(val, true)
		attach = sub(attach, 3, #attach)
		
		if #attach < 2 then
			 attach = "0" .. attach
			end
		
		result = result .. attach
	end

	return result
end

-- Hexadecimal superset for numbers past 15
function superdecimal(_n)
	local reverse = _r == nil and false or _r
	local n = _n == nil and 0 or _n
	return tostr(decTable[n])
end

-- Fill pattern for checkered print
function crosshatch(_n)
	local n = _n == nil and true or false
	
	if n == true then
		fillp(
			0b00110011,
			0b00110011,
			0b11001100,
			0b11001100,
			0b00110011,
			0b00110011,
			0b11001100,
			0b11001100
		)
	else
		fillp()
	end
end
:: instructions.lua
--[[pod_format="raw",created="2026-05-05 23:49:37",modified="2026-05-06 03:47:15",revision=55,xstickers={}]]
function _init()
	i = fetch("instructions.txt")
	
	w = window{
		width=176,
		height=210,
		resizeable=true,
		autoclose=true,
		title="picopix - instructions"
	}
	
	g = create_gui()
	
	child = g:attach{
		x=0,
		y=0,
		width=176,
		height=1200,
		draw=function(self, msg)
			print(i, 1, 1)
			end
	}
	
	g:attach_scrollbars{
		bgcol=5,
		fgcol=7,
		autohide=true,
	}
end

function _update()
	g:update_all()
end

function _draw()
	cls(7)
	g:draw_all()
end
