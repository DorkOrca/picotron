--[[pod_format="raw",created="2026-04-30 22:12:28",modified="2026-05-01 07:39:25",revision=249,xstickers={}]]
function newCanvas(_w, _h, _color)
	local w = _w == nil and cw or _w
	local h = _h == nil and ch or _h
	local color = _color == nil and 0 or math.min(0, math.max(32, _color))
	local canvas = {}
	
	for i = 1, w do
		canvas[i] = {}
		for j = 1, h do
			canvas[i][j] = color
		end
	end
	
	return canvas
end

function drawCanvas(_canvas)
	local canvas = _canvas == nil and gc or _canvas
	
	for x = 1, #canvas do
		for y = 1, #canvas[1] do
			local xi = cSize*(x-1)
			local yi = cSize*(y-1)
			
			rectfill(xi, yi, xi+cSize, yi+cSize, canvas[x][y])
		end
	end
	rect(0, 0, cwpx-1, chpx-1, 7)
end

function trackMouse()
	local mx, my, mb = mouse()
	mx = math.floor(mx / cSize) + 1
	my = math.floor(my / cSize) + 1
	
	if mb == M1 then
		paint(mx, my)
	elseif mb == M2 then
		eyedrop(mx, my)
	else
		mContained = false
	end
	
end

function inCanvasRange(_x, _y)
	local inX = _x >= 1 and _x <= cw
	local inY = _y >= 0 and _y <= ch
	return inX == true and inY == true
end

function paint(_x, _y)
	local action = interact(_x, _y)
	if action ~= nil then
		action()
	end
end

function eyedrop(_x, _y)
	local action = interact(_x, _y, 1)
	if action ~= nil then
		action()
	end
end

function interact(_x, _y, _type)
	local x = _x == nil and -1 or _x
	local y = _y == nil and -1 or _y
	local type = _type == nil and 0 or _type
	
	if inCanvasRange(x, y) then
		mContained = true
		return
			type == 0 and function() gc[x][y] = color end or
			type == 1 and function() color = gc[x][y] end
	elseif mContained == false then
		local mx, my = mouse()
		if mx > 0 and mx < cwpx and my > 0 and my < chpx + 40 then
			return function() color = pget(mx, my) end
		else
			return nil
		end
		
		mContained = true
	end
end

function palette()
	for i = 0, 32 do
		local w = cwpx / 8
		local x = i%8*w
		local y = math.floor(i/w) * 8
		
		if i < 32 then	
			rectfill(x, y+chpx, x+w-1, y+chpx+w-1, i)
		else
			rectfill(x, y+chpx, x+w*8-1, y+chpx+w-1, color)
			rect(x, y+chpx, x+w*8-1, y+chpx+w-1, 7)
		end
	end
end

function copy()
	if btn("c") then
		binarizeCanvas()
	end
end

function countColors(_canvas)
	local canvas = _canvas == nil and gc or _canvas
	local colors = {}
	for x = 1, #canvas do
		for y = 1, #canvas[1] do
			if #colors > 0 then
				local alreadyMatched = false
				
				for i = 1, #colors do
					if canvas[x][y] == colors[i] then
						alreadyMatched = true
						break
					end
				end
				
				if alreadyMatched == false then
					table.insert(colors, canvas[x][y])
				end
			else
				colors[1] = canvas[x][y]
			end
		end
	end
	
	return #colors > 0 and colors or nil
end

-- Takes a canvas and returns a hexadecimal string for that canvas' colors
function isolateColor(_c, _canvas)
	local canvas = _canvas == nil and gc or _canvas
	local result = ""
	
	if _c == nil or _c < 0 or _c > 31 then
		return
	else
		result = "/f" .. _c
	end
	
	local bitCanvas = 0
	
	--result = result .. "\^:"
	
	for x = 1, #canvas do
		local val = 0
		local ref = 1
		
		for y = 1, #canvas[1] do
			if canvas[x][y] == _c then
				val = val + ref
			end
			ref = ref * 2
		end
		local attach = tostr(val, true)
		local attach = sub(attach, 3, #attach)
		
		if #attach > 1 then
			 attach = "0" .. attach
			end
		
		result = result .. attach
	end

	return result
end

function binarizeCanvas(_canvas)
	local canvas = _canvas == nil and gc or _canvas
	local result = ""
	
	local colors = countColors()
	
	if colors ~= nil then
		for i = 1, #colors do
			--local cap = i < #colors and "\-8" or ""
			local cap = ""
			local insert = isolateColor(colors[i])
			result = result .. insert .. cap
		end
	end
	
	if #result > 0 then
		set_clipboard(result)
	end
end
:: main.lua
--[[pod_format="raw",created="2026-04-30 20:23:24",modified="2026-05-01 00:26:29",revision=61,xstickers={}]]
include("canvas.lua")

function _init()
	---- Variables
	-- Canvas width (cells)
	cw = 8
	-- Canvas height (cells)
	ch = 8
	-- Size of each canvas cell in pixels
	cSize = 8
	
	cwpx = cw * cSize
	chpx = ch * cSize
	-- Window
	w = window{
	  width		= cwpx,
	  height		= chpx + 40,
	  resizeable	= false,
	  autoclose	= true,
	  z			= 10,
	  cursor		= "crosshair",
	  title		= "picopix"
	}
	color = 7
	
	-- Mouse contained in canvas
	mContained = false
	
	---- Constants
	-- Mouse 1: Left click by default
	M1 = 0x1
	-- Mouse 2: Right click by default
	M2 = 0x2
	
	gc = newCanvas()
end

function _update()
	trackMouse()
	copy()
end

function _draw()
	cls(7)
	drawCanvas()
	palette()
	
	local mx, my = mouse()
	print(mx .. " " .. my, 2, 2, 7)
	print(math.floor(mx / cSize) + 1 .. " " .. math.floor(my / cSize) + 1, 2, 10, 7)
	print(pget(mx, my), 2, 18, 7)
end


