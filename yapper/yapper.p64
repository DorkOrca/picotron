:: main.lua
--[[pod_format="raw",created="2026-08-26 00:11:23",modified="2026-08-27 00:58:49",revision=72,xstickers={}]]
include("tulpa.lua")

function _init()
	tulpaHandler = newTulpaHandler()
	tulpa = tulpaHandler.new(tulpaHandler)
	textColor = 7
	i = 0
	j = 0
	started = false
end

function _update()
	if tulpa != nil and started != false then
		tulpa = tulpaHandler.new(tulpaHandler)
		i += 1
	end
	
	if i > 24 then
		i = 0
		j += 1
		
		textColor = (textColor + 1) % 31 + 1
		
		if j > 4 then
			j = 0
			cursor()
		else
			cursor(j * 100, 0)
		end
	end
end

function _draw()
	if tulpa != nil then
		started = true
		rectfill(j * 100, i * 11, j * 100 + 99, i * 11 + 10, 0)
		print(tulpa.firstName .. " " .. tulpa.lastName, textColor)
	end
end
