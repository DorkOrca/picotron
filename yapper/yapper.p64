	return firstNames, lastNames
end

function newNameHandler()
	local firstNames, lastNames = generateNameLists()
	
	local nameHandler = {
		firstNames = firstNames,
		lastNames = lastNames,
		new = function(self)
			local firstIndex = flr(rnd(#self.firstNames) + 1)
			local lastIndex = flr(rnd(#self.lastNames) + 1)
			
			local firstName = self.firstNames[firstIndex]
			local lastName = self.lastNames[lastIndex]
			
			return firstName, lastName
		end
	}
	
	return nameHandler
end
:: tulpa.lua
--[[pod_format="raw",created="2026-08-26 00:12:28",modified="2026-08-27 00:25:17",revision=25,xstickers={}]]
include("names.lua")

function newTulpaHandler()
	
	local tulpaHandler = {
		nameHandler = newNameHandler(),
		new = function(self)
			local nameHandler = self.nameHandler
			
			local firstName, lastName = nameHandler.new(nameHandler)
			
			local tulpa = {
				firstName = firstName,
				lastName = lastName
			}
			
			return tulpa
		end
	}
	
	return tulpaHandler
end
