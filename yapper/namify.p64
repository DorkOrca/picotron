--[[pod_format="raw",created="2025-10-26 08:18:44",modified="2026-08-28 20:07:43",revision=229,xstickers={}]]

-- Create a button that performs the provided function
function newClicker(text, x, y, action, width, height)
	-- Error if x or y positions for the button aren't provided
	if not x or not y then
		error("clicker(): No X or Y position provided")
	end
	
	-- Set defaults for remaining variables if none are provided
	text = text == nil and "" or text

	width = width == nil and print(text, 0, -1000) + 5 or width
	local height = height == nil and 11 or height
	local borderRadius = 1
	local txtColor = 1
	local btnShadowColor = 22
	local ud = userdata("i16",6,3)
	action = action == nil and function() end or action
	
	ud:set(0, 0, x, y + 2, width, height, borderRadius, btnShadowColor)
	ud:set(0, 2, text, txtColor)
	
	-- Class: clicker
	local clicker = {
		-- Variables
		ud = ud,
		text = text,
		width = width,
		height = height,
		borderRadius = borderRadius,
		txtColor = txtColor,
		btnShadowColor = btnShadowColor,
		action = action,
		-- Functions
		update = function(self)
			local x, y = self.ud:get(0,0,2)
			
			self.mouseX, self.mouseY, self.mouseB = mouse()
			self.xIntersects = self.mouseX > x and self.mouseX < x + self.width
			self.yIntersects = self.mouseY > y and self.mouseY < y + self.height + 4
			self.clicked = self.mouseB == 0x1
			self.space = key("space")
			return self
		end,
		check = function(self)
			self = self.update(self)
			local x, y = self.ud:get(0,0,2)
			
			if ((self.clicked and self.xIntersects and self.yIntersects) or self.space) and not self.lmbHeld then
				self.lmbHeld = true
				self.ud:set(0, 1, x, y, self.width, self.height, 1, 7)
			else
				-- Reset hold variable if user releases left mouse button
				if self.lmbHeld and (self.clicked or self.space) then
					self.ud:set(0, 1, x, y, self.width, self.height, 1, 7)
				else
					if self.lmbHeld and (not self.clicked and not self.space) then
						self.lmbHeld = false
						self.action()
					end
					self.ud:set(0, 1, x, y - 2, self.width, self.height, 1, 7)
				end
			end
			
			return self
		end,
		draw = function(self)
			local ud = self.ud
			local x, y = ud:get(0,1,2)
			rrectfill(ud:get(0,0,6))
			rrectfill(ud:get(0,1,6))
			print(self.text, x + self.width/2 - print(self.text,0,-1000)/2 + 1, y + 2, self.txtColor)
		end
	}
	
	clicker = clicker.update(clicker)
	
	return clicker
end
