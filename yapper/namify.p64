--[[pod_format="raw",created="2026-08-26 00:11:23",modified="2026-08-28 21:36:53",revision=272,xstickers={}]]
include("names.lua")
include("clicker.lua")

-- All the magic happens in names.lua
-- Don't look at this mess, go there instead!

function _init()
	nameHandler = newNameHandler()
	names = nameHandler.new(nameHandler, amount)
	
	textColor = 7
	i = 0
	j = 0
	started = false
	amount = 1
	
	photosensitivityMode = nil
	sensitivityCounter = -1
	displayBuffer = userdata("u8", 480, 270)
	
	setupComplete = false
end

function setup()
	disclaimerButtons = {
		newClicker("Yes", 200, 174, function() cursor() photosensitivityMode = true end, 20),
		newClicker("No", 255, 174, function() cursor() photosensitivityMode = false cls() end, 20)
	}
	setupComplete = true
end

function _update()
	if setupComplete == true then
		if photosensitivityMode != nil then
			if names != nil and started != false then
				names = nameHandler.new(nameHandler, amount)
				i += amount
			end
			
			textColor = (textColor + 1) % 31 + 1
			
			for k = 1, #names do
				if i > 24 then
					i = 0
					j += 1
					if j > 4 then
						j = 0
						cursor()
					else
						cursor(j * 100, 0)
					end
				end
			end
			
			incAmount()
			copyToClipboard()
		end
		
		for k = 1, #disclaimerButtons do
			local button = disclaimerButtons[k]
			
			button = button.check(button)
		end
	else
		setup()
	end
end

function _draw()
	if setupComplete == true then
		if photosensitivityMode != nil then
			if photosensitivityMode == true then
				sensitivityCounter = (sensitivityCounter+1)%60
				set_draw_target(displayBuffer);
			end
			if names != nil then
				started = true
				
				rectfill(j * 100, i * 11, j * 100 + 99, i * 11 + 11 * (#names + 1), 0)	
				for k = 1, #names do
					print(names[k].firstName .. " " .. names[k].lastName, textColor)
				end
			end
			
			set_draw_target()
			
			if sensitivityCounter == 0 then
				displayBuffer:blit(get_draw_target(), 0, 0, 0, 0, 480, 270)
			end
		else
			cls(1)
			photosensitivityWarning()
		end
	end
end

function photosensitivityWarning()
	local title = "Photosensitivity Warning"
	local subtitles =
					{"This program may contain bright, flashing text.",
					 "Would you like to limit the display's refresh rate to once per second?"}
	local titleLength = print(title, 0, -1000)
	local subtitleLength = {}
	
	for i = 1, #subtitles do
		subtitleLength[i] = print(subtitles[i], 0, -1000)
	end
	
	print(title, 240 - titleLength/2, 90, 28)
	
	for i = 1, #subtitles do
		print(subtitles[i], 240 - subtitleLength[i]/2, 110 + i*14, 7)
	end
	
	for i = 1, #disclaimerButtons do
		local button = disclaimerButtons[i]
		button:draw(button)
	end
end

function incAmount()
	if (keyp("w") or btnp(2)) and amount < 25 then
		amount += 1
	end
	
	if (keyp("s") or btnp(3)) and amount > 1 then
		amount -= 1
	end
end

function copyToClipboard()
	if key("ctrl") and keyp("c") then
		local output = #names .. " name"
		output = #names > 1 and output .. "s" or output
		output = output .. ": "
		for i = 1, #names do
			local name = names[i]
			output = output .. name.firstName .. " " .. name.lastName
			output = i < #names and output .. ", " or output
		end
		set_clipboard(output)
	end
end
