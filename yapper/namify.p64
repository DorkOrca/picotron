-- Create a new name handler. Takes no arguments
function newNameHandler()
	local firstNames, lastNames = generateNameLists()
	
	local nameHandler = {
		firstNames = firstNames,
		lastNames = lastNames,
		--[[ Generate a set of names.
		
		     Arguments:
				self: Instance of nameHandler
				amt:  Amount of first-last-name pairs to be generated
				
			  Returns an array filled with first name / last name pairs. Example:
				{ {firstName = "John", lastName = "Doe"}, {firstName = "Jane", lastName = "Garcia"}, (...) }
			
		]]
		new = function(self, amt)
			local names = {}
			local amount = (amt == nil or amt < 1) and 1 or amt
			
			for i = 1, amount do
				local firstIndex = flr(rnd(#self.firstNames) + 1)
				local lastIndex = flr(rnd(#self.lastNames) + 1)
				
				local firstName = self.firstNames[firstIndex]
				local lastName = self.lastNames[lastIndex]
				
				add(names, {firstName = firstName, lastName = lastName})
			end
				
			return names
		end
	}
	
	return nameHandler
end
