--[[pod_format="raw",created="2026-08-26 00:45:24",modified="2026-09-01 00:35:20",revision=68,xstickers={}]]
--[[
** How to Use **

 1. Use newNameHandler() to create a nameHandler object.
 2. Use the nameHandler:new() function to generate as many names as you need!

 You can try running the example below by loading this cart, then
  pressing the Escape key and entering the function directly into the console.
]]
 
--** Example **
function testNameGenerator()
 -- Create nameHandler object
 local nameHandler = newNameHandler()
 -- Generate array of names between 2 and 10 entries long
 local friendAmount = flr(rnd(9) + 2)
 local names = nameHandler:new(friendAmount)
 
 -- Draw the results!
 print("I have " .. #names .. " friends:")
 print(" ")
 
 for i = 1, #names do
 	local friend = names[i]
 
 	print(i .. ". " .. friend.firstName .. " " .. friend.lastName)
 end
 
 print(" ") 
 print("Wanna add your name to that list?")
 
end

