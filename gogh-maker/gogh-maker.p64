--[[BOOKMARK:Colors]]
palettes = 
{
	{23, 14, 30, 8,},
	{7, 15, 31, 4,},
	{7, 10, 9, 25,},
	{26, 11, 27, 3,},
	{28, 12, 16, 1,},
	{6, 22, 5, 21,},
	{31, 14, 26, 12,},
