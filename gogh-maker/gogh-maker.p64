function setTextLength(_settings)
	for _k, _v in pairs(_settings) do
		for _i = 1, #_settings[_k].choices do
			_choice = _settings[_k].choices[_i]
			_settings[_k].choices[_i].tlength = print(_choice.text)
		end
	end
	
	return _settings
end
